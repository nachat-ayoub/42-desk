import hashlib
import json
import os
from pathlib import Path
import platform
import re
import shutil
import stat
import subprocess
import sys
import tarfile
import tempfile
from urllib.parse import urlparse
import zipfile

base, tool = Path(sys.argv[1]), sys.argv[2]
destination = base / 'tools' / tool
entry = 'bin/java' if tool == 'jdk' else 'bin/ninja'


def fetch(url, target):
    if urlparse(url).scheme != 'https':
        raise RuntimeError('expected an HTTPS download URL')
    part = target.with_name(target.name + '.part')
    try:
        subprocess.run(['curl', '-fL', '--retry', '2', '--connect-timeout', '15',
                        '--speed-limit', '1024', '--speed-time', '60', url, '-o', str(part)], check=True)
        part.replace(target)
    finally:
        part.unlink(missing_ok=True)


def main():
    if os.access(destination / entry, os.X_OK):
        return
    if destination.exists():
        raise RuntimeError('inspect the incomplete tool installation at ' + str(destination))
    machine = platform.machine()
    if machine not in ('x86_64', 'aarch64'):
        raise RuntimeError('unsupported tool architecture: ' + machine)
    metadata = base / 'downloads' / (tool + '.json')
    if tool == 'jdk':
        arch = 'x64' if machine == 'x86_64' else 'aarch64'
        fetch('https://api.adoptium.net/v3/assets/latest/21/hotspot?architecture=' + arch +
              '&heap_size=normal&image_type=jdk&jvm_impl=hotspot&os=linux&vendor=eclipse', metadata)
        package = json.loads(metadata.read_text())[0]['binary']['package']
        url, checksum = package['link'], package['checksum']
        if urlparse(url).hostname != 'github.com' or not urlparse(url).path.startswith('/adoptium/temurin21-binaries/releases/download/'):
            raise RuntimeError('unexpected Temurin JDK archive URL')
        required_space = 2 * 1024**3
    elif tool == 'ninja':
        fetch('https://pypi.org/pypi/ninja/json', metadata)
        wheels = [item for item in json.loads(metadata.read_text())['urls']
                  if item['filename'].endswith('.whl') and not item.get('yanked')
                  and ('manylinux2014_' + machine in item['filename'] or
                       'manylinux_2_17_' + machine in item['filename'])]
        if not wheels:
            raise RuntimeError('no compatible Linux Ninja wheel is available')
        package = wheels[0]
        url, checksum = package['url'], package['digests']['sha256']
        if urlparse(url).hostname != 'files.pythonhosted.org':
            raise RuntimeError('unexpected Ninja wheel URL')
        required_space = 200 * 1024**2
    else:
        raise RuntimeError('unknown tool: ' + tool)
    if not re.fullmatch(r'[a-fA-F0-9]{64}', checksum):
        raise RuntimeError('missing tool SHA-256 checksum')
    if shutil.disk_usage(base).free < required_space:
        raise RuntimeError('not enough free space in goinfre for ' + tool)
    archive = base / 'downloads' / Path(urlparse(url).path).name
    fetch(url, archive)
    digest = hashlib.sha256()
    with archive.open('rb') as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b''):
            digest.update(chunk)
    if digest.hexdigest().lower() != checksum.lower():
        archive.unlink(missing_ok=True)
        raise RuntimeError(tool + ' archive checksum mismatch')
    with tempfile.TemporaryDirectory(prefix=tool + '-', dir=base / 'tmp') as directory:
        stage = Path(directory)
        if tool == 'jdk':
            if not hasattr(tarfile, 'data_filter'):
                raise RuntimeError('safe JDK extraction requires an updated Python tarfile module')
            with tarfile.open(archive) as source:
                source.extractall(stage, filter='data')
            entries = list(stage.iterdir())
            if len(entries) != 1 or not entries[0].is_dir():
                raise RuntimeError('unexpected JDK archive layout')
            content = entries[0]
        else:
            content = stage
            with zipfile.ZipFile(archive) as source:
                for member in source.infolist():
                    output = (stage / member.filename).resolve()
                    mode = member.external_attr >> 16
                    if not output.is_relative_to(stage) or stat.S_ISLNK(mode):
                        raise RuntimeError('unsafe Ninja ZIP entry')
                    source.extract(member, stage)
                    if output.is_file() and mode & 0o777:
