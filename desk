  local settings_pid=$!
  trap 'kill "$settings_pid" 2>/dev/null || true' EXIT
  "$ANDROID_HOME/emulator/emulator" -avd Android_11_Play_Pixel9 \
    -port 5584 -accel on -cores 2 -memory 2048 \
    -gpu "${DESK_ANDROID_GPU:-${ANDROID_LIGHT_GPU:-auto}}" -feature -Vulkan \
    -no-snapshot -no-boot-anim -no-audio -no-metrics \
    -camera-back none -camera-front none -netspeed full -netdelay none "$@"
)


