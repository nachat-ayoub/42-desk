show_status() {
  local program choice state version executable command
  printf '%b42-desk%b %s\n\n' "$C_BOLD" "$C_RESET" "$VERSION"
  printf '  Storage   %s\n' "$(pretty "$GOINFRE")"
  printf '  Selected  %s\n' "$(selection_summary)"
  printf '\n  %-26s %-9s %-12s %s\n' 'PROGRAM' 'SELECTED' 'STATE' 'VERSION'
  for program in "${ALL_PROGRAMS[@]}"; do
    choice=no
    if selected "$program"; then choice=yes; fi
    state='not installed'
    case "$program" in
      code) executable="$APPS/vscode/bin/code"; version="$APPS/vscode/.installed-version" ;;
      brave) executable="$APPS/brave/brave"; version="$APPS/brave/.installed-version" ;;
      codex) executable="$APPS/codex/bin/codex"; version="$APPS/codex/.installed-version" ;;
      claude) executable="$APPS/claude/claude"; version="$APPS/claude/.installed-version" ;;
      android) executable="$APPS/android/sdk/emulator/emulator"; version="$APPS/android/.installed-version" ;;
      flutter) executable="$APPS/flutter/sdk/bin/flutter"; version="$APPS/flutter/.installed-version" ;;
      hermes) executable="$APPS/hermes/current/source/.hermes/bin/hermes"; version="$APPS/hermes/.installed-version" ;;
      hermes-desktop) executable="$APPS/hermes/current/desktop"; version="$APPS/hermes/.installed-version" ;;
      codex-desktop|claude-desktop|openmausbot) executable="$APPS/$program/current/AppRun"; version="$APPS/$program/.installed-version" ;;
    esac
    if [ -x "$executable" ]; then
      state=installed
      case "$program" in
        code) vscode_ready || state='needs import' ;;
        brave) brave_ready || state='needs import' ;;
        android) android_ready || state='needs setup' ;;
        flutter) flutter_ready || state='needs setup' ;;
        hermes) hermes_ready || state='needs setup' ;;
        hermes-desktop) hermes_desktop_ready || state='needs setup' ;;
        codex-desktop|claude-desktop|openmausbot) ai_desktop_ready "$program" || state='needs setup' ;;
      esac
    fi
    version=$(cat "$version" 2>/dev/null || printf '%s' '-')
    printf '  %-26s %-9s %-12s %s\n' "$(label "$program")" "$choice" "$state" "$version"
    if selected "$program"; then
      command=$(command -v "$program" 2>/dev/null || true)
      if [ "$command" != "$BIN_DIR/$program" ]; then
        printf '    Command: %s (managed wrapper: %s/%s)\n' "${command:-not in PATH}" "$(pretty "$BIN_DIR")" "$program"
      fi
    fi
  done
  printf '\n  Update log   %s\n' "$(pretty "$LOG_FILE")"
  printf '  Codex cache  %s\n' "$(pretty "$GOINFRE/cache/codex")"
  printf '  Claude cache %s\n' "$(pretty "$GOINFRE/cache/claude")"
  printf '  Android      %s\n' "$(pretty "$APPS/android")"
  printf '  Flutter      %s\n' "$(pretty "$APPS/flutter")"
  printf '\nInstall/change programs: desk install\n'
  printf 'Prepare/update selection: desk p\n'
  printf 'Open installed programs: desk   |   Update installed programs: desk update\n'
}


