#!/usr/bin/env bash
set -euo pipefail

VERSION="2.7.0"
SELF=$(readlink -f "${BASH_SOURCE[0]}")

# -------------------------------------------------------------------
# Flatpak host escape
# -------------------------------------------------------------------

if [ -f /.flatpak-info ] && [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  if command -v host-spawn >/dev/null 2>&1; then
    exec host-spawn "$SELF" --from-flatpak "${FLATPAK_ID:-}" "$@"
  fi

  exec flatpak-spawn \
    --host \
    "$SELF" \
    --from-flatpak "${FLATPAK_ID:-}" \
    "$@"
fi


# -------------------------------------------------------------------
# Config
# -------------------------------------------------------------------

USER=${USER:-$(id -un)}

CONF_DIR=${XDG_CONFIG_HOME:-$HOME/.config}
DATA_DIR=${XDG_DATA_HOME:-$HOME/.local/share}

BIN_DIR="$HOME/.local/bin"

STATE_DIR="$CONF_DIR/desk"
LOCK_DIR="$STATE_DIR/locks"

STAMP="$STATE_DIR/auto-check"
INITIALIZED="$STATE_DIR/initialized"
LOG_FILE="$STATE_DIR/last-run.log"
PROGRAMS_FILE="$STATE_DIR/programs"
OPEN_PROGRAMS_FILE="$STATE_DIR/open-programs"
# Existing installations keep their original two-program selection.
PROGRAMS=(code brave)
ALL_PROGRAMS=(code brave codex claude android)
PICKER_PROGRAMS=("${ALL_PROGRAMS[@]}")

AUTO_CHECK_SECONDS=$((12 * 60 * 60))
LOCK_WAIT_SECONDS=60

VSCODE_API="https://update.code.visualstudio.com/api/update/linux-x64/stable/latest"
BRAVE_VERSION_URL="https://versions.brave.com/latest/release-linux-x64.version"

BRAVE_CACHE_BYTES=524288000
BRAVE_WM_CLASS="brave-native"

NEW_VSCODE="$CONF_DIR/Code"
NEW_BRAVE="$CONF_DIR/BraveSoftware/Brave-Browser"

MARKER=".desk-import"
OLD_MARKER=".session-setup-import"

CACHE_EXCLUDES=(
  --exclude='Singleton*'
  --exclude='*.lock'
  --exclude='*.sock'
  --exclude='.org.chromium.*'

  --exclude='Cache'
  --exclude='CachedData'
  --exclude='CachedProfilesData'
  --exclude='CachedExtensionVSIXs'

  --exclude='Code Cache'
  --exclude='GPUCache'
  --exclude='GPUPersistentCache'
  --exclude='GrShaderCache'
  --exclude='GraphiteDawnCache'
  --exclude='ShaderCache'
  --exclude='DawnGraphiteCache'
  --exclude='DawnWebGPUCache'

  --exclude='CacheStorage'
  --exclude='sdk-cache'

  --exclude='Crash Reports'
  --exclude='Crashpad'
  --exclude='logs'

  --exclude='component_crx_cache'
  --exclude='extensions_crx_cache'

  --exclude="$MARKER"
  --exclude="$OLD_MARKER"
)

QUIET=0
FROM_FLATPAK=""
REIMPORT=""
CLOSE_OLD=0
FAILED=0


# -------------------------------------------------------------------
# Colors / output
# -------------------------------------------------------------------

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  C_RESET='\033[0m'
  C_BOLD='\033[1m'
  C_DIM='\033[2m'

  C_CYAN='\033[1;36m'
  C_GREEN='\033[1;32m'
  C_YELLOW='\033[1;33m'
  C_RED='\033[1;31m'
else
  C_RESET=''
  C_BOLD=''
  C_DIM=''

  C_CYAN=''
  C_GREEN=''
  C_YELLOW=''
  C_RED=''
fi


info() {
  [ "$QUIET" = 1 ] ||
    printf '%b›%b %s\n' \
      "$C_CYAN" \
      "$C_RESET" \
      "$*"
}


ok() {
  [ "$QUIET" = 1 ] ||
    printf '%b✓%b %s\n' \
      "$C_GREEN" \
      "$C_RESET" \
      "$*"
}


warn() {
  printf '%b!%b %s\n' \
    "$C_YELLOW" \
    "$C_RESET" \
    "$*" >&2
}


fail() {
  printf '%b✗%b %s\n' \
    "$C_RED" \
    "$C_RESET" \
    "$*" >&2
}


notify() {
  command -v notify-send >/dev/null 2>&1 &&
    notify-send "desk" "$*" 2>/dev/null ||
    true
}


pretty() {
  printf '%s' "${1/#$HOME/\~}"
}


json_get() {
  python3 -c '
import json,sys
print(json.load(sys.stdin)[sys.argv[1]])
' "$1"
}


label() {
  case "$1" in
    vscode) echo "VS Code" ;;
    brave) echo "Brave" ;;
    code) echo "VS Code" ;;
    codex) echo "Codex CLI" ;;
    claude) echo "Claude Code" ;;
    android) echo "Android 11 Google Play" ;;
    *) echo "$1" ;;
  esac
}


quit_hint() {
  case "$1" in
    vscode) echo "File > Exit" ;;
    brave) echo "Ctrl+Shift+Q" ;;
  esac
}


usage() {
  printf '%bdesk%b %b%s%b\n' \
    "$C_BOLD" "$C_RESET" \
    "$C_DIM" "$VERSION" "$C_RESET"

  printf 'Fast 42/1337 workstation setup. No sudo.\n\n'

  printf '%bUsage%b\n' "$C_BOLD" "$C_RESET"

  printf '  desk                 choose installed programs to open\n'
  printf '  desk open [APPS]     choose/open installed programs\n'
  printf '  desk install [APPS]  choose programs, save selection, and install\n'
  printf '  desk update [APPS]   update installed programs when newer versions exist\n'
  printf '  desk c [ARGS]        open VS Code\n'
  printf '  desk b [ARGS]        open Brave\n'
  printf '  desk ai [ARGS]       run Codex CLI in this terminal\n'
  printf '  desk claude [ARGS]   run Claude Code in this terminal\n'
  printf '  desk android [ARGS] open Android 11 Google Play (Pixel 9 display)\n'
  printf '  desk p               prepare/update selected programs\n'
  printf '  desk s [c|b]         re-import profile data\n'
  printf '  desk x               close old Flatpak/Snap apps\n'
  printf '  desk st              show status\n'
  printf '  desk clean           reset to fresh-install state\n'
  printf '  desk fix             repair CLI + shell hook\n\n'

  printf '%bDirect%b  code .   brave [URL]\n' \
    "$C_BOLD" "$C_RESET"

  printf '          codex [ARGS]   claude [ARGS]   android [ARGS]\n\n'
  printf 'Programs: code, brave, codex, claude, android, all, none\n'
  printf 'Examples: desk install code codex   |   desk install\n'
  printf 'Deselecting a program leaves its installation and data intact.\n'

  printf '%bAliases%b c=code  b=brave  p=prep  s=sync  x=close  st=status\n' \
    "$C_BOLD" "$C_RESET"
}


# -------------------------------------------------------------------
# Program selection (plain data, never sourced as shell code)
# -------------------------------------------------------------------

selected() {
  local program
  for program in "${PROGRAMS[@]}"; do
    [ "$program" != "$1" ] || return 0
  done
  return 1
}


normalize_programs() {
  local token word
  local code=0 brave=0 codex=0 claude=0 android=0 none=0
  local -a words=()
  for token in "$@"; do
    read -r -a words <<< "${token//,/ }"
    for word in "${words[@]}"; do
      case "$word" in
        c|code|vscode) code=1 ;;
        b|brave) brave=1 ;;
        ai|codex) codex=1 ;;
        cc|claude|claude-code) claude=1 ;;
        android|emulator) android=1 ;;
        all) code=1; brave=1; codex=1; claude=1; android=1 ;;
        none) none=1 ;;
        *) fail "Unknown program: $word. Choose code, brave, codex, claude, android, all, or none."; return 2 ;;
      esac
    done
  done
  if [ "$none" = 1 ] && [ "$((code + brave + codex + claude + android))" != 0 ]; then
    fail "Use 'none' on its own."
    return 2
  fi
  if [ "$none" = 0 ] && [ "$((code + brave + codex + claude + android))" = 0 ]; then
    fail "Choose at least one program, or 'none'."
    return 2
  fi
  PROGRAMS=()
  [ "$code" = 0 ] || PROGRAMS+=(code)
  [ "$brave" = 0 ] || PROGRAMS+=(brave)
  [ "$codex" = 0 ] || PROGRAMS+=(codex)
  [ "$claude" = 0 ] || PROGRAMS+=(claude)
  [ "$android" = 0 ] || PROGRAMS+=(android)
  return 0
}


load_programs() {
  load_programs_from "$PROGRAMS_FILE"
}


load_programs_from() {
  local file=$1
  local -a saved=()
  [ -f "$file" ] || return 0
  mapfile -t saved < "$file"
  normalize_programs "${saved[@]}"
}


save_programs_to() {
  local file=$1
  local tmp
  tmp=$(mktemp "$file.XXXXXX") || return 1
  if ! {
    if [ "${#PROGRAMS[@]}" = 0 ]; then
      printf 'none\n'
    else
      printf '%s\n' "${PROGRAMS[@]}"
    fi > "$tmp" && mv "$tmp" "$file"
  }; then
    rm -f "$tmp"
    return 1
  fi
  return 0
}


save_programs() {
  save_programs_to "$PROGRAMS_FILE" || return 1
  rm -f "$STAMP"
}


selection_summary() {
  local program
  if [ "${#PROGRAMS[@]}" = 0 ]; then
    printf 'none'
    return
  fi
  local separator=""
  for program in "${PROGRAMS[@]}"; do
    printf '%s%s' "$separator" "$(label "$program")"
    separator=', '
  done
}


# The picker owns /dev/tty, leaving stdout for the confirmed selection.
# Python restores terminal attributes and cursor visibility on every exit.
checkbox_programs() {
  python3 - "${PICKER_TITLE:-Choose your programs}" "${PICKER_ACTION:-install}" \
    "${PICKER_PROGRAMS[@]}" -- "${PROGRAMS[@]}" <<'PICKER'
import os
import select
import signal
import sys
import termios
import tty

title, action = sys.argv[1:3]
separator = sys.argv.index("--", 3)
labels = {"code": "VS Code", "brave": "Brave", "codex": "Codex CLI", "claude": "Claude Code", "android": "Android 11 Google Play"}
programs = [(name, labels[name]) for name in sys.argv[3:separator]]
chosen = set(sys.argv[separator + 1:]).intersection(name for name, _ in programs)
current = 0
fd = None
previous = None
result = 130


def write(text):
    os.write(fd, text.encode())


def interrupt(signum, frame):
    raise KeyboardInterrupt


def render():
    try:
        size = os.get_terminal_size(fd)
        width, height = max(size.columns or 80, 20), size.lines or 24
    except OSError:
        width, height = 80, 24
    lines = [title, ""]
    visible = list(enumerate(programs))
    if 0 < height < 10:
        visible = [(current, programs[current])]
    for index, (name, program_title) in visible:
        pointer = ">" if index == current else " "
        mark = "x" if name in chosen else " "
        lines.append(f" {pointer} [{mark}] {program_title}")
    lines += ["", "Up/Down or j/k: move   Space: toggle",
              f"Enter: {action}   a: all   n: none   Esc/q: cancel"]
    write("\x1b[H\x1b[2J" + "\r\n".join(line[:width - 1] for line in lines))


try:
    fd = os.open("/dev/tty", os.O_RDWR)
    previous = termios.tcgetattr(fd)
    signal.signal(signal.SIGTERM, interrupt)
    signal.signal(signal.SIGINT, interrupt)
    tty.setcbreak(fd)
    write("\x1b[?1049h\x1b[?25l")
    while True:
        render()
        key = os.read(fd, 1)
        if key == b"\x1b":
            sequence = b""
            while len(sequence) < 16 and select.select([fd], [], [], 0.15)[0]:
                sequence += os.read(fd, 1)
                if len(sequence) >= 2 and 64 <= sequence[-1] <= 126:
                    break
            if not sequence:
                break
            key = {b"[A": b"k", b"OA": b"k", b"[B": b"j", b"OB": b"j"}.get(sequence, b"?")
        if key in (b"q", b"Q", b"\x04", b""):
            break
        if key in (b"j", b"J"):
            current = (current + 1) % len(programs)
        elif key in (b"k", b"K"):
            current = (current - 1) % len(programs)
        elif key == b" ":
            name = programs[current][0]
            chosen.symmetric_difference_update({name})
        elif key in (b"a", b"A"):
            chosen = {name for name, _ in programs}
        elif key in (b"n", b"N"):
            chosen.clear()
        elif key in (b"\r", b"\n"):
            result = 0
            break
except KeyboardInterrupt:
    pass
except (OSError, termios.error) as error:
    print(f"Cannot open interactive checklist: {error}. Use desk {action} PROGRAMS.", file=sys.stderr)
    result = 2
finally:
    if previous is not None:
        try:
            termios.tcsetattr(fd, termios.TCSADRAIN, previous)
        finally:
            write("\x1b[?25h\x1b[?1049l")
    if fd is not None:
        os.close(fd)

if result == 0:
    print(" ".join(name for name, _ in programs if name in chosen) or "none")
sys.exit(result)
PICKER
}


choose_program_list() {
  local answer rc
  if [ "$#" = 0 ]; then
    if [ ! -t 0 ]; then
      fail "Specify programs, e.g. desk ${PICKER_COMMAND:-install} codex claude (or 'all' / 'none')."
      return 2
    fi
    if ! command -v python3 >/dev/null 2>&1; then
      fail "The checklist requires python3. Use desk ${PICKER_COMMAND:-install} PROGRAMS instead."
      return 2
    fi
    if answer=$(checkbox_programs); then
      normalize_programs "$answer" || return $?
    else
      rc=$?
      if [ "$rc" = 130 ]; then info 'Selection cancelled; nothing changed.'; fi
      return "$rc"
    fi
  else
    normalize_programs "$@" || return $?
  fi
}


choose_programs() {
  choose_program_list "$@" || return $?
  with_lock_wait core save_programs || return 1
  info "Selected: $(selection_summary)"
}


ensure_selection() {
  [ ! -f "$PROGRAMS_FILE" ] || return 0
  if [ ! -f "$INITIALIZED" ] && [ -t 0 ]; then
    choose_programs
  else
    # Noninteractive and upgraded installations preserve the old defaults.
    with_lock_wait core save_programs
  fi
}


show_next_steps() {
  selected code && printf '  VS Code    code .\n'
  selected brave && printf '  Brave      brave [URL]\n'
  selected codex && printf '  Codex CLI  codex   (sign in on first use)\n'
  selected claude && printf '  Claude     claude  (sign in on first use)\n'
  selected android && printf '  Android    android  (Google Play, 1080x2424 display)\n'
  printf '\nOpen programs: desk   |   Update installed programs: desk update\n'
  printf '\nChange programs anytime: desk install\n'
}


# -------------------------------------------------------------------
# Discovery
# -------------------------------------------------------------------

find_goinfre() {
  if [ -n "${GOINFRE:-}" ]; then
    echo "$GOINFRE"

  elif [ -d /goinfre ]; then
    echo "/goinfre/$USER"

  elif [ -d "$HOME/goinfre" ]; then
    readlink -f "$HOME/goinfre"

  else
    echo "$HOME/.local/opt"
  fi
}


newest() {
  find "$@" \
    -maxdepth 0 \
    -printf '%T@ %p\n' \
    2>/dev/null |
    sort -rn |
    head -n1 |
    cut -d' ' -f2- ||
    true
}


latest_bin() {
  [ -d "${1:-}" ] &&
    printf '%s\n' "$@" |
      sort -V |
      tail -n1 ||
    true
}


app_root() {
  local rest

  case "${1:-}" in
    "$HOME"/.var/app/*)
      rest=${1#"$HOME"/.var/app/}
      echo "$HOME/.var/app/${rest%%/*}"
      ;;

    "$HOME"/snap/*)
      rest=${1#"$HOME"/snap/}
      echo "$HOME/snap/${rest%%/*}/current"
      ;;
  esac
}


find_vscode_extensions() {
  local root

  root=$(app_root "${OLD_VSCODE:-}")

  if [ -n "$root" ] &&
     [ -d "$root/data/vscode/extensions" ]
  then
    echo "$root/data/vscode/extensions"
  else
    echo "$HOME/.vscode/extensions"
  fi
}


find_node_bin() {
  local d
  local def
  local bin

  for d in \
    "${NVM_DIR:-}" \
    "$HOME/.nvm" \
    "$HOME"/.var/app/*/config/nvm
  do

    [ -n "$d" ] &&
    [ -d "$d/versions/node" ] ||
      continue

    def=$(cat "$d/alias/default" 2>/dev/null || true)

    bin=$(
      latest_bin \
        "$d/versions/node/v${def#v}"*/bin \
        || true
    )

    [ -n "$bin" ] ||
      bin=$(
        latest_bin \
          "$d"/versions/node/*/bin \
          || true
      )

    if [ -n "$bin" ]; then
      echo "$bin"
      return 0
    fi
  done
}


setup_runtime() {
  GOINFRE=$(find_goinfre)
  APPS="$GOINFRE/apps"

  OLD_VSCODE=$(
    newest \
      "$HOME"/.var/app/*/config/Code \
      "$HOME"/snap/code/current/.config/Code
  )

  OLD_BRAVE=$(
    newest \
      "$HOME"/.var/app/*/config/BraveSoftware/Brave-Browser \
      "$HOME"/snap/brave/current/.config/BraveSoftware/Brave-Browser
  )

  VSCODE_EXTENSIONS=$(find_vscode_extensions)

  mkdir -p \
    "$STATE_DIR" \
    "$LOCK_DIR"

  if ! mkdir -p "$APPS" 2>/dev/null; then
    fail "Can't write to $GOINFRE"

    printf \
      'Set GOINFRE to a directory you own, e.g. GOINFRE=/goinfre/%s desk p\n' \
      "$USER" >&2

    exit 1
  fi

  chmod 700 "$GOINFRE" 2>/dev/null || true
  load_programs
}


# -------------------------------------------------------------------
# Old Flatpak / Snap processes
# -------------------------------------------------------------------

old_app_pids() {
  local root
  local roots

  root=$(app_root "$1")

  case "$root" in
    "$HOME"/.var/app/*)

      command -v flatpak >/dev/null 2>&1 ||
        return 0

      roots=$(
        flatpak ps \
          --columns=child-pid,application \
          2>/dev/null |
        awk \
          -v id="$(basename "$root")" \
          '$2 == id {printf "%s ", $1}'
      )

      [ -n "$roots" ] ||
        return 0

      ps -eo pid=,ppid=,args= |
      awk \
        -v roots="$roots" \
        '
          BEGIN {
            n = split(roots, r, " ")

            for (i = 1; i <= n; i++)
              root[r[i]] = 1
          }

          root[$2] &&
          $3 !~ /(^|\/)(bwrap|cat|gsettings)$/ &&
          $3 !~ /crashpad_handler/ &&
          $0 !~ /--type=/ {
            print $1
          }
        '
      ;;

    "$HOME"/snap/*)

      pgrep \
        -f "/snap/$(basename "$(dirname "$root")")/" \
        || true
      ;;
  esac
}


old_app_running() {
  [ -n "$(old_app_pids "$1")" ]
}


close_old_app() {
  local name=$1
  local old=$2

  local root
  local id=""
  local snap=""
  local p

  old_app_running "$old" ||
    return 0

  root=$(app_root "$old")

  case "$root" in
    "$HOME"/.var/app/*)
      id=$(basename "$root")
      ;;

    "$HOME"/snap/*)
      snap=$(basename "$(dirname "$root")")
      ;;
  esac

  if [ -n "$id" ] &&
     [ "$id" = "$FROM_FLATPAK" ]
  then
    warn \
      "Run desk from a regular terminal; this Flatpak terminal would close itself."

    return 1
  fi

  info "Closing old $(label "$name")"

  for p in $(old_app_pids "$old"); do
    kill -TERM "$p" 2>/dev/null || true
  done

  for _ in $(seq 1 15); do
    old_app_running "$old" ||
      break

    sleep 1
  done

  if [ -n "$id" ]; then
    flatpak kill "$id" 2>/dev/null || true

  elif old_app_running "$old"; then
    pkill \
      -KILL \
      -f "/snap/$snap/" \
      2>/dev/null ||
      true
  fi

  sleep 1

  if old_app_running "$old"; then
    warn "Couldn't close old $(label "$name")"
    return 1
  fi
}


offer_close_old() {
  local name=$1
  local old=$2
  local answer

  if [ "$CLOSE_OLD" != 1 ]; then

    if [ "$QUIET" = 1 ] ||
       [ ! -t 0 ]
    then
      return 1
    fi

    read \
      -r \
      -p "Old $(label "$name") is still running. Close it? [Y/n] " \
      answer ||
      return 1

    case "$answer" in
      ""|[Yy]*) ;;
      *) return 1 ;;
    esac
  fi

  close_old_app "$name" "$old"
}


# -------------------------------------------------------------------
# FIRST RUN
# -------------------------------------------------------------------

first_run_wait_for_old_apps() {
  local vscode_running=0
  local brave_running=0
  local answer

  while true; do

    vscode_running=0
    brave_running=0

    if selected code && [ -n "$OLD_VSCODE" ] &&
       old_app_running "$OLD_VSCODE"
    then
      vscode_running=1
    fi

    if selected brave && [ -n "$OLD_BRAVE" ] &&
       old_app_running "$OLD_BRAVE"
    then
      brave_running=1
    fi

    if [ "$vscode_running" = 0 ] &&
       [ "$brave_running" = 0 ]
    then
      return 0
    fi

    printf '\n'
    warn "Before the first setup, close your old apps so their profiles can be copied safely."
    printf '\n'

    if [ "$vscode_running" = 1 ]; then
      printf '  %b•%b VS Code — %bFile > Exit%b\n' \
        "$C_YELLOW" "$C_RESET" \
        "$C_BOLD" "$C_RESET"
    fi

    if [ "$brave_running" = 1 ]; then
      printf '  %b•%b Brave   — %bCtrl+Shift+Q%b\n' \
        "$C_YELLOW" "$C_RESET" \
        "$C_BOLD" "$C_RESET"
    fi

    printf '\n'

    if [ ! -t 0 ]; then
      warn "Run 'desk p' from an interactive terminal after closing them."
      return 1
    fi

    read \
      -r \
      -p "Close them, then press Enter to continue (q to cancel): " \
      answer

    case "$answer" in
      q|Q)
        return 1
        ;;
    esac

  done
}


first_run() {
  printf '\n'
  printf '%b42-desk first setup%b\n' \
    "$C_BOLD" \
    "$C_RESET"

  printf '%bPreparing this workstation for you.%b\n\n' \
    "$C_DIM" \
    "$C_RESET"

  ensure_selection || return $?
  info "Selected: $(selection_summary)"

  if ! first_run_wait_for_old_apps; then
    warn "First setup cancelled."
    return 1
  fi

  if prepare_all; then

    touch "$INITIALIZED"
    touch "$STAMP"

    printf '\n'

    ok "Workstation ready"

    printf '\n'
    show_next_steps

    printf '\n'

    return 0
  fi

  warn "Setup finished with warnings. Run 'desk p' to retry."

  return 1
}


# -------------------------------------------------------------------
# Install applications
# -------------------------------------------------------------------

version_is_newer() {
  [ "$1" != "$2" ] &&
    [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n1)" = "$1" ]
}


retry_program_command() {
  if [ "${UPDATE_ONLY:-0}" = 1 ]; then
    printf 'desk update %s' "${1/vscode/code}"
  else
    printf 'desk p'
  fi
}


ensure_app() {
  local name=$1
  local latest=$2
  local url=$3
  local sha=$4
  local subdir=$5

  local dest="$APPS/$1"

  local have
  local tmp

  have=$(
    cat "$dest/.installed-version" \
      2>/dev/null ||
      true
  )

  if [ -z "$latest" ]; then

    if [ -n "$have" ]; then
      warn "$(label "$name"): update server unavailable; keeping $have"
      return 0
    fi

    warn "$(label "$name"): download server unavailable"
    return 1
  fi

  if [ "$have" = "$latest" ]; then
    ok "$(label "$name") $have"
    return 0
  fi

  if [ "${UPDATE_ONLY:-0}" = 1 ] && [ -n "$have" ] && ! version_is_newer "$latest" "$have"; then
    ok "$(label "$name") $have (newer than latest stable $latest; keeping installed version)"
    return 0
  fi

  if [ -n "$have" ] &&
     pgrep -f "$dest/" >/dev/null 2>&1
  then
    warn \
      "$(label "$name") $latest available; close it and run '$(retry_program_command "$name")'"

    return 0
  fi

  info "Downloading $(label "$name") $latest"

  tmp=$(
    mktemp \
      -d "$GOINFRE/.desk-download.XXXXXX"
  )

  if ! {
    curl \
      -fL \
      --progress-bar \
      -o "$tmp/archive" \
      "$url" &&

    echo "$sha  $tmp/archive" |
      sha256sum \
        -c \
        --quiet \
        - &&

    mkdir "$tmp/x" &&

    case "$url" in
      *.zip)
        unzip \
          -q \
          "$tmp/archive" \
          -d "$tmp/x"
        ;;

      *)
        tar \
          -xzf "$tmp/archive" \
          -C "$tmp/x"
        ;;
    esac
  }; then

    rm -rf "$tmp"

    warn "$(label "$name"): download/checksum failed"

    return 1
  fi

  if [ ! -d "$tmp/x/$subdir" ]; then

    rm -rf "$tmp"

    warn "$(label "$name"): archive layout changed"

    return 1
  fi

  echo "$latest" \
    > "$tmp/x/$subdir/.installed-version"

  # App may have been launched during the download.
  if pgrep \
    -f "$dest/" \
    >/dev/null 2>&1
  then

    rm -rf "$tmp"

    warn \
      "$(label "$name") started while updating; update postponed"

    return 0
  fi

  rm -rf "$dest"

  mv \
    "$tmp/x/$subdir" \
    "$dest"

  rm -rf "$tmp"

  ok "$(label "$name") installed"
}


