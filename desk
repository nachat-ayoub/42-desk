  info "Opening Hermes Desktop (log: $(pretty "$STATE_DIR/open-hermes-desktop.log"))"
  start_detached_process "$APPS/hermes/current/desktop" --disable-setuid-sandbox \
    --disk-cache-dir="$GOINFRE/cache/hermes/chromium" "$@" \
    </dev/null >"$STATE_DIR/open-hermes-desktop.log" 2>&1 &
)


