#!/usr/bin/env bash
set -euo pipefail

VERSION="2.14.2"
SELF=$(readlink -f "${BASH_SOURCE[0]}")

# -------------------------------------------------------------------
# Flatpak host escape
# -------------------------------------------------------------------

if [ -f /.flatpak-info ] && [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  if command -v host-spawn >/dev/null 2>&1; then
    exec host-spawn "$SELF" --from-flatpak "${FLATPAK_ID:-}" "$@"
  fi

  exec flatpak-spawn \
    --host \
    "$SELF" \
    --from-flatpak "${FLATPAK_ID:-}" \
    "$@"
fi


