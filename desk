  [ -f "$file" ] &&
  grep \
    -Eqs '(desk|session-setup)' \
    "$file"
}


native_apps_running() {
  local running=0

  if pgrep \
    -f "$APPS/vscode/" \
    >/dev/null 2>&1
  then

    warn "Native VS Code is running. Close it first."
    running=1
  fi

  if pgrep \
    -f "$APPS/brave/" \
    >/dev/null 2>&1
  then

    warn "Native Brave is running. Close it first."
    running=1
  fi

  if codex_running; then
    warn 'Codex CLI is running. Exit it first.'
    running=1
  fi

  if claude_running; then
    warn 'Claude Code is running. Exit it first.'
    running=1
  fi

  if flutter_running; then
    warn 'Flutter/Dart tools are running. Close them first.'
    running=1
  fi

  if hermes_running; then
    warn 'Hermes is running. Close its desktop, terminal, and background processes first.'
    running=1
  fi

  local desktop_app
  for desktop_app in codex-desktop claude-desktop openmausbot; do
    if ai_desktop_running "$desktop_app"; then
      warn "$(label "$desktop_app") is running. Close it first."
      running=1
    fi
  done

  [ "$running" = 0 ]
}


backup_profile_for_clean() {
  local name=$1
  local src=$2
  local dst=$3

  [ -e "$src" ] || return 0

  info "Backing up $(label "$name") profile"
  mkdir -p "$dst"

  if ! rsync \
    -a \
    "${CACHE_EXCLUDES[@]}" \
    "$src/" \
    "$dst/"
  then
    warn "Could not back up $(label "$name") profile"
    return 1
  fi

  rm -rf "$src"
  ok "$(label "$name") profile backed up"
}


clean_reset_unlocked() {
  local backup
  local stamp

  stamp=$(date +%Y%m%d-%H%M%S)
  backup="$GOINFRE/backups/desk-clean-$stamp"

  if [ -e "$NEW_VSCODE" ] || [ -e "$NEW_BRAVE" ]; then
    mkdir -p "$backup"

    backup_profile_for_clean \
      vscode \
      "$NEW_VSCODE" \
      "$backup/Code" || return 1

    backup_profile_for_clean \
      brave \
      "$NEW_BRAVE" \
      "$backup/BraveSoftware/Brave-Browser" || return 1
  fi

  info "Removing desk-managed applications"

  rm -rf \
    "$APPS/vscode" \
    "$APPS/brave" \
    "$APPS/codex" \
    "$GOINFRE/cache/codex" \
    "$APPS/claude" \
    "$GOINFRE/cache/claude" \
    "$APPS/hermes" \
    "$GOINFRE/cache/hermes" \
    "$APPS/codex-desktop" \
    "$APPS/claude-desktop" \
    "$APPS/openmausbot" \
    "$GOINFRE/cache/codex-desktop" \
    "$GOINFRE/cache/claude-desktop" \
    "$GOINFRE/cache/openmausbot" \
    "$GOINFRE/cache/vscode-vsix"

  rm -rf "$APPS/flutter/sdk"
  rm -f "$APPS/flutter/.installed-version" "$APPS/flutter/.desk-release.json"

  if managed_wrapper "$BIN_DIR/code"; then
    rm -f "$BIN_DIR/code"
  fi

  if managed_wrapper "$BIN_DIR/brave"; then
    rm -f "$BIN_DIR/brave"
  fi

  if managed_wrapper "$BIN_DIR/codex"; then
    rm -f "$BIN_DIR/codex"
  fi

  if managed_wrapper "$BIN_DIR/claude"; then
    rm -f "$BIN_DIR/claude"
  fi

  if managed_wrapper "$BIN_DIR/android"; then
    rm -f "$BIN_DIR/android"
  fi

  if managed_wrapper "$BIN_DIR/flutter"; then rm -f "$BIN_DIR/flutter"; fi
  if managed_wrapper "$BIN_DIR/dart"; then rm -f "$BIN_DIR/dart"; fi
  if managed_wrapper "$BIN_DIR/hermes"; then rm -f "$BIN_DIR/hermes"; fi
  if managed_wrapper "$BIN_DIR/hermes-desktop"; then rm -f "$BIN_DIR/hermes-desktop"; fi
  rm -f "$DATA_DIR/applications/hermes-desktop-desk.desktop"
  local desktop_app
  for desktop_app in codex-desktop claude-desktop openmausbot; do
    if managed_wrapper "$BIN_DIR/$desktop_app"; then rm -f "$BIN_DIR/$desktop_app"; fi
    rm -f "$DATA_DIR/applications/$desktop_app-desk.desktop"
  done

  rm -f \
    "$DATA_DIR/applications/code-native.desktop" \
    "$DATA_DIR/applications/brave-native.desktop" \
    "$DATA_DIR/applications/android-desk.desktop"

  rm -f \
    "$INITIALIZED" \
    "$STAMP" \
    "$LOG_FILE"

  printf '\n'
  ok "Fresh-install state restored"

  if [ -d "$backup" ]; then
    printf '  profile backup: %s\n' "$(pretty "$backup")"
  fi

  printf '\n'
  printf 'Close this terminal and open a new one.\n'
  printf 'The first-run setup will start again visibly.\n'
}


clean_busy() {
  printf '\n' >&2
  warn "Another desk setup/update is still running."
  printf 'Wait for it to finish (or stop that desk process), then run: desk clean\n' >&2
}


clean_reset() {
  local answer
  local rc=0
  local held_first=0
  local held_core=0
  local held_code=0
  local held_brave=0
  local held_codex=0
  local held_claude=0
  local held_flutter=0
  local held_hermes=0
  local extra_lock
  local -a extra_locks=()

  printf '%bReset 42-desk?%b\n\n' \
    "$C_BOLD" \
    "$C_RESET"

  printf 'This will remove:\n'
  printf '  • desk-managed VS Code\n'
  printf '  • desk-managed Brave\n'
  printf '  • desk-managed Codex CLI and its cache\n'
  printf '  • desk-managed Claude Code and its cache\n'
  printf '  • desk-managed Hermes Agent and its runtime/cache (user data is kept)\n'
  printf '  • community Codex Desktop and Claude Desktop (user profiles are kept)\n'
  printf '  • Flutter SDK (its configuration and Pub/Gradle caches are kept)\n'
  printf '  • selected program wrappers, including Hermes and desktop apps\n'
  printf '  • desktop launchers\n'
  printf '  • first-run/update state\n\n'

  printf 'Your native profiles will be backed up first.\n'
  printf 'The desk CLI and shell hook will stay installed.\n\n'
  printf 'Program choices and AI tool authentication/configuration are kept.\n\n'
  printf 'Android SDK, virtual devices, installed apps, and Google sign-in data are kept.\n\n'

  if [ -t 0 ]; then
    read -r -p "Continue? [y/N] " answer

    case "$answer" in
      y|Y|yes|YES) ;;
      *)
        echo "Cancelled."
        return 0
        ;;
    esac
  else
    fail "Run 'desk clean' from an interactive terminal."
    return 1
  fi

  if ! native_apps_running; then
    printf '\n'
    warn "Close the apps above, then run 'desk clean' again."
    return 1
  fi

  # Reset must never sit on a 10-minute flock wait. Acquire every desk lock
  # non-blockingly. first-run is included so clean cannot race a setup between
  # its code and brave phases.
  if lock_try_acquire first-run; then
    held_first=1
  else
    clean_busy
    return 1
  fi

  if lock_try_acquire core; then
    held_core=1
  else
    rc=1
  fi

  if [ "$rc" = 0 ]; then
    if lock_try_acquire code; then
      held_code=1
    else
      rc=1
    fi
  fi

  if [ "$rc" = 0 ]; then
    if lock_try_acquire brave; then
      held_brave=1
    else
      rc=1
    fi
  fi

  if [ "$rc" = 0 ]; then
    if lock_try_acquire codex; then
      held_codex=1
    else
      rc=1
    fi
  fi

  if [ "$rc" = 0 ]; then
    if lock_try_acquire claude; then
      held_claude=1
    else
      rc=1
    fi
  fi

  if [ "$rc" = 0 ]; then
    if lock_try_acquire flutter; then held_flutter=1; else rc=1; fi
  fi

  if [ "$rc" = 0 ]; then
    if lock_try_acquire hermes; then held_hermes=1; else rc=1; fi
  fi

  for extra_lock in codex-desktop claude-desktop openmausbot; do
    [ "$rc" = 0 ] || break
    if lock_try_acquire "$extra_lock"; then extra_locks+=("$extra_lock"); else rc=1; fi
  done

  if [ "$rc" != 0 ]; then
    for extra_lock in "${extra_locks[@]}"; do lock_release "$extra_lock"; done
    [ "$held_hermes" = 0 ] || lock_release hermes
    [ "$held_flutter" = 0 ] || lock_release flutter
    [ "$held_claude" = 0 ] || lock_release claude
    [ "$held_codex" = 0 ] || lock_release codex
    [ "$held_brave" = 0 ] || lock_release brave
    [ "$held_code" = 0 ] || lock_release code
    [ "$held_core" = 0 ] || lock_release core
    [ "$held_first" = 0 ] || lock_release first-run
    clean_busy
    return 1
  fi

  if clean_reset_unlocked; then
    rc=0
  else
    rc=$?
  fi

  for extra_lock in "${extra_locks[@]}"; do lock_release "$extra_lock"; done
  lock_release hermes
  lock_release flutter
  lock_release claude
  lock_release codex
  lock_release brave
  lock_release code
  lock_release core
  lock_release first-run

  return "$rc"
}


