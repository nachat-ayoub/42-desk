hermes_running() {
  python3 - "$APPS/hermes" "$GOINFRE/cache/hermes" <<'PY'
import glob, os, sys
prefix = os.fsencode(os.path.realpath(sys.argv[1]) + '/')
python_prefix = os.path.realpath(sys.argv[2]) + '/'
for entry in glob.iglob('/proc/[0-9]*'):
    try:
        if entry.rsplit('/', 1)[-1] == str(os.getpid()):
            continue
        if os.readlink(entry + '/exe').startswith((python_prefix, os.fsdecode(prefix))):
            sys.exit(0)
        with open(entry + '/cmdline', 'rb') as stream:
            if any(arg.startswith(prefix) for arg in stream.read().split(b'\0')):
                sys.exit(0)
    except OSError:
        pass
sys.exit(1)
PY
}


install_hermes() (
  local component=${1:-hermes} ready=hermes_ready desktop=0
  if [ "$component" = hermes-desktop ]; then ready=hermes_desktop_ready; desktop=1; fi
  # Updating the CLI must keep an already installed desktop app usable.
  if [ -f "$APPS/hermes/current/.desk-desktop-ready" ]; then desktop=1; fi
  if [ "$(uname -s)" != Linux ]; then fail 'Hermes installation currently supports Linux only.'; return 1; fi
  if [ "$desktop" = 1 ]; then
    case "$(uname -m)" in
      x86_64|aarch64|arm64) ;;
      *) fail 'Hermes Desktop supports Linux x86_64 and ARM64.'; return 1 ;;
    esac
  fi
  if "$ready" && [ "${UPDATE_ONLY:-0}" != 1 ]; then
    ok "$(label "$component") is ready; use desk update $component to check for a newer release."
    return 0
  fi
  if hermes_running; then
    warn 'Hermes is running. Exit its desktop, terminal, and background processes before installing or updating.'
    "$ready"
    return $?
  fi
  local tool
  for tool in git curl python3 make; do
    if ! command -v "$tool" >/dev/null 2>&1; then fail "Hermes setup requires $tool."; return 1; fi
  done
  if ! command -v g++ >/dev/null 2>&1 && ! command -v clang++ >/dev/null 2>&1; then
    fail 'Hermes terminal UI setup needs a C++ compiler (g++ or clang++). Ask an administrator to install it first.'
    return 1
  fi
  # Hermes PM can repair this library through the system package manager.
  # Check it first so a no-sudo desk install never takes that repair path.
  if ! python3 -c 'import ctypes; ctypes.CDLL("libatomic.so.1")' >/dev/null 2>&1; then
    fail 'Hermes needs libatomic.so.1. Ask an administrator to install libatomic1 (Ubuntu/Debian), then retry desk install hermes.'
    return 1
  fi
  hermes_environment || return 1
  info "Checking official $(label "$component") releases"
  python3 - "$APPS/hermes" "${UPDATE_ONLY:-0}" "$desktop" <<'HERMES_INSTALLER'
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile

base, update = Path(sys.argv[1]).resolve(), sys.argv[2] == '1'
desktop = sys.argv[3] == '1'
repo = 'https://github.com/NousResearch/hermes-agent.git'
current = base / 'current'
marker = base / '.desk-release.json'


def command(args, **kwargs):
    return subprocess.check_output(args, text=True, stderr=subprocess.PIPE, **kwargs).strip()


def ready(release):
    return ((release / '.desk-ready').is_file() and
            (not desktop or ((release / '.desk-desktop-ready').is_file() and
                             os.access(release / 'desktop', os.X_OK))))


def main():
    (base / 'downloads').mkdir(parents=True, exist_ok=True)
    (base / 'releases').mkdir(exist_ok=True)
    previous = json.loads(marker.read_text()) if marker.exists() else {}
    if current.exists():
        source = current / 'source'
        if (command(['git', '-C', str(source), 'status', '--porcelain']) or
                command(['git', '-C', str(source), 'rev-parse', 'HEAD']) != previous.get('commit')):
            raise RuntimeError('Hermes has local source changes or an unrecognized revision; preserve them before updating')
    try:
        refs = dict(line.split()[::-1] for line in command(['git', 'ls-remote', '--tags', repo, 'v*']).splitlines())
    except subprocess.CalledProcessError:
        if ready(current):
            print('Hermes release server unavailable; keeping the installed agent.', file=sys.stderr)
            return
        raise
    versions = []
    for ref, commit in refs.items():
        match = re.fullmatch(r'refs/tags/v([0-9]{1,3})\.([0-9]+)\.([0-9]+)', ref)
        if match:
            versions.append((tuple(map(int, match.groups())), ref, refs.get(ref + '^{}', commit)))
    if not versions:
        raise RuntimeError('no stable Hermes source release is available')
    version, ref, commit = max(versions)
    if not re.fullmatch(r'[a-fA-F0-9]{40}', commit):
        raise RuntimeError('invalid Hermes release revision')
    version_text = '.'.join(map(str, version))
    if previous.get('commit') == commit and ready(current):
        print('Hermes ' + version_text + ' is already current.', flush=True)
        return
    if update and re.fullmatch(r'[0-9]+\.[0-9]+\.[0-9]+', previous.get('version', '')):
        if tuple(map(int, previous['version'].split('.'))) > version:
            if ready(current):
                print('Keeping newer installed Hermes ' + previous['version'], flush=True)
                return
            raise RuntimeError('the release server is older than this install; retry when it is current')
    if shutil.disk_usage(base).free < 6 * 1024**3:
        raise RuntimeError('keep at least 6 GB free in goinfre for Hermes and its managed runtime')
    release = base / 'releases' / commit
    source = release / 'source'
    if not release.exists():
        with tempfile.TemporaryDirectory(prefix='source-', dir=base / 'releases') as directory:
            stage = Path(directory)
            subprocess.run(['git', 'clone', '--depth', '1', '--single-branch', '--branch', ref.rsplit('/', 1)[-1],
                            repo, str(stage / 'source')], check=True)
            if command(['git', '-C', str(stage / 'source'), 'rev-parse', 'HEAD']) != commit:
                raise RuntimeError('Hermes release changed during download; retry setup')
            (stage / '.desk-source').write_text(commit)
            stage.rename(release)
    if (not (release / '.desk-source').is_file() or (release / '.desk-source').read_text() != commit or
            command(['git', '-C', str(source), 'rev-parse', 'HEAD']) != commit or
            command(['git', '-C', str(source), 'status', '--porcelain'])):
        raise RuntimeError('unrecognized or modified staged Hermes source')
    installer = source / 'scripts/install.sh'
    if not installer.is_file() or not (source / 'uv.lock').is_file() or not (source / 'pm/lock.json').is_file():
        raise RuntimeError('this Hermes release lacks the supported installer or dependency locks')
    # Hermes PM owns its pinned Python, dependencies and terminal UI. Use its
    # staged protocol without re-cloning, opening setup, or installing services.
    environment = dict(os.environ)
    print('Preparing Hermes ' + version_text + ' with its official package manager', flush=True)
    for stage in ('venv', 'python-deps', 'config', 'products', 'complete'):
        subprocess.run(['bash', str(installer), '--dir', str(source), '--non-interactive',
                        '--skip-browser', '--skip-computer-use', '--stage', stage,
                        *(['--include-desktop'] if desktop else [])],
                       env=environment, check=True)
    executable = source / '.hermes/bin/hermes'
    if not os.access(executable, os.X_OK):
        raise RuntimeError('Hermes did not publish its CLI entry point')
    subprocess.run([str(executable), '--help'], env=environment, check=True,
                   stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=90)
    if desktop:
        # The upstream products stage can defer a failed GUI build while still
        # publishing a working CLI. Never report Desktop ready in that case.
        import platform
        unpacked = {'x86_64': 'linux-unpacked', 'aarch64': 'linux-arm64-unpacked',
                    'arm64': 'linux-arm64-unpacked'}.get(platform.machine())
        if not unpacked:
            raise RuntimeError('Hermes Desktop supports Linux x86_64 and ARM64')
        candidates = [source / 'apps/desktop/release' / unpacked / name for name in ('hermes', 'Hermes')]
        binary = next((path for path in candidates if os.access(path, os.X_OK)), None)
        if binary is None or not (binary.parent / 'resources/app.asar').is_file():
            raise RuntimeError('Hermes Desktop build is incomplete; check the build output and retry desk install hermes-desktop')
        link = release / 'desktop'
        link.unlink(missing_ok=True)
        link.symlink_to(binary.relative_to(release))
        (release / '.desk-desktop-ready').write_text(version_text + '\n')
    (release / '.desk-ready').write_text(version_text + '\n')
    link = base / 'current.new'
    link.unlink(missing_ok=True)
    link.symlink_to(release.relative_to(base))
    link.replace(current)
    marker.write_text(json.dumps({'version': version_text, 'commit': commit}))
    (base / '.installed-version').write_text(version_text + '\n')
    hint = 'Run desk hermes-desktop to open the app.' if desktop else 'Run hermes setup to choose your provider.'
    print('Hermes ' + version_text + ' installed. ' + hint, flush=True)


try:
    main()
except (OSError, ValueError, KeyError, RuntimeError, subprocess.SubprocessError) as error:
    sys.exit('Hermes setup failed: ' + str(error))
HERMES_INSTALLER
)


launch_hermes() (
  with_lock_wait core install_self || return 1
  if [ "${1:-}" = update ]; then
    if [ "$#" != 1 ]; then fail 'Use desk update hermes for this managed installation.'; return 2; fi
    local UPDATE_ONLY=1
    with_lock_wait hermes install_hermes
    return $?
  fi
  if ! hermes_ready; then
    if [ "${PREPARE_ON_LAUNCH:-1}" != 1 ]; then fail 'Run desk install hermes first.'; return 1; fi
    with_lock_wait hermes prepare_hermes_unlocked || return 1
  fi
  hermes_environment || return 1
  export PATH="$APPS/hermes/current/source/.hermes/bin:$PATH"
  exec "$APPS/hermes/current/source/.hermes/bin/hermes" "$@"
)


