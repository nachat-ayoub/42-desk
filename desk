      ;;

    codex)
      launch_codex "$@"
      ;;

    claude)
      launch_claude "$@"
      ;;

    android)
      with_lock_wait core install_self || return 1
      with_lock_wait android launch_android_unlocked "$@"
      ;;

    *) fail "Unknown program: $name"; return 2 ;;
  esac
}


launch_codex() {
  with_lock_wait core install_self || return 1
  if ! codex_ready; then
    if [ "${PREPARE_ON_LAUNCH:-1}" != 1 ]; then
      fail "Codex CLI is not installed. Use 'desk install codex'."
      return 1
    fi
    with_lock_wait codex prepare_codex_unlocked || return 1
  fi
  local cache="$GOINFRE/cache/codex"
  local codex_home=${CODEX_HOME:-$HOME/.codex}
  local logs
  mkdir -p "$cache/tmp" "$cache/log" "$cache/xdg" || return 1
  chmod 700 "$cache" "$cache/tmp" "$cache/log" "$cache/xdg" || return 1
  # Codex also keeps helper binaries in CODEX_HOME/tmp independently of
  # TMPDIR. Redirect new scratch directories; never move existing live data.
  mkdir -p "$codex_home" || return 1
  if [ ! -e "$codex_home/tmp" ] && [ ! -L "$codex_home/tmp" ]; then
    ln -sT "$cache/tmp" "$codex_home/tmp" || [ -e "$codex_home/tmp" ] || return 1
  fi
  logs=$(python3 -c 'import json,sys; print("log_dir=" + json.dumps(sys.argv[1]))' "$cache/log") || return 1
  # Leave CODEX_HOME (auth, config, sessions) untouched. Environment overrides
  # affect only this process and its children, never the caller's shell.
  export XDG_CACHE_HOME="$cache/xdg"
  export TMPDIR="$cache/tmp"
  export PATH="$APPS/codex/codex-path:$PATH"
  # Exec keeps the terminal, signals and exit status; do not hold a setup lock
  # for the lifetime of an interactive Codex session.
  exec "$APPS/codex/bin/codex" -c "$logs" "$@"
}


launch_claude() {
  with_lock_wait core install_self || return 1
  if ! claude_ready; then
    if [ "${PREPARE_ON_LAUNCH:-1}" != 1 ]; then
      fail "Claude Code is not installed. Use 'desk install claude'."
      return 1
    fi
    with_lock_wait claude prepare_claude_unlocked || return 1
  fi
  local cache="$GOINFRE/cache/claude"
  mkdir -p "$cache/tmp" "$cache/xdg" || return 1
  chmod 700 "$cache" "$cache/tmp" "$cache/xdg" || return 1
  export XDG_CACHE_HOME="$cache/xdg"
  export TMPDIR="$cache/tmp"
  # Desk owns updates of this managed copy. Leave Claude credentials,
  # settings, and conversation history in their existing locations.
  export DISABLE_AUTOUPDATER=1
  export CLAUDE_CODE_TMPDIR="$cache/tmp"
  exec "$APPS/claude/claude" "$@"
}


find_launch_terminal() {
  local candidate path
  [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] || return 1
  for candidate in "${TERMINAL:-}" gnome-terminal kgx konsole xfce4-terminal mate-terminal kitty alacritty x-terminal-emulator xterm; do
    [ -n "$candidate" ] || continue
    path=$(command -v "$candidate" 2>/dev/null) || continue
    case "$(basename "$path")" in
      gnome-terminal|kgx|mate-terminal|kitty) TERMINAL_COMMAND=("$path" --) ;;
      xfce4-terminal) TERMINAL_COMMAND=("$path" --disable-server --execute) ;;
      *) TERMINAL_COMMAND=("$path" -e) ;;
    esac
    return 0
  done
  return 1
}


open_ai_terminal() {
  local program=$1
  local log="$STATE_DIR/open-$program.log"
  info "Opening $(label "$program") in a new terminal (log: $(pretty "$log"))"
  start_detached_process "${TERMINAL_COMMAND[@]}" "$BIN_DIR/desk" _open "$program" </dev/null >"$log" 2>&1 &
}


open_programs() {
  local -a PROGRAMS=() available=() preselected=() TERMINAL_COMMAND=()
  local -a PICKER_PROGRAMS=()
  local PICKER_TITLE='Choose programs to open' PICKER_ACTION=open PICKER_COMMAND=open
  local PREPARE_ON_LAUNCH=0
  local program ai_count=0 failed=0
  mapfile -t available < <(installed_programs)
  if [ "${#available[@]}" = 0 ] && [ "$#" = 0 ]; then
    info "No managed programs installed. Use 'desk install' first."
    return 0
  fi
  if [ "$#" = 0 ]; then
    load_programs_from "$OPEN_PROGRAMS_FILE" || return $?
    for program in "${available[@]}"; do
      if selected "$program"; then preselected+=("$program"); fi
    done
    PROGRAMS=("${preselected[@]}")
    PICKER_PROGRAMS=("${available[@]}")
    choose_program_list || return $?
  elif [ "$#" = 1 ] && [ "$1" = all ]; then
    PROGRAMS=("${available[@]}")
  else
    normalize_programs "$@" || return $?
  fi
  # Validate the entire request before opening any program or saving choices.
  for program in "${PROGRAMS[@]}"; do
    if ! program_installed "$program"; then
      fail "$(label "$program") is not installed. Use 'desk install $program' first."
      return 2
    fi
    if ! program_ready "$program"; then
      fail "$(label "$program") needs setup. Run 'desk $program' to finish setup first."
      return 1
    fi
    case "$program" in codex|claude) ai_count=$((ai_count + 1)) ;; esac
  done
  if [ "$ai_count" -gt 1 ] && ! find_launch_terminal; then
    fail 'Opening both AI tools needs a graphical session and a terminal emulator.'
    printf "Open one at a time instead: desk ai  or  desk claude\n" >&2
    return 1
  fi
  with_lock_wait core save_programs_to "$OPEN_PROGRAMS_FILE" || return 1
  if [ "${#PROGRAMS[@]}" = 0 ]; then
    info 'No programs selected to open.'
    return 0
  fi
  with_lock_wait core install_self || return 1
  info "Opening: $(selection_summary)"
  # Start desktop apps first, before a single AI tool takes over this terminal.
  for program in "${PROGRAMS[@]}"; do
    case "$program" in
      code|brave|android) open_app "$program" || failed=1 ;;
    esac
  done
  [ "$failed" = 0 ] || return "$failed"
  for program in "${PROGRAMS[@]}"; do
    case "$program" in
      codex|claude)
        if [ "$ai_count" = 1 ]; then
          open_app "$program"
          return $?
        else
          open_ai_terminal "$program" || failed=1
        fi
        ;;
    esac
  done
  return "$failed"
}


# -------------------------------------------------------------------
# AUTO CHECK
# -------------------------------------------------------------------

stamp_fresh() {
  [ -f "$STAMP" ] ||
    return 1

  local now
  local then

  now=$(date +%s)

  then=$(
    stat \
      -c %Y \
      "$STAMP" \
      2>/dev/null ||
      echo 0
  )

  [ $((now - then)) -lt "$AUTO_CHECK_SECONDS" ]
}


shell_prepare_component() {
  local name=$1
  local rc

  case "$name" in
    code)

      if with_lock_try \
        code \
        prepare_vscode_unlocked
      then
        rc=0
      else
        rc=$?
      fi
      ;;

    brave)

      if with_lock_try \
        brave \
        prepare_brave_unlocked
      then
        rc=0
      else
        rc=$?
      fi
      ;;

    codex)
      if with_lock_try codex prepare_codex_unlocked; then
        rc=0
      else
        rc=$?
      fi
      ;;

    claude)
      if with_lock_try claude prepare_claude_unlocked; then
        rc=0
      else
        rc=$?
      fi
      ;;

    android)
      # Keep routine shell startup offline and fast once Android is ready.
      if android_ready; then return 0; fi
      if with_lock_try android prepare_android_unlocked; then
        rc=0
      else
        rc=$?
      fi
      ;;
  esac

  # Already being handled elsewhere.
  [ "$rc" = 2 ] &&
    return 0

  return "$rc"
}


auto_check() {
  QUIET=1

  touch "$STAMP"

  with_lock_try \
    core \
    prepare_core \
    >/dev/null 2>&1 ||
    true

  local failed=0 program

  for program in "${PROGRAMS[@]}"; do
    shell_prepare_component "$program" >>"$LOG_FILE" 2>&1 || failed=1
  done

  [ "$failed" = 0 ] ||
    notify \
      "desk needs attention — run: desk p"
}


first_run_once() {
  # Another shell may have finished setup between the initial check and
  # acquiring the first-run lock.
  [ -f "$INITIALIZED" ] &&
    return 0

  first_run
}


shell_boot() {
  # ---------------------------------------------------------------
  # Fresh machine:
  #
  # Exactly one interactive shell owns the visible first-run setup.
  # Other shells must never wait for it; they return immediately and
  # remain usable while setup continues in the owner shell.
  # ---------------------------------------------------------------

  if [ ! -f "$INITIALIZED" ]; then
    local rc

    if with_lock_try \
      first-run \
      first_run_once
    then
      return 0
    else
      rc=$?
    fi

    # rc=2 means another shell already owns first-run setup.
    # Do not wait on that shell or on any of its component locks.
    if [ "$rc" = 2 ]; then
      return 0
    fi

    return "$rc"
  fi

  # ---------------------------------------------------------------
  # Normal shells:
  #
  # no setup output, no waiting.
  # ---------------------------------------------------------------

  if stamp_fresh; then
    return 0
  fi

  # Detached update check.
  if command -v setsid >/dev/null 2>&1; then

    setsid \
      -f \
      "$BIN_DIR/desk" \
      _auto \
      >/dev/null 2>&1

  else

    nohup \
      "$BIN_DIR/desk" \
      _auto \
      >/dev/null 2>&1 &

  fi
}


# -------------------------------------------------------------------
# CLEAN
# -------------------------------------------------------------------

managed_wrapper() {
  local file=$1

  [ -f "$file" ] &&
  grep \
    -Eqs '(desk|session-setup)' \
    "$file"
}


native_apps_running() {
  local running=0

  if pgrep \
    -f "$APPS/vscode/" \
    >/dev/null 2>&1
  then

    warn "Native VS Code is running. Close it first."
    running=1
  fi

  if pgrep \
    -f "$APPS/brave/" \
    >/dev/null 2>&1
  then

    warn "Native Brave is running. Close it first."
    running=1
  fi

  if codex_running; then
    warn 'Codex CLI is running. Exit it first.'
    running=1
  fi

  if claude_running; then
    warn 'Claude Code is running. Exit it first.'
    running=1
  fi

  [ "$running" = 0 ]
}


backup_profile_for_clean() {
  local name=$1
  local src=$2
  local dst=$3

  [ -e "$src" ] || return 0

  info "Backing up $(label "$name") profile"
  mkdir -p "$dst"

  if ! rsync \
    -a \
    "${CACHE_EXCLUDES[@]}" \
    "$src/" \
    "$dst/"
  then
    warn "Could not back up $(label "$name") profile"
    return 1
  fi

  rm -rf "$src"
  ok "$(label "$name") profile backed up"
}


clean_reset_unlocked() {
  local backup
  local stamp

  stamp=$(date +%Y%m%d-%H%M%S)
  backup="$GOINFRE/backups/desk-clean-$stamp"

  if [ -e "$NEW_VSCODE" ] || [ -e "$NEW_BRAVE" ]; then
    mkdir -p "$backup"

    backup_profile_for_clean \
      vscode \
      "$NEW_VSCODE" \
      "$backup/Code" || return 1

    backup_profile_for_clean \
      brave \
      "$NEW_BRAVE" \
      "$backup/BraveSoftware/Brave-Browser" || return 1
  fi

  info "Removing desk-managed applications"

  rm -rf \
    "$APPS/vscode" \
    "$APPS/brave" \
    "$APPS/codex" \
    "$GOINFRE/cache/codex" \
    "$APPS/claude" \
    "$GOINFRE/cache/claude" \
    "$GOINFRE/cache/vscode-vsix"

  if managed_wrapper "$BIN_DIR/code"; then
    rm -f "$BIN_DIR/code"
  fi

  if managed_wrapper "$BIN_DIR/brave"; then
    rm -f "$BIN_DIR/brave"
  fi

  if managed_wrapper "$BIN_DIR/codex"; then
    rm -f "$BIN_DIR/codex"
  fi

  if managed_wrapper "$BIN_DIR/claude"; then
    rm -f "$BIN_DIR/claude"
  fi

  if managed_wrapper "$BIN_DIR/android"; then
    rm -f "$BIN_DIR/android"
  fi

  rm -f \
    "$DATA_DIR/applications/code-native.desktop" \
    "$DATA_DIR/applications/brave-native.desktop" \
    "$DATA_DIR/applications/android-desk.desktop"

  rm -f \
    "$INITIALIZED" \
    "$STAMP" \
    "$LOG_FILE"

  printf '\n'
  ok "Fresh-install state restored"

  if [ -d "$backup" ]; then
    printf '  profile backup: %s\n' "$(pretty "$backup")"
  fi

  printf '\n'
  printf 'Close this terminal and open a new one.\n'
  printf 'The first-run setup will start again visibly.\n'
}


clean_busy() {
  printf '\n' >&2
  warn "Another desk setup/update is still running."
  printf 'Wait for it to finish (or stop that desk process), then run: desk clean\n' >&2
}


clean_reset() {
  local answer
  local rc=0
  local held_first=0
  local held_core=0
  local held_code=0
  local held_brave=0
  local held_codex=0
  local held_claude=0

  printf '%bReset 42-desk?%b\n\n' \
    "$C_BOLD" \
    "$C_RESET"

  printf 'This will remove:\n'
  printf '  • desk-managed VS Code\n'
  printf '  • desk-managed Brave\n'
  printf '  • desk-managed Codex CLI and its cache\n'
  printf '  • desk-managed Claude Code and its cache\n'
  printf '  • code/brave/codex/claude/android wrappers\n'
  printf '  • desktop launchers\n'
  printf '  • first-run/update state\n\n'

  printf 'Your native profiles will be backed up first.\n'
  printf 'The desk CLI and shell hook will stay installed.\n\n'
  printf 'Program choices and AI tool authentication/configuration are kept.\n\n'
  printf 'Android SDK, virtual devices, installed apps, and Google sign-in data are kept.\n\n'

  if [ -t 0 ]; then
    read -r -p "Continue? [y/N] " answer

    case "$answer" in
      y|Y|yes|YES) ;;
      *)
        echo "Cancelled."
        return 0
        ;;
    esac
  else
    fail "Run 'desk clean' from an interactive terminal."
    return 1
  fi

  if ! native_apps_running; then
    printf '\n'
    warn "Close the apps above, then run 'desk clean' again."
    return 1
  fi

  # Reset must never sit on a 10-minute flock wait. Acquire every desk lock
  # non-blockingly. first-run is included so clean cannot race a setup between
  # its code and brave phases.
  if lock_try_acquire first-run; then
    held_first=1
  else
    clean_busy
    return 1
  fi

  if lock_try_acquire core; then
    held_core=1
  else
    rc=1
  fi

  if [ "$rc" = 0 ]; then
    if lock_try_acquire code; then
      held_code=1
    else
      rc=1
    fi
  fi

  if [ "$rc" = 0 ]; then
    if lock_try_acquire brave; then
      held_brave=1
    else
      rc=1
    fi
  fi

  if [ "$rc" = 0 ]; then
    if lock_try_acquire codex; then
      held_codex=1
    else
      rc=1
    fi
  fi

  if [ "$rc" = 0 ]; then
    if lock_try_acquire claude; then
      held_claude=1
    else
      rc=1
    fi
  fi

  if [ "$rc" != 0 ]; then
    [ "$held_claude" = 0 ] || lock_release claude
    [ "$held_codex" = 0 ] || lock_release codex
    [ "$held_brave" = 0 ] || lock_release brave
    [ "$held_code" = 0 ] || lock_release code
    [ "$held_core" = 0 ] || lock_release core
    [ "$held_first" = 0 ] || lock_release first-run
    clean_busy
    return 1
  fi

  if clean_reset_unlocked; then
    rc=0
  else
    rc=$?
  fi

  lock_release claude
  lock_release codex
  lock_release brave
  lock_release code
  lock_release core
  lock_release first-run

  return "$rc"
}


# -------------------------------------------------------------------
# Status / repair
# -------------------------------------------------------------------

show_status() {
  local program choice state version executable command
  printf '%b42-desk%b %s\n\n' "$C_BOLD" "$C_RESET" "$VERSION"
  printf '  Storage   %s\n' "$(pretty "$GOINFRE")"
  printf '  Selected  %s\n' "$(selection_summary)"
  printf '\n  %-12s %-9s %-12s %s\n' 'PROGRAM' 'SELECTED' 'STATE' 'VERSION'
  for program in "${ALL_PROGRAMS[@]}"; do
    choice=no
    if selected "$program"; then choice=yes; fi
    state='not installed'
    case "$program" in
      code) executable="$APPS/vscode/bin/code"; version="$APPS/vscode/.installed-version" ;;
      brave) executable="$APPS/brave/brave"; version="$APPS/brave/.installed-version" ;;
      codex) executable="$APPS/codex/bin/codex"; version="$APPS/codex/.installed-version" ;;
      claude) executable="$APPS/claude/claude"; version="$APPS/claude/.installed-version" ;;
      android) executable="$APPS/android/sdk/emulator/emulator"; version="$APPS/android/.installed-version" ;;
    esac
    if [ -x "$executable" ]; then
      state=installed
      case "$program" in
        code) vscode_ready || state='needs import' ;;
        brave) brave_ready || state='needs import' ;;
        android) android_ready || state='needs setup' ;;
      esac
    fi
    version=$(cat "$version" 2>/dev/null || printf '%s' '-')
    printf '  %-12s %-9s %-12s %s\n' "$(label "$program")" "$choice" "$state" "$version"
    if selected "$program"; then
      command=$(command -v "$program" 2>/dev/null || true)
      if [ "$command" != "$BIN_DIR/$program" ]; then
        printf '    Command: %s (managed wrapper: %s/%s)\n' "${command:-not in PATH}" "$(pretty "$BIN_DIR")" "$program"
      fi
    fi
  done
  printf '\n  Update log   %s\n' "$(pretty "$LOG_FILE")"
  printf '  Codex cache  %s\n' "$(pretty "$GOINFRE/cache/codex")"
  printf '  Claude cache %s\n' "$(pretty "$GOINFRE/cache/claude")"
  printf '  Android      %s\n' "$(pretty "$APPS/android")"
  printf '\nInstall/change programs: desk install\n'
  printf 'Prepare/update selection: desk p\n'
  printf 'Open installed programs: desk   |   Update installed programs: desk update\n'
}


repair_cli() {
  with_lock_wait \
    core \
    prepare_core

  ok "CLI and shell hook ready"
}


close_old_apps() {
  [ -z "$OLD_VSCODE" ] ||
  close_old_app \
    vscode \
    "$OLD_VSCODE" ||
  FAILED=1

  [ -z "$OLD_BRAVE" ] ||
  close_old_app \
    brave \
    "$OLD_BRAVE" ||
  FAILED=1

  [ "$FAILED" = 0 ] &&
    ok "Old apps closed"

  return "$FAILED"
}


# -------------------------------------------------------------------
# Main
# -------------------------------------------------------------------

main() {
  local cmd=${1:-run}

  [ $# -gt 0 ] &&
    shift ||
    true

  if [ "$cmd" = "--from-flatpak" ]; then

    FROM_FLATPAK=${1:-}

    shift ||
      true

    cmd=${1:-run}

    [ $# -gt 0 ] &&
      shift ||
      true
  fi

  case "$cmd" in
    -h|--help|help|h)
      usage
      exit 0
      ;;

    -v|--version|version|v)
      echo "desk $VERSION"
      exit 0
      ;;
  esac

  setup_runtime || return $?

  case "$cmd" in
    run|open)
      open_programs "$@"
      ;;

    update|up)
      update_installed_programs "$@"
      ;;

    _open)
      local PREPARE_ON_LAUNCH=0
      [ "$#" -gt 0 ] || return 2
      open_app "$@"
      ;;


    install|choose)
      choose_programs "$@" || return $?
      if prepare_all; then
        touch "$INITIALIZED" "$STAMP"
        ok "Selected programs ready"
        show_next_steps
      else
        fail "Some programs need attention. Run 'desk p' to retry your selection."
        return 1
      fi
      ;;

    ai|codex)
      open_app codex "$@"
      ;;

    claude|cc|claude-code)
      open_app claude "$@"
      ;;

    android|emulator)
      open_app android "$@"
      ;;

    _android-run)
      run_android "$@"
      ;;

    c|code|vscode)

      open_app \
        code \
        "$@"
      ;;


    b|brave)

      open_app \
        brave \
        "$@"
      ;;


    p|prep|prepare)

      if prepare_all; then

        touch "$INITIALIZED"
        touch "$STAMP"

        ok "Ready"

      else

        warn "Finished with warnings"
        exit 1
      fi
      ;;


    s|sync|reimport)

      case "${1:-all}" in
        c|code|vscode)

          REIMPORT="vscode"
          CLOSE_OLD=1

          prepare_vscode
          ;;


        b|brave)

          REIMPORT="brave"
          CLOSE_OLD=1

          prepare_brave
          ;;


        all|"")

          REIMPORT="vscode brave"
          CLOSE_OLD=1

          prepare_vscode
          prepare_brave
          ;;


        *)

          fail "Use: desk s [c|b]"
          exit 2
          ;;
      esac

      ok "Profile synced"
      ;;


    x|close)

      CLOSE_OLD=1
      close_old_apps
      ;;


    st|status)

      show_status
      ;;


    clean|reset)

      clean_reset
      ;;


    fix)

      repair_cli
      ;;


    _shell)

      shell_boot
      ;;


    _auto)

      auto_check
      ;;


    *)

      fail "Unknown command: $cmd"

      printf \
        "Run 'desk help'.\n" \
        >&2

      exit 2
      ;;
  esac
}


if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
