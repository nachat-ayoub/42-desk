# Build settings are also needed by IDE extension hosts. Keep VS Code's own
# XDG profile and temporary directories separate from Flutter's CLI runtime.
flutter_build_environment() {
  FLUTTER_BASE="$APPS/flutter"
  export FLUTTER_ROOT="$FLUTTER_BASE/sdk"
  export PUB_CACHE="${PUB_CACHE:-$FLUTTER_BASE/cache/pub}"
  export GRADLE_USER_HOME="${GRADLE_USER_HOME:-$FLUTTER_BASE/cache/gradle}"
  export PATH="$FLUTTER_ROOT/bin:$PATH"
  mkdir -p "$PUB_CACHE" "$GRADLE_USER_HOME" || return 1
  # Some Android build tools require ANDROID_HOME even when Flutter itself
  # accepts ANDROID_SDK_ROOT. Complete a single binding, preserving conflicts.
  if [ -z "${ANDROID_HOME:-}" ] && [ -n "${ANDROID_SDK_ROOT:-}" ]; then export ANDROID_HOME="$ANDROID_SDK_ROOT"; fi
  if [ -z "${ANDROID_SDK_ROOT:-}" ] && [ -n "${ANDROID_HOME:-}" ]; then export ANDROID_SDK_ROOT="$ANDROID_HOME"; fi
  # Reuse the managed Android SDK only when no external SDK was specified.
  # Its private ADB server is on 5038, not the usual 5037.
  if [ -z "${ANDROID_HOME:-${ANDROID_SDK_ROOT:-}}" ] && { [ -x "$APPS/android/sdk/platform-tools/adb" ] || [ -x "$APPS/android/sdk/cmdline-tools/latest/bin/sdkmanager" ]; }; then
    export ANDROID_HOME="$APPS/android/sdk" ANDROID_SDK_ROOT="$APPS/android/sdk"
  fi
  if [ "${ANDROID_HOME:-${ANDROID_SDK_ROOT:-}}" = "$APPS/android/sdk" ]; then
    export ANDROID_HOME="$APPS/android/sdk" ANDROID_SDK_ROOT="$APPS/android/sdk"
    export ANDROID_USER_HOME="$APPS/android/state/.android"
    export ANDROID_EMULATOR_HOME="$ANDROID_USER_HOME" ANDROID_SDK_HOME="$APPS/android/state"
    export ANDROID_AVD_HOME="$APPS/android/avd"
    export ANDROID_ADB_SERVER_PORT="${ANDROID_ADB_SERVER_PORT:-5038}" ADB_SERVER_PORT="${ADB_SERVER_PORT:-5038}"
    export ADB_SERVER_SOCKET="${ADB_SERVER_SOCKET:-tcp:localhost:5038}"
    mkdir -p "$ANDROID_USER_HOME" "$ANDROID_AVD_HOME" || return 1
  fi
  if [ -z "${JAVA_HOME:-}" ] && [ -x "$FLUTTER_BASE/tools/jdk/bin/java" ]; then
    export JAVA_HOME="$FLUTTER_BASE/tools/jdk"
  fi
  if [ -n "${JAVA_HOME:-}" ]; then export PATH="$JAVA_HOME/bin:$PATH"; fi
  if [ -x "$FLUTTER_BASE/tools/ninja/bin/ninja" ]; then
    export PATH="$FLUTTER_BASE/tools/ninja/bin:$PATH"
  fi
  # Flutter must spawn a foreground browser with its own debugging profile.
  # The ordinary desk brave launcher detaches and cannot serve this purpose.
  if [ -z "${CHROME_EXECUTABLE:-}" ]; then
    if command -v google-chrome >/dev/null 2>&1; then
      export CHROME_EXECUTABLE="$(command -v google-chrome)"
    elif [ -x "$APPS/brave/brave" ]; then
      export CHROME_EXECUTABLE="$APPS/brave/brave"
    fi
  fi
}


