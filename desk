            # wheels bundled the binary under ninja/data/bin instead.
            binaries = list(stage.glob('*.data/scripts/ninja'))
            legacy = stage / 'ninja/data/bin/ninja'
            if legacy.is_file():
                binaries.append(legacy)
            if len(binaries) != 1 or not binaries[0].is_file():
                raise RuntimeError('unexpected Ninja wheel layout')
            (stage / 'bin').mkdir(exist_ok=True)
            binaries[0].rename(stage / entry)
        executable = content / entry
        if not executable.is_file() or (tool == 'jdk' and not (content / 'bin/javac').is_file()):
            raise RuntimeError('tool archive is missing required executables')
        executable.chmod(executable.stat().st_mode | 0o755)
        subprocess.run([str(executable), '--version'], check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        destination.parent.mkdir(parents=True, exist_ok=True)
        content.rename(destination)
    archive.unlink()
    print('Installed ' + tool + ' in ' + str(destination), flush=True)


try:
    main()
except (OSError, ValueError, IndexError, KeyError, RuntimeError, tarfile.TarError,
        zipfile.BadZipFile, subprocess.SubprocessError) as error:
    sys.exit('Flutter tool setup failed: ' + str(error))
FLUTTER_TOOL
)


