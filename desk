launch_ai_desktop_unlocked() (
  local app=$1
  shift
  if ! ai_desktop_ready "$app"; then
    if [ "${PREPARE_ON_LAUNCH:-1}" != 1 ]; then fail "Run desk install $app first."; return 1; fi
    prepare_ai_desktop_unlocked "$app" || return 1
  fi
  if [ "$app" = codex-desktop ]; then prepare_codex_desktop_storage || return 1; fi
  local cache="$GOINFRE/cache/$app"
  local executable="$APPS/$app/current/AppRun"
  export APPDIR="$APPS/$app/current"
  if [ "$app" = claude-desktop ]; then export CLAUDE_FORCE_SANDBOX="${CLAUDE_FORCE_SANDBOX:-1}"; fi
  export XDG_CACHE_HOME="$cache/xdg" TMPDIR="$cache/tmp" TMP="$cache/tmp" TEMP="$cache/tmp"
  export MESA_SHADER_CACHE_DIR="$cache/mesa" __GL_SHADER_DISK_CACHE_PATH="$cache/nvidia"
  mkdir -p "$cache" "$XDG_CACHE_HOME" "$TMPDIR" "$MESA_SHADER_CACHE_DIR" "$__GL_SHADER_DISK_CACHE_PATH" || return 1
  chmod 700 "$cache" || return 1
  if [ "$app" = openmausbot ]; then
    # Its AppRun automatically adds --no-sandbox on restricted hosts. Launch
    # the extracted native app with its bundled libraries and keep the sandbox.
    executable="$APPDIR/openmausbot"
    export LD_LIBRARY_PATH="$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    # Application-menu launches may have a minimal PATH. Expose desk's agent
    # wrappers without installing additional programs.
    export PATH="$BIN_DIR:$PATH"
    # Keep credentials and settings in their normal profile. Redirect only new
    # cache directories; leave any existing independently managed ones intact.
    local profile="$CONF_DIR/openmausbot" directory target
    mkdir -p "$profile" || return 1
    for directory in 'Code Cache' GPUCache DawnGraphiteCache DawnWebGPUCache ShaderCache GrShaderCache server-compile-cache; do
      target="$cache/profile/$directory"
      mkdir -p "$target" || return 1
      if [ ! -e "$profile/$directory" ] && [ ! -L "$profile/$directory" ]; then
        ln -sT "$target" "$profile/$directory" || return 1
      fi
    done
  fi
  if [ "$app" = claude-desktop ] && { [ "${1:-}" = --version ] || [ "${1:-}" = --doctor ]; }; then
    exec "$APPS/$app/current/AppRun" "$@"
  fi
  info "Opening $(label "$app") (log: $(pretty "$STATE_DIR/open-$app.log"))"
  start_detached_process "$executable" --disable-setuid-sandbox --disk-cache-dir="$cache/chromium" "$@" \
    </dev/null >"$STATE_DIR/open-$app.log" 2>&1 &
)


