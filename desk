# -------------------------------------------------------------------
# Discovery
# -------------------------------------------------------------------

find_goinfre() {
  if [ -n "${GOINFRE:-}" ]; then
    echo "$GOINFRE"

  elif [ -d /goinfre ]; then
    echo "/goinfre/$USER"

  elif [ -d "$HOME/goinfre" ]; then
    readlink -f "$HOME/goinfre"

  else
    echo "$HOME/.local/opt"
  fi
}


newest() {
  find "$@" \
    -maxdepth 0 \
    -printf '%T@ %p\n' \
    2>/dev/null |
    sort -rn |
    head -n1 |
    cut -d' ' -f2- ||
    true
}


latest_bin() {
  [ -d "${1:-}" ] &&
    printf '%s\n' "$@" |
      sort -V |
      tail -n1 ||
    true
}


app_root() {
  local rest

  case "${1:-}" in
    "$HOME"/.var/app/*)
      rest=${1#"$HOME"/.var/app/}
      echo "$HOME/.var/app/${rest%%/*}"
      ;;

    "$HOME"/snap/*)
      rest=${1#"$HOME"/snap/}
      echo "$HOME/snap/${rest%%/*}/current"
      ;;
  esac
}


find_vscode_extensions() {
  local root

  root=$(app_root "${OLD_VSCODE:-}")

  if [ -n "$root" ] &&
     [ -d "$root/data/vscode/extensions" ]
  then
    echo "$root/data/vscode/extensions"
  else
    echo "$HOME/.vscode/extensions"
  fi
}


find_node_bin() {
  local d
  local def
  local bin

  for d in \
    "${NVM_DIR:-}" \
    "$HOME/.nvm" \
    "$HOME"/.var/app/*/config/nvm
  do

    [ -n "$d" ] &&
    [ -d "$d/versions/node" ] ||
      continue

    def=$(cat "$d/alias/default" 2>/dev/null || true)

    bin=$(
      latest_bin \
        "$d/versions/node/v${def#v}"*/bin \
        || true
    )

    [ -n "$bin" ] ||
      bin=$(
        latest_bin \
          "$d"/versions/node/*/bin \
          || true
      )

    if [ -n "$bin" ]; then
      echo "$bin"
      return 0
    fi
  done
}


setup_runtime() {
  GOINFRE=$(find_goinfre)
  APPS="$GOINFRE/apps"

  OLD_VSCODE=$(
    newest \
      "$HOME"/.var/app/*/config/Code \
      "$HOME"/snap/code/current/.config/Code
  )

  OLD_BRAVE=$(
    newest \
      "$HOME"/.var/app/*/config/BraveSoftware/Brave-Browser \
      "$HOME"/snap/brave/current/.config/BraveSoftware/Brave-Browser
  )

  VSCODE_EXTENSIONS=$(find_vscode_extensions)

  mkdir -p \
    "$STATE_DIR" \
    "$LOCK_DIR"

  if ! mkdir -p "$APPS" 2>/dev/null; then
    fail "Can't write to $GOINFRE"

    printf \
      'Set GOINFRE to a directory you own, e.g. GOINFRE=/goinfre/%s desk p\n' \
      "$USER" >&2

    exit 1
  fi

  chmod 700 "$GOINFRE" 2>/dev/null || true
  load_programs
}


# -------------------------------------------------------------------
# Old Flatpak / Snap processes
# -------------------------------------------------------------------

old_app_pids() {
  local root
  local roots

  root=$(app_root "$1")

  case "$root" in
    "$HOME"/.var/app/*)

      command -v flatpak >/dev/null 2>&1 ||
        return 0

      roots=$(
        flatpak ps \
          --columns=child-pid,application \
          2>/dev/null |
        awk \
          -v id="$(basename "$root")" \
          '$2 == id {printf "%s ", $1}'
      )

      [ -n "$roots" ] ||
        return 0

      ps -eo pid=,ppid=,args= |
      awk \
        -v roots="$roots" \
        '
          BEGIN {
            n = split(roots, r, " ")

            for (i = 1; i <= n; i++)
              root[r[i]] = 1
          }

          root[$2] &&
          $3 !~ /(^|\/)(bwrap|cat|gsettings)$/ &&
          $3 !~ /crashpad_handler/ &&
          $0 !~ /--type=/ {
            print $1
          }
        '
      ;;

    "$HOME"/snap/*)

      pgrep \
        -f "/snap/$(basename "$(dirname "$root")")/" \
        || true
      ;;
  esac
}


old_app_running() {
  [ -n "$(old_app_pids "$1")" ]
}


close_old_app() {
  local name=$1
  local old=$2

  local root
  local id=""
  local snap=""
  local p

  old_app_running "$old" ||
    return 0

  root=$(app_root "$old")

  case "$root" in
    "$HOME"/.var/app/*)
      id=$(basename "$root")
      ;;

    "$HOME"/snap/*)
      snap=$(basename "$(dirname "$root")")
      ;;
  esac

  if [ -n "$id" ] &&
     [ "$id" = "$FROM_FLATPAK" ]
  then
    warn \
      "Run desk from a regular terminal; this Flatpak terminal would close itself."

    return 1
  fi

  info "Closing old $(label "$name")"

  for p in $(old_app_pids "$old"); do
    kill -TERM "$p" 2>/dev/null || true
  done

  for _ in $(seq 1 15); do
    old_app_running "$old" ||
      break

    sleep 1
  done

  if [ -n "$id" ]; then
    flatpak kill "$id" 2>/dev/null || true

  elif old_app_running "$old"; then
    pkill \
      -KILL \
      -f "/snap/$snap/" \
      2>/dev/null ||
      true
  fi

  sleep 1

  if old_app_running "$old"; then
    warn "Couldn't close old $(label "$name")"
    return 1
  fi
}


offer_close_old() {
  local name=$1
  local old=$2
  local answer

  if [ "$CLOSE_OLD" != 1 ]; then

    if [ "$QUIET" = 1 ] ||
       [ ! -t 0 ]
    then
      return 1
    fi

    read \
      -r \
      -p "Old $(label "$name") is still running. Close it? [Y/n] " \
      answer ||
      return 1

    case "$answer" in
      ""|[Yy]*) ;;
      *) return 1 ;;
    esac
  fi

  close_old_app "$name" "$old"
}


# -------------------------------------------------------------------
# FIRST RUN
# -------------------------------------------------------------------

first_run_wait_for_old_apps() {
  local vscode_running=0
  local brave_running=0
  local answer

  while true; do

    vscode_running=0
    brave_running=0

    if selected code && [ -n "$OLD_VSCODE" ] &&
       old_app_running "$OLD_VSCODE"
    then
      vscode_running=1
    fi

    if selected brave && [ -n "$OLD_BRAVE" ] &&
       old_app_running "$OLD_BRAVE"
    then
      brave_running=1
    fi

    if [ "$vscode_running" = 0 ] &&
       [ "$brave_running" = 0 ]
    then
      return 0
    fi

    printf '\n'
    warn "Before the first setup, close your old apps so their profiles can be copied safely."
    printf '\n'

    if [ "$vscode_running" = 1 ]; then
      printf '  %b•%b VS Code — %bFile > Exit%b\n' \
        "$C_YELLOW" "$C_RESET" \
        "$C_BOLD" "$C_RESET"
    fi

    if [ "$brave_running" = 1 ]; then
      printf '  %b•%b Brave   — %bCtrl+Shift+Q%b\n' \
        "$C_YELLOW" "$C_RESET" \
        "$C_BOLD" "$C_RESET"
    fi

    printf '\n'

    if [ ! -t 0 ]; then
      warn "Run 'desk p' from an interactive terminal after closing them."
      return 1
    fi

    read \
      -r \
      -p "Close them, then press Enter to continue (q to cancel): " \
      answer

    case "$answer" in
      q|Q)
        return 1
        ;;
    esac

  done
}


first_run() {
  printf '\n'
  printf '%b42-desk first setup%b\n' \
    "$C_BOLD" \
    "$C_RESET"

  printf '%bPreparing this workstation for you.%b\n\n' \
    "$C_DIM" \
    "$C_RESET"

