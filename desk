hermes_environment() {
  local cache="$GOINFRE/cache/hermes"
  export HERMES_HOME="${HERMES_HOME:-$HOME/.hermes}"
  export XDG_CACHE_HOME="$cache/xdg" TMPDIR="$cache/tmp" TMP="$cache/tmp" TEMP="$cache/tmp"
  export UV_CACHE_DIR="$cache/uv" UV_PYTHON_INSTALL_DIR="$cache/python"
  export HERMES_RUNTIME_DIR="$cache/runtime" PIP_CACHE_DIR="$cache/pip"
  export npm_config_cache="$cache/npm" PYTHONPYCACHEPREFIX="$cache/pycache"
  export ELECTRON_CACHE="$cache/electron" ELECTRON_BUILDER_CACHE="$cache/electron-builder"
  # Electron's downloader needs an opt-in to honor the shell's proxy settings.
  if [ -n "${HTTPS_PROXY:-${https_proxy:-${HTTP_PROXY:-${http_proxy:-}}}}" ]; then
    export ELECTRON_GET_USE_PROXY="${ELECTRON_GET_USE_PROXY:-1}"
  fi
  export UV_NO_CONFIG=1
  mkdir -p "$cache" "$XDG_CACHE_HOME" "$TMPDIR" "$UV_CACHE_DIR" "$UV_PYTHON_INSTALL_DIR" \
    "$HERMES_RUNTIME_DIR" "$PIP_CACHE_DIR" "$npm_config_cache" "$PYTHONPYCACHEPREFIX" \
    "$ELECTRON_CACHE" "$ELECTRON_BUILDER_CACHE" || return 1
  chmod 700 "$cache" || return 1
  # New PM generations, tools and download caches belong in goinfre. Existing
  # Hermes data and independently installed runtimes are never moved.
  mkdir -p "$HERMES_HOME" || return 1
  local directory target
  for directory in installs tools cache image_cache audio_cache; do
    target="$cache/$directory"
    [ "$directory" != tools ] || target="$HERMES_RUNTIME_DIR"
    mkdir -p "$target" || return 1
    if [ ! -e "$HERMES_HOME/$directory" ] && [ ! -L "$HERMES_HOME/$directory" ]; then
      ln -sT "$target" "$HERMES_HOME/$directory" || return 1
    fi
  done
}


