    prepare_hermes_desktop_unlocked || return 1
  fi
  hermes_environment || return 1
  # Pin the app to this installation's managed backend instead of allowing
  # first launch to install another copy under the home directory.
  export HERMES_DESKTOP_HERMES="$APPS/hermes/current/source/.hermes/bin/hermes"
  export HERMES_INSTALL_ROOT="$APPS/hermes/current/source"
  export PATH="$APPS/hermes/current/source/.hermes/bin:$PATH"
