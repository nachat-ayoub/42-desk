program_executable() {
  case "$1" in
    code) printf '%s/vscode/bin/code\n' "$APPS" ;;
    brave) printf '%s/brave/brave\n' "$APPS" ;;
    codex|claude) native_cli_path "$1" ;;
    android) printf '%s/android/sdk/emulator/emulator\n' "$APPS" ;;
    *) return 2 ;;
  esac
}


program_installed() {
  local executable
  if [ "$1" = android ]; then android_ready; return $?; fi
  executable=$(program_executable "$1") || return $?
  [ -x "$executable" ]
}


program_ready() {
  case "$1" in
    code) vscode_ready ;;
    brave) brave_ready ;;
    codex|claude) native_cli_ready "$1" ;;
    android) android_ready ;;
    *) return 2 ;;
  esac
}


installed_programs() {
  local program
  for program in "${ALL_PROGRAMS[@]}"; do
    if program_installed "$program"; then printf '%s\n' "$program"; fi
  done
  return 0
}


update_installed_programs() {
  local -a PROGRAMS=() available=()
  local UPDATE_ONLY=1
  local program number=0 failed=0
  mapfile -t available < <(installed_programs)
  if [ "$#" = 0 ] || { [ "$#" = 1 ] && [ "$1" = all ]; }; then
    PROGRAMS=("${available[@]}")
  else
    normalize_programs "$@" || return $?
  fi
  for program in "${PROGRAMS[@]}"; do
    if ! program_installed "$program"; then
      fail "$(label "$program") is not installed. Use 'desk install $program' first."
      return 2
    fi
  done
  if [ "${#PROGRAMS[@]}" = 0 ]; then
    info "No installed programs selected for update. Install programs with 'desk install'."
    return 0
  fi
  with_lock_wait core install_self || return 1
  info "Checking installed programs: $(selection_summary)"
  for program in "${PROGRAMS[@]}"; do
    number=$((number + 1))
    info "[$number/${#PROGRAMS[@]}] $(label "$program")"
    case "$program" in
      code) with_lock_wait code install_vscode || failed=1 ;;
      brave) with_lock_wait brave install_brave || failed=1 ;;
      codex) with_lock_wait codex install_codex || failed=1 ;;
      claude) with_lock_wait claude install_claude || failed=1 ;;
      android) with_lock_wait android install_android || failed=1 ;;
    esac
  done
  if [ "$failed" = 0 ]; then
    ok "Update check complete. No programs opened."
  else
    fail "Some update checks failed. Retry with 'desk update'."
  fi
  return "$failed"
}


start_detached_process() {
  if command -v setsid >/dev/null 2>&1; then
    exec setsid "$@"
  else
    trap '' HUP
    exec "$@"
  fi
}


launch_vscode_unlocked() {
  local node_bin
  local cmd_pid

  if ! vscode_ready && [ "${PREPARE_ON_LAUNCH:-1}" = 1 ]; then
    prepare_vscode_unlocked || true
  fi

  vscode_ready ||
  {
    fail "VS Code is not ready. Run 'desk p'."
    return 1
  }

  node_bin=$(find_node_bin)
  export PATH="$BIN_DIR${node_bin:+:$node_bin}:$PATH"

  start_detached_process "$APPS/vscode/bin/code" \
    --extensions-dir "$VSCODE_EXTENSIONS" \
    "$@" </dev/null &

  cmd_pid=$!

  for _ in $(seq 1 20); do
    pgrep -f "$APPS/vscode/" >/dev/null 2>&1 && break
    kill -0 "$cmd_pid" 2>/dev/null || break
    sleep 0.05
  done

  # Do not wait for the GUI lifetime. The per-app lock only protects startup
  # and preparation; returning here keeps `code .` responsive.
  return 0
}


has_gpu_render_device() {
  local device

  for device in "$1"/renderD*; do
    if [ -c "$device" ] && [ -r "$device" ] && [ -w "$device" ]; then
      return 0
    fi
  done

  return 1
}


launch_brave_unlocked() {
  local cmd_pid
  local -a gpu_args=()

  if ! brave_ready && [ "${PREPARE_ON_LAUNCH:-1}" = 1 ]; then
    prepare_brave_unlocked || true
  fi

  brave_ready ||
  {
    fail "Brave is not ready. Run 'desk p'."
    return 1
  }

  # With no usable render node (e.g. a workstation booted with nomodeset),
  # Mesa may fall back to llvmpipe, which Chromium blocklists for WebGL.
  # Keep the usual profile and sandbox; allow that software-rendering path.
  if ! has_gpu_render_device /dev/dri; then
    gpu_args=(--ignore-gpu-blocklist)
  fi

  start_detached_process "$APPS/brave/brave" \
    --class="$BRAVE_WM_CLASS" \
    --disk-cache-size="$BRAVE_CACHE_BYTES" \
    "${gpu_args[@]}" \
    "$@" </dev/null &

  cmd_pid=$!

  for _ in $(seq 1 20); do
    pgrep -f "$APPS/brave/" >/dev/null 2>&1 && break
    kill -0 "$cmd_pid" 2>/dev/null || break
    sleep 0.05
  done

  return 0
}


