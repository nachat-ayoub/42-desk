# -------------------------------------------------------------------
# Locks
# -------------------------------------------------------------------
#
# Do not use flock here. 42/1337 home directories can live on filesystems
# where flock behaviour is surprising across shells. Atomic mkdir locks work
# reliably for our use case and also let us detect/recover a dead owner.

lock_dir() {
  printf '%s/%s.lock' "$LOCK_DIR" "$1"
}


lock_try_acquire() {
  local name=$1
  local dir
  local owner=""

  dir=$(lock_dir "$name")

  if mkdir "$dir" 2>/dev/null; then
    printf '%s\n' "$$" > "$dir/pid"
    return 0
  fi

  # Recover a stale lock left behind by a killed/crashed desk process.
  if [ -r "$dir/pid" ]; then
    read -r owner < "$dir/pid" || owner=""

    if [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; then
      rm -rf "$dir"

      if mkdir "$dir" 2>/dev/null; then
        printf '%s\n' "$$" > "$dir/pid"
        return 0
      fi
    fi
  fi

  return 2
}


lock_release() {
  local name=$1
  local dir
  local owner=""

  dir=$(lock_dir "$name")

  [ -r "$dir/pid" ] || return 0
  read -r owner < "$dir/pid" || owner=""

  if [ "$owner" = "$$" ]; then
    rm -rf "$dir"
  fi
}


lock_wait_acquire() {
  local name=$1
  local deadline
  local now

  deadline=$(( $(date +%s) + LOCK_WAIT_SECONDS ))

  while true; do
    if lock_try_acquire "$name"; then
      return 0
    fi

    now=$(date +%s)

    if [ "$now" -ge "$deadline" ]; then
      fail "desk is busy ($name)"
      return 1
    fi

    sleep 0.1
  done
}


with_lock_wait() {
  local lock=$1
  shift

  local rc

  lock_wait_acquire "$lock" || return 1

  if "$@"; then
    rc=0
  else
    rc=$?
  fi

  lock_release "$lock"
  return "$rc"
}


with_lock_try() {
  local lock=$1
  shift

  local rc

  lock_try_acquire "$lock" || return 2

  if "$@"; then
    rc=0
  else
    rc=$?
  fi

  lock_release "$lock"
  return "$rc"
}


