# Native platform artifacts from the vendors' official npm distributions.
# We unpack their binaries directly; Node/npm are not required at runtime.
native_cli_path() {
  case "$1" in
    codex) printf '%s/codex/bin/codex\n' "$APPS" ;;
    claude) printf '%s/claude/claude\n' "$APPS" ;;
    *) return 1 ;;
  esac
}


native_cli_ready() {
  [ -x "$(native_cli_path "$1")" ]
}


native_cli_running() {
  local path
  path=$(native_cli_path "$1") || return 1
  if pgrep -f "$path" >/dev/null 2>&1; then return 0; fi
  [ -e "$path" ] || return 1
  # Native CLIs can change their process title. Check Linux's executable
  # links too, rather than replacing a live binary whose command was renamed.
  python3 - "$path" <<'PY'
import glob
import os
import sys

expected = os.path.realpath(sys.argv[1])
for link in glob.iglob('/proc/[0-9]*/exe'):
    try:
        executable = os.readlink(link)
    except OSError:
        continue
    if executable == expected or executable == expected + ' (deleted)':
        sys.exit(0)
sys.exit(1)
PY
}


codex_ready() { native_cli_ready codex; }
codex_running() { native_cli_running codex; }
claude_ready() { native_cli_ready claude; }
claude_running() { native_cli_running claude; }


native_cli_offline() {
  if native_cli_ready "$1"; then
    warn "$(label "$1"): update server unavailable; keeping the installed version."
    return 0
  fi
  fail "$(label "$1"): could not read package metadata. Check registry.npmjs.org access and run '$(retry_program_command "$1")'."
  return 1
}


verify_npm_integrity() {
  python3 - "$1" "$2" <<'PY'
import base64
import hashlib
import hmac
import sys

try:
    algorithm, value = sys.argv[2].split('-', 1)
    if algorithm != 'sha512':
        raise ValueError('expected SHA-512 integrity metadata')
    expected = base64.b64decode(value, validate=True)
    digest = hashlib.sha512()
    with open(sys.argv[1], 'rb') as archive:
        for chunk in iter(lambda: archive.read(1024 * 1024), b''):
            digest.update(chunk)
    if not hmac.compare_digest(digest.digest(), expected):
        raise ValueError('archive checksum mismatch')
except (OSError, ValueError) as error:
    sys.exit(f'Artifact verification failed: {error}')
PY
}


install_native_cli() {
  local name=$1
  local arch target meta details latest package_version package_url url integrity tmp tool
  local source entry root_package platform have
  local dest="$APPS/$name"
  local -a fields=()
  for tool in curl python3 tar; do
    if ! command -v "$tool" >/dev/null 2>&1; then
      fail "$(label "$name") installation requires $tool. Install it, then run '$(retry_program_command "$name")'."
      return 1
    fi
  done
  if [ "$(uname -s)" != Linux ]; then
    fail "$(label "$name") installation currently supports Linux only."
    return 1
  fi
  case "$(uname -m)" in
    x86_64|amd64) arch=x64; target=x86_64-unknown-linux-musl ;;
    aarch64|arm64) arch=arm64; target=aarch64-unknown-linux-musl ;;
    *) fail "$(label "$name"): unsupported architecture $(uname -m)."; return 1 ;;
  esac
  platform="linux-$arch"
  case "$name" in
    codex)
      root_package='@openai%2fcodex'
      source="package/vendor/$target"
      entry=bin/codex
      ;;
    claude)
      root_package='@anthropic-ai%2fclaude-code'
      source=package
      entry=claude
      if ldd --version 2>&1 | grep -qi musl; then platform="$platform-musl"; fi
      ;;
    *) return 2 ;;
  esac
  info "Checking $(label "$name")"
  if ! meta=$(curl -fsSL --max-time 15 "https://registry.npmjs.org/$root_package/latest"); then
    native_cli_offline "$name"
    return $?
  fi
  if ! details=$(python3 -c '
import json, re, sys
from urllib.parse import quote
try:
    p = json.load(sys.stdin)
    name, platform = sys.argv[1:]
    version = p["version"]
    if not re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+", version):
        raise ValueError("invalid stable version")
    if name == "codex":
        package = "@openai/codex"
        package_version = version + "-" + platform
        alias = p["optionalDependencies"]["@openai/codex-" + platform]
        if alias != "npm:" + package + "@" + package_version:
            raise ValueError("unrecognized Codex platform package")
    else:
        package = "@anthropic-ai/claude-code-" + platform
        package_version = p["optionalDependencies"][package]
        if package_version != version:
            raise ValueError("unrecognized Claude platform package")
    print(version)
    print(package_version)
    print("https://registry.npmjs.org/" + quote(package, safe="@") + "/" + package_version)
except (ValueError, KeyError, TypeError) as error:
    sys.exit(f"Invalid package metadata: {error}")
' "$name" "$platform" <<< "$meta"); then
    native_cli_offline "$name"
    return $?
  fi
  mapfile -t fields <<< "$details"
  latest=${fields[0]}
  package_version=${fields[1]}
  package_url=${fields[2]}
  have=$(cat "$dest/.installed-version" 2>/dev/null || true)
  if native_cli_ready "$name" && [ "$have" = "$latest" ]; then
    ok "$(label "$name") $latest"
    return 0
  fi
  if [ "${UPDATE_ONLY:-0}" = 1 ] && [ -n "$have" ] && ! version_is_newer "$latest" "$have"; then
    ok "$(label "$name") $have (newer than latest stable $latest; keeping installed version)"
    return 0
  fi
  if native_cli_running "$name"; then
    warn "$(label "$name") $latest available; exit $(label "$name") and run '$(retry_program_command "$name")'."
    return 0
  fi
  if ! meta=$(curl -fsSL --max-time 15 "$package_url"); then
    native_cli_offline "$name"
    return $?
  fi
  if ! details=$(python3 -c '
import json, sys
from urllib.parse import urlparse
try:
    p = json.load(sys.stdin)
    if p["version"] != sys.argv[1]:
        raise ValueError("unexpected platform version")
    url = p["dist"]["tarball"]
    parsed = urlparse(url)
    if parsed.scheme != "https" or parsed.netloc != "registry.npmjs.org":
        raise ValueError("unexpected download host")
    integrity = p["dist"]["integrity"]
    if not integrity.startswith("sha512-") or "\n" in integrity:
        raise ValueError("missing SHA-512 integrity metadata")
    print(url)
    print(integrity)
except (ValueError, KeyError, TypeError) as error:
    sys.exit(f"Invalid platform metadata: {error}")
' "$package_version" <<< "$meta"); then
    return 1
  fi
  mapfile -t fields <<< "$details"
  url=${fields[0]}
  integrity=${fields[1]}
  tmp=$(mktemp -d "$GOINFRE/.desk-$name.XXXXXX") || return 1
  info "Downloading $(label "$name") $latest"
  if ! {
    curl -fL --connect-timeout 15 --max-time 600 --progress-bar "$url" -o "$tmp/archive.tgz" &&
    verify_npm_integrity "$tmp/archive.tgz" "$integrity" &&
    mkdir "$tmp/x" &&
    tar -xzf "$tmp/archive.tgz" --no-same-owner -C "$tmp/x" &&
    [ -x "$tmp/x/$source/$entry" ] &&
    "$tmp/x/$source/$entry" --version &&
    printf '%s\n' "$latest" > "$tmp/x/$source/.installed-version"
  }; then
    rm -rf "$tmp"
    fail "$(label "$name") installation failed; existing installation kept. Run '$(retry_program_command "$name")' to retry."
    return 1
  fi
  if native_cli_running "$name"; then
    rm -rf "$tmp"
    warn "$(label "$name") started while downloading; update postponed."
    return 0
  fi
  if [ -e "$dest" ] && ! mv "$dest" "$tmp/previous"; then
    rm -rf "$tmp"
    return 1
  fi
  if ! mv "$tmp/x/$source" "$dest"; then
    if [ -e "$tmp/previous" ] && ! mv "$tmp/previous" "$dest"; then
      fail "Could not restore $(label "$name"). Previous installation preserved at $tmp/previous"
      return 1
    fi
    rm -rf "$tmp"
    return 1
  fi
  rm -rf "$tmp"
  ok "$(label "$name") $latest installed"
}


install_codex() { install_native_cli codex; }
install_claude() { install_native_cli claude; }


# -------------------------------------------------------------------
# Profile migration
# -------------------------------------------------------------------

has_real_data() {
  [ -e "$1/Default/Preferences" ] ||
  [ -e "$1/User/globalStorage/state.vscdb" ]
}


mark_old_import_as_current() {
  local dir=$1

  [ -f "$dir/$MARKER" ] ||
  [ ! -f "$dir/$OLD_MARKER" ] ||
  cp \
    "$dir/$OLD_MARKER" \
    "$dir/$MARKER" \
    2>/dev/null ||
  true
}


carry_tool_configs() {
  local root=$1

  local kind
  local dest
  local item
  local name

  for kind in config data; do

    if [ "$kind" = config ]; then
      dest=$CONF_DIR
    else
      dest=$DATA_DIR
    fi

    for item in "$root/$kind"/*; do

      [ -e "$item" ] ||
        continue

      name=$(basename "$item")

      case "$name" in
        BraveSoftware|Code|vscode|nvm|dconf|glib-2.0|gtk-*|ibus|pulse|fontconfig|user-dirs.*|recently-used.xbel|flatpak*|mimeapps.list|QtProject.conf|kdeglobals)
          continue
          ;;
      esac

      [ -e "$dest/$name" ] &&
        continue

      mkdir -p "$dest"

      cp \
        -a \
        "$item" \
        "$dest/"

      info "Copied $kind/$name from old sandbox"
    done
  done
}


import_data() {
  local name=$1
  local old=$2
  local new=$3

  local bak
  local root

  [ -n "$old" ] ||
    return 0

  mark_old_import_as_current "$new"

  if [[ " $REIMPORT " != *" $name "* ]]; then

    [ -f "$new/$MARKER" ] &&
      return 0

    if has_real_data "$new"; then

      mkdir -p "$new"

      printf \
        'kept=existing\ndate=%s\n' \
        "$(date -Is)" \
        > "$new/$MARKER"

      info "Keeping existing $(label "$name") profile"

      return 0
    fi
  fi

  if old_app_running "$old" &&
     ! offer_close_old "$name" "$old"
  then

    warn \
      "$(label "$name") profile not imported; old app is running ($(quit_hint "$name"))."

    return 1
  fi

  if pgrep \
    -f "$APPS/$name/" \
    >/dev/null 2>&1
  then

    warn \
      "Close native $(label "$name") before re-importing"

    return 1
  fi

  if [ -e "$new" ]; then

    bak="$GOINFRE/backups/$(basename "$new")-$(date +%Y%m%d-%H%M%S)"

    mkdir -p "$GOINFRE/backups"

    mv \
      "$new" \
      "$bak"

    info \
      "Backed up $(label "$name") profile"
  fi

  info "Importing $(label "$name") profile"

  mkdir -p "$(dirname "$new")"

  if ! {
    rsync \
      -a \
      "${CACHE_EXCLUDES[@]}" \
      "$old/" \
      "$new.partial/" &&

    printf \
      'from=%s\ndate=%s\n' \
      "$old" \
      "$(date -Is)" \
      > "$new.partial/$MARKER" &&

    mv \
      "$new.partial" \
      "$new"
  }; then

    rm -rf "$new.partial"

    warn \
      "$(label "$name") profile import failed"

    return 1
  fi

  root=$(app_root "$old")

  [ -z "$root" ] ||
    carry_tool_configs "$root"

  ok "$(label "$name") profile ready"
}


