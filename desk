import hashlib
import io
import json
import os
from pathlib import Path
import platform
import re
import shutil
import subprocess
import sys
import tempfile
from urllib.parse import urlparse
import zipfile


def portable_ffmpeg(tool):
    existing = shutil.which('ffmpeg')
    target = tool.parent / 'ffmpeg'
    if existing:
        return existing
    if target.is_file() and os.access(target, os.X_OK):
        return str(target)
    arch = {'x86_64': 'x86_64', 'aarch64': 'aarch64'}.get(platform.machine())
    if platform.system() != 'Linux' or not arch:
        raise RuntimeError('This quality needs ffmpeg. Automatic setup supports Linux x86-64 and ARM64.')
    print('Preparing video downloads (first run)…', flush=True)
    with tempfile.TemporaryDirectory(dir=tool.parent) as directory:
        root = Path(directory)
        def fetch(url, destination):
            subprocess.run(['curl', '-fsSL', '--proto', '=https', '--tlsv1.2',
                            '--connect-timeout', '15', url, '-o', str(destination)], check=True)
        fetch('https://pypi.org/pypi/imageio-ffmpeg/json', root / 'release.json')
        release = json.loads((root / 'release.json').read_text())
        wheels = [asset for asset in release['urls']
                  if asset['filename'].endswith('py3-none-manylinux2014_' + arch + '.whl')
                  and not asset.get('yanked')]
        if len(wheels) != 1:
            raise RuntimeError('No compatible portable ffmpeg package is available.')
        asset = wheels[0]
        if urlparse(asset['url']).scheme != 'https' or urlparse(asset['url']).hostname != 'files.pythonhosted.org':
            raise RuntimeError('Unexpected ffmpeg download destination.')
        fetch(asset['url'], root / 'ffmpeg.whl')
        wheel = (root / 'ffmpeg.whl').read_bytes()
        if hashlib.sha256(wheel).hexdigest() != asset['digests']['sha256']:
            raise RuntimeError('ffmpeg checksum verification failed.')
        with zipfile.ZipFile(io.BytesIO(wheel)) as archive:
            binaries = [name for name in archive.namelist()
                        if re.fullmatch(r'imageio_ffmpeg/binaries/ffmpeg-linux-[^/]+', name)]
            if len(binaries) != 1:
                raise RuntimeError('Portable ffmpeg package has no supported executable.')
            executable = root / 'ffmpeg'
            executable.write_bytes(archive.read(binaries[0]))
        executable.chmod(0o755)
        subprocess.run([str(executable), '-version'], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        # Retain the wheel, including the bundled licence, beside the executable.
        os.replace(root / 'ffmpeg.whl', tool.parent / 'ffmpeg.whl')
        os.replace(executable, target)
    return str(target)


def main():
    tool, cache, output, url, requested = sys.argv[1:]
    tool = Path(tool)
    requested = requested.strip().lower()
    base = [sys.executable, str(tool), '--ignore-config', '--no-playlist', '--cache-dir', cache]
    print('Checking available qualities…', flush=True)
    result = subprocess.run(base + ['--quiet', '--dump-single-json', '--', url], capture_output=True, text=True)
    log = Path(cache) / 'last-check.log'
    log.write_text(result.stderr)
    if result.returncode:
        print(f'Could not read this video. Check the URL and your connection. Details: {log}', file=sys.stderr)
        return result.returncode
    metadata = json.loads(result.stdout)
    formats = [item for item in metadata.get('formats', [])
               if item.get('vcodec') not in (None, 'none') and item.get('height') and not item.get('has_drm')]
    heights = sorted({int(item['height']) for item in formats})
    if not heights:
        raise RuntimeError('No downloadable video qualities are available for this video.')
    default = max((height for height in heights if height <= 720), default=min(heights))
    if not requested:
        print('\n' + str(metadata.get('title') or 'Choose video quality'))
        for index, height in enumerate(heights, 1):
            print(f'  {index}) {height}p' + (' (recommended)' if height == default else ''))
        print('  q) Cancel\n')
        if not sys.stdin.isatty():
            print('Choose a quality with: desk yt URL 720p', file=sys.stderr)
            return 2
    while True:
        answer = requested or input(f'Choose quality [{default}p]: ').strip().lower()
        if answer in ('q', 'quit'):
            return 0
        if answer == 'best':
            height = max(heights)
        elif not answer:
            height = default
        elif re.fullmatch(r'[0-9]+p?', answer):
            number = int(answer.removesuffix('p'))
            height = number if number in heights or answer.endswith('p') else (heights[number - 1] if 1 <= number <= len(heights) else number)
        else:
            height = None
        if height in heights:
            break
        print('Choose an available quality: ' + ', '.join(f'{value}p' for value in heights), file=sys.stderr)
        if requested:
            return 2
    # Prefer a complete video at the chosen resolution; otherwise merge the
    # best video and audio automatically. Never silently drop the resolution.
    # MP4 conversion also needs ffmpeg for single-file WebM downloads.
    ffmpeg = ['--ffmpeg-location', portable_ffmpeg(tool)]
    print(f'\nDownloading {height}p with audio as MP4…\nSaving to {output}\nConversion may take a while for large videos.', flush=True)
    command = base + ['--quiet', '--progress', '--no-warnings', '--paths', output,
                      '--windows-filenames', '--output', f'%(title).180B [%(id)s] [{height}p].%(ext)s',
                      '--format', f'b[height={height}]/bv[height={height}]+ba',
                      # Merge into a codec-neutral intermediate, then convert non-MP4 files
                      # to H.264/AAC. Already-MP4 downloads are kept as they are.
                      '--merge-output-format', 'mkv', '--recode-video', 'mp4',
                      '--postprocessor-args',
                      'VideoConvertor+ffmpeg_o:-c:v libx264 -preset fast -crf 18 -c:a aac -b:a 192k -movflags +faststart'] + ffmpeg + ['--', url]
    result = subprocess.run(command)
    if result.returncode == 0:
        print(f'\nDone! MP4 video saved to {output}', flush=True)
    return result.returncode


try:
    sys.exit(main())
except (KeyboardInterrupt, EOFError):
    print('\nCancelled.', file=sys.stderr)
    sys.exit(130)
except (OSError, ValueError, KeyError, RuntimeError, subprocess.CalledProcessError, zipfile.BadZipFile) as error:
    print(f'Video download failed: {error}', file=sys.stderr)
    sys.exit(1)
VIDEO_DOWNLOAD
)

