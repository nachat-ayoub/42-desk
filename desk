  python3 - "$ANDROID_BASE" "${UPDATE_ONLY:-0}" <<'ANDROID_INSTALLER'
import hashlib
import json
import os
from pathlib import Path
import shutil
import stat
import subprocess
import sys
import tempfile
import urllib.parse
import xml.etree.ElementTree as ET
import zipfile

base = Path(sys.argv[1]).resolve()
update = sys.argv[2] == '1'
repo = 'https://dl.google.com/android/repository/'
sdk = base / 'sdk'
downloads = base / 'downloads'
image_repo = repo + 'sys-img/google_apis_playstore/'
image_path = 'system-images;android-30;google_apis_playstore;x86_64'
image_dir = Path('system-images/android-30/google_apis_playstore/x86_64')
name = 'Android_11_Play_Pixel9'


def fetch(url, target):
    if urllib.parse.urlparse(url).scheme != 'https':
        raise RuntimeError('download URL must use HTTPS')
    part = target.with_name(target.name + '.part')
    print('Downloading ' + url, flush=True)
    try:
        subprocess.run(['curl', '-fL', '--retry', '2', '--connect-timeout', '15',
                        '--speed-limit', '1024', '--speed-time', '60', url, '-o', str(part)], check=True)
        part.replace(target)
    finally:
        part.unlink(missing_ok=True)


def metadata(url, filename):
    target = downloads / filename
    fetch(url, target)
    root = ET.parse(target).getroot()
    for element in root.iter():
        element.tag = element.tag.rsplit('}', 1)[-1]
    return root


def choose(root, path):
    choices = []
    for package in root.findall('remotePackage'):
        channel = package.find('channelRef')
        if package.get('path') != path or package.find('revision/preview') is not None:
            continue
        if channel is not None and channel.get('ref') != 'channel-0':
            continue
        revision = tuple(int(package.findtext('revision/' + key, '0')) for key in ('major', 'minor', 'micro'))
        for archive in package.findall('archives/archive'):
            if archive.findtext('host-os', 'linux') != 'linux':
                continue
            if archive.findtext('host-arch', 'x86_64') not in ('x86_64', 'x64'):
                continue
            complete = archive.find('complete')
            if complete is not None:
                choices.append((revision, package, complete))
    if not choices:
        raise RuntimeError('official repository does not offer ' + path)
    return max(choices, key=lambda item: item[0])


def complete_install(destination, required):
    return all((destination / entry).is_file() for entry in required)


def install(root, path, repo_url, destination, required):
    marker = destination / '.goinfre-package.json'
    revision, package, archive = choose(root, path)
    if marker.is_file() and complete_install(destination, required):
        previous = json.loads(marker.read_text())
        if previous.get('package') == path and tuple(previous['revision']) >= revision:
            print('Already current: ' + path, flush=True)
            return
    elif destination.exists():
        raise RuntimeError('unrecognized or incomplete existing package at ' + str(destination) + '; inspect it before retrying')
    if shutil.disk_usage(base).free < 12 * 1024**3:
        raise RuntimeError('keep at least 12 GB free in goinfre for Android downloads and extraction')
    url = urllib.parse.urljoin(repo_url, archive.findtext('url'))
    if urllib.parse.urlparse(url).hostname != 'dl.google.com':
        raise RuntimeError('unexpected archive host')
    target = downloads / Path(urllib.parse.urlparse(url).path).name
    size = int(archive.findtext('size'))
    checksum = archive.find('checksum')
    expected = checksum.text.strip().lower()
    algorithm = checksum.get('type') or {40: 'sha1', 64: 'sha256'}.get(len(expected))
    if algorithm not in ('sha1', 'sha256', 'sha512'):
        raise RuntimeError('unsupported repository checksum')

    def verified():
        if not target.is_file() or target.stat().st_size != size:
            return False
        digest = hashlib.new(algorithm)
        with target.open('rb') as stream:
            for chunk in iter(lambda: stream.read(1024 * 1024), b''):
                digest.update(chunk)
        return digest.hexdigest() == expected

    if not verified():
        fetch(url, target)
    if not verified():
        target.unlink(missing_ok=True)
        raise RuntimeError('archive checksum mismatch: ' + path)
    with tempfile.TemporaryDirectory(prefix='extract-', dir=base / 'tmp') as temporary:
        stage = Path(temporary)
        print('Extracting ' + path, flush=True)
        with zipfile.ZipFile(target) as source:
            for member in source.infolist():
                output = (stage / member.filename).resolve()
                mode = member.external_attr >> 16
                if not output.is_relative_to(stage) or stat.S_ISLNK(mode):
                    raise RuntimeError('unsafe ZIP entry: ' + member.filename)
                source.extract(member, stage)
                if output.is_file() and mode & 0o777:
                    output.chmod(mode & 0o777)
        entries = list(stage.iterdir())
        if len(entries) != 1 or not entries[0].is_dir():
            raise RuntimeError('unexpected archive layout')
        content = entries[0]
        if not complete_install(content, required):
            raise RuntimeError('archive is missing required files: ' + path)
        if path in ('emulator', 'platform-tools'):
            executable = content / ('emulator' if path == 'emulator' else 'adb')
            executable.chmod(executable.stat().st_mode | 0o755)
        (content / '.goinfre-package.json').write_text(json.dumps({
            'package': path, 'revision': revision, 'url': url}, indent=2))
        license_ref = package.find('uses-license')
        if license_ref is not None:
            for license_element in root.findall('license'):
                if license_element.get('id') == license_ref.get('ref'):
                    (content / 'LICENSE.repository.txt').write_text(license_element.text or '')
        destination.parent.mkdir(parents=True, exist_ok=True)
        backup = stage / 'previous-installation'
        if destination.exists():
            destination.rename(backup)
        try:
            content.rename(destination)
        except OSError:
            if backup.exists():
                backup.rename(destination)
            raise
    target.unlink()


def main():
    packages = [('emulator', ('emulator',)), ('platform-tools', ('adb',))]
    needed = [(path, required) for path, required in packages
              if update or not complete_install(sdk / path, required)]
    if needed:
        tools = metadata(repo + 'repository2-1.xml', 'repository.xml')
        for path, required in needed:
            install(tools, path, repo, sdk / path, required)
    required_image = ('system.img', 'userdata.img', 'ramdisk.img', 'kernel-ranchu')
    if update or not complete_install(sdk / image_dir, required_image):
        images = metadata(image_repo + 'sys-img2-1.xml', 'images-google_apis_playstore.xml')
        install(images, image_path, image_repo, sdk / image_dir, required_image)
    device = base / 'avd' / (name + '.avd')
    device.mkdir(parents=True, exist_ok=True)
    config = device / 'config.ini'
    if not config.exists():
        values = {
            'AvdId': name, 'avd.ini.displayname': 'Android 11 Google Play - Pixel 9 display',
            'avd.ini.encoding': 'UTF-8', 'abi.type': 'x86_64',
            'image.sysdir.1': str(image_dir) + '/', 'tag.id': 'google_apis_playstore',
            'tag.display': 'Google Play', 'target': 'android-30', 'PlayStore.enabled': 'true',
            'hw.cpu.arch': 'x86_64', 'hw.cpu.ncore': 2, 'hw.ramSize': 2048, 'vm.heapSize': 256,
            'hw.lcd.width': 1080, 'hw.lcd.height': 2424, 'hw.lcd.density': 420,
            'hw.gpu.enabled': 'yes', 'hw.gpu.mode': 'auto', 'hw.keyboard': 'yes', 'hw.mainKeys': 'no',
            'hw.audioInput': 'no', 'hw.camera.back': 'none', 'hw.camera.front': 'none',
            'hw.sdCard': 'no', 'disk.dataPartition.size': '6G', 'disk.cachePartition.size': '64M',
            'showDeviceFrame': 'no', 'skin.dynamic': 'yes', 'skin.name': '1080x2424',
            'skin.path': '_no_skin', 'fastboot.forceColdBoot': 'yes', 'fastboot.forceFastBoot': 'no',
        }
        config.write_text(''.join(f'{key}={value}\n' for key, value in values.items()))
    (base / 'avd' / (name + '.ini')).write_text(
        f'avd.ini.encoding=UTF-8\npath={device}\ntarget=android-30\n')
    (base / '.installed-version').write_text('11 (API 30, Google Play)\n')
    print('Android 11 Google Play ready. Open with: desk android', flush=True)


try:
    main()
except (OSError, ValueError, RuntimeError, ET.ParseError, zipfile.BadZipFile, subprocess.CalledProcessError) as error:
    sys.exit(f'Android setup failed: {error}. Retry with desk install android.')
ANDROID_INSTALLER
)


launch_android_unlocked() (
  if ! android_ready; then
    if [ "${PREPARE_ON_LAUNCH:-1}" != 1 ]; then
      fail "Android is not installed. Use 'desk install android'."
      return 1
    fi
    prepare_android_unlocked || return 1
  fi
  android_environment || return 1
  if ! "$ANDROID_HOME/emulator/emulator" -accel-check > "$ANDROID_BASE/logs/acceleration-desk.log" 2>&1; then
    cat "$ANDROID_BASE/logs/acceleration-desk.log" >&2
    fail 'Android needs KVM hardware acceleration. Ask school IT for access to /dev/kvm.'
    return 1
  fi
  if "$ANDROID_HOME/platform-tools/adb" -P 5038 -s emulator-5584 get-state >/dev/null 2>&1; then
    info 'Android 11 Google Play is already running.'
    return 0
  fi
  info "Opening Android 11 Google Play (log: $(pretty "$ANDROID_BASE/logs/launch-desk.log"))"
  start_detached_process "$BIN_DIR/desk" _android-run "$@" \
    </dev/null > "$ANDROID_BASE/logs/launch-desk.log" 2>&1 &
)


run_android() (
  android_ready || { fail "Run 'desk install android' first."; return 1; }
  android_environment || return 1
  local adb="$ANDROID_HOME/platform-tools/adb"
  (
    for ((attempt=0; attempt<120; attempt++)); do
      booted=$("$adb" -P 5038 -s emulator-5584 shell getprop sys.boot_completed 2>/dev/null | tr -d '\r') || true
      if [ "$booted" = 1 ]; then
        for setting in window_animation_scale transition_animation_scale animator_duration_scale; do
          "$adb" -P 5038 -s emulator-5584 shell settings put global "$setting" 0
        done
        exit 0
      fi
      sleep 2
    done
  ) > "$ANDROID_BASE/logs/boot-settings-desk.log" 2>&1 &
  local settings_pid=$!
  trap 'kill "$settings_pid" 2>/dev/null || true' EXIT
  "$ANDROID_HOME/emulator/emulator" -avd Android_11_Play_Pixel9 \
    -port 5584 -accel on -cores 2 -memory 2048 \
    -gpu "${DESK_ANDROID_GPU:-${ANDROID_LIGHT_GPU:-auto}}" -feature -Vulkan \
    -no-snapshot -no-boot-anim -no-audio -no-metrics \
    -camera-back none -camera-front none -netspeed full -netdelay none "$@"
)


