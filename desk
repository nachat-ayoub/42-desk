import tempfile
from urllib.parse import quote, unquote, urlparse

base, app, update = Path(sys.argv[1]).resolve(), sys.argv[2], sys.argv[3] == '1'
repo = {'codex-desktop': 'cuongducle/codex-linux',
        'claude-desktop': 'aaddrick/claude-desktop-debian',
        'openmausbot': 'milind-soni/OpenMausBot'}[app]
root_url = 'https://github.com/' + repo
current = base / 'current'
marker = base / '.desk-release.json'


def fetch(url, destination):
    part = destination.with_name(destination.name + '.part')
    try:
        subprocess.run(['curl', '-fL', '--retry', '2', '--connect-timeout', '15',
                        '--speed-limit', '1024', '--speed-time', '60', url, '-o', str(part)], check=True)
        part.replace(destination)
    finally:
        part.unlink(missing_ok=True)


class Assets(HTMLParser):
    def __init__(self):
        super().__init__()
        self.assets, self.row = [], None

    def handle_starttag(self, tag, attributes):
        values = dict(attributes)
        if tag == 'li':
            self.row = {}
        elif self.row is not None:
            if tag == 'a' and '/releases/download/' in values.get('href', ''):
                self.row['url'] = values['href']
            if tag == 'clipboard-copy' and re.fullmatch(r'sha256:[a-fA-F0-9]{64}', values.get('value', '')):
                self.row['sha256'] = values['value'][7:].lower()

    def handle_endtag(self, tag):
        if tag == 'li' and self.row is not None:
            if 'url' in self.row and 'sha256' in self.row:
                self.assets.append(self.row)
            self.row = None


def main():
    (base / 'downloads').mkdir(parents=True, exist_ok=True)
    (base / 'releases').mkdir(exist_ok=True)
    previous = json.loads(marker.read_text()) if marker.exists() else {}
    if current.exists() and (not marker.exists() or previous.get('repo') != repo or not current.is_symlink()):
        raise RuntimeError('unrecognized existing desktop installation; inspect ' + str(current))
    latest = base / 'downloads/latest.html'
    try:
        fetch(root_url + '/releases/latest', latest)
    except subprocess.CalledProcessError:
        if os.access(current / 'AppRun', os.X_OK):
            print('Release server unavailable; keeping the installed desktop app.', file=sys.stderr)
            return
        raise
    match = re.search(r'/releases/expanded_assets/([^"<>\s]+)', latest.read_text())
    if not match:
        raise RuntimeError('release page has no supported asset listing')
    tag = unquote(match[1])
    if not re.fullmatch(r'v?[0-9][A-Za-z0-9.+_-]*', tag):
        raise RuntimeError('unexpected release tag')
    if previous.get('tag') == tag and os.access(current / 'AppRun', os.X_OK):
        print(app + ' ' + tag + ' is already current.', flush=True)
        return
    numbers = lambda value: tuple(map(int, re.findall(r'[0-9]+', value)))
    if update and previous.get('tag') and numbers(previous['tag']) > numbers(tag):
        print('Keeping newer installed ' + app + ' ' + previous['tag'], flush=True)
        return
    listing = base / 'downloads/assets.html'
    fetch(root_url + '/releases/expanded_assets/' + quote(tag, safe=''), listing)
    parser = Assets()
    parser.feed(listing.read_text())
    machine = platform.machine()
    arch = {'x86_64': ('amd64' if app == 'claude-desktop' else 'x86_64'),
            'aarch64': 'arm64'}.get(machine)
    if not arch:
        raise RuntimeError('unsupported Linux architecture: ' + machine)
    if app == 'openmausbot' and machine != 'x86_64':
        raise RuntimeError('OpenMausBot currently publishes Linux packages for x86_64 only')
    patterns = {
        'codex-desktop': r'codex-desktop-linux-' + re.escape(arch) + r'\.AppImage',
        'claude-desktop': r'claude-desktop-unofficial-[0-9][A-Za-z0-9.+_-]*-' + re.escape(arch) + r'\.AppImage',
        'openmausbot': r'OpenMausBot-' + re.escape(tag.lstrip('v')) + r'-x86_64\.AppImage',
    }
    pattern = patterns[app]
    choices = [asset for asset in parser.assets
               if re.fullmatch(pattern, unquote(Path(urlparse(asset['url']).path).name))]
    if len(choices) != 1:
        raise RuntimeError('release has no unique matching AppImage with a GitHub SHA-256 digest')
    asset = choices[0]
    url = 'https://github.com' + asset['url'] if asset['url'].startswith('/') else asset['url']
    expected_prefix = root_url + '/releases/download/' + quote(tag, safe='') + '/'
    if not url.startswith(expected_prefix) or urlparse(url).hostname != 'github.com':
        raise RuntimeError('unexpected AppImage download URL')
    if shutil.disk_usage(base).free < 3 * 1024**3:
        raise RuntimeError('keep at least 3 GB free in goinfre for desktop downloads and extraction')
    archive = base / 'downloads/application.AppImage'
    print('Downloading ' + app + ' ' + tag + ' from ' + repo, flush=True)
    fetch(url, archive)
    digest = hashlib.sha256()
    with archive.open('rb') as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b''):
            digest.update(chunk)
    if digest.hexdigest() != asset['sha256']:
        archive.unlink(missing_ok=True)
        raise RuntimeError('AppImage checksum mismatch; existing installation kept')
    archive.chmod(0o755)
    # Extract once so launching needs neither FUSE nor repeated unpacking.
    release = base / 'releases' / tag
    receipt = {'repo': repo, 'tag': tag, 'sha256': asset['sha256']}
    if release.exists():
        if not (release / '.desk-package.json').is_file() or json.loads((release / '.desk-package.json').read_text()) != receipt:
            raise RuntimeError('unrecognized existing release directory: ' + str(release))
    else:
        with tempfile.TemporaryDirectory(prefix='extract-', dir=base / 'releases') as directory:
            stage = Path(directory)
            subprocess.run([str(archive), '--appimage-extract'], cwd=stage, check=True,
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=180)
            content = stage / 'squashfs-root'
            if not os.access(content / 'AppRun', os.X_OK):
                raise RuntimeError('AppImage is missing its executable AppRun')
            if app == 'openmausbot' and (not os.access(content / 'openmausbot', os.X_OK) or
                                         not (content / 'resources/app.asar').is_file()):
                raise RuntimeError('OpenMausBot AppImage is missing its native app or resources')
            if app == 'claude-desktop':
                # This is an extracted directory, not a FUSE mount. The
                # community launcher's AppImage mode disables the sandbox
                # unconditionally; use its native-package mode instead.
                launcher = content / 'AppRun'
                text = launcher.read_text()
                expected = "build_electron_args 'appimage'"
                if text.count(expected) != 1:
                    raise RuntimeError('unsupported Claude desktop launcher layout')
                launcher.write_text(text.replace(expected, "build_electron_args 'deb'"))
            (content / '.desk-package.json').write_text(json.dumps(receipt))
            content.rename(release)
    link = base / 'current.new'
    link.unlink(missing_ok=True)
    link.symlink_to(release.relative_to(base))
    link.replace(current)
    marker.write_text(json.dumps(receipt))
    (base / '.installed-version').write_text(tag + '\n')
    archive.unlink(missing_ok=True)
    print(app + ' ' + tag + ' installed. Nothing opened automatically.', flush=True)


try:
    main()
except (OSError, ValueError, KeyError, RuntimeError, subprocess.SubprocessError) as error:
    sys.exit('Desktop setup failed: ' + str(error))
AI_DESKTOP_INSTALLER
)


# Move persistent Codex data once; links keep existing CLI/desktop paths working.
prepare_codex_desktop_storage() {
  python3 - "$CONF_DIR" "$DATA_DIR" "$HOME/.codex" "${CODEX_HOME:-}" "$GOINFRE/data/codex-desktop" <<'PY'
import os
from pathlib import Path
import shutil
import subprocess
import sys

config, data, default_home, override, root = sys.argv[1:]
root = Path(root).resolve()
pairs = [(Path(config) / name, root / 'config' / name) for name in ('Codex', 'codex')]
pairs += [(Path(data) / name, root / 'share' / name) for name in ('Codex', 'codex')]
if not override:
    pairs.append((Path(default_home), root / 'codex-home'))
try:
    # Refuse conflicts before moving any directories. Custom symlinks and an
    # explicit CODEX_HOME belong to the user and are left alone.
    pending = [(source, target) for source, target in pairs if not source.is_symlink()]
    for source, target in pending:
        if source.exists() and (not source.is_dir() or (target.exists() or target.is_symlink())):
            raise RuntimeError(f'Cannot migrate {source}: destination exists or source is not a directory. Move/merge it manually first.')
    if any(source.exists() for source, _ in pending):
        processes = subprocess.check_output(['ps', '-u', str(os.getuid()), '-o', 'comm='], text=True)
        if any(name.strip().lower().startswith('codex') for name in processes.splitlines()):
            raise RuntimeError('Close Codex CLI and Codex Desktop before migrating their data.')
    root.mkdir(parents=True, exist_ok=True, mode=0o700)
    root.chmod(0o700)
    for source, target in pending:
        source.parent.mkdir(parents=True, exist_ok=True)
        target.parent.mkdir(parents=True, exist_ok=True)
        if source.exists():
            shutil.move(str(source), str(target))
        else:
            target.mkdir(parents=True, exist_ok=True, mode=0o700)
        source.symlink_to(target, target_is_directory=True)
except (OSError, RuntimeError, subprocess.CalledProcessError) as error:
    sys.exit(f'Codex data migration failed: {error}')
PY
}


update_desk_unlocked() (
  [ "$#" = 0 ] || { fail 'Use: desk update self'; return 2; }
  local tmp latest
  tmp=$(mktemp -d "$GOINFRE/.desk-self-update.XXXXXX") || return 1
  trap 'rm -rf -- "$tmp"' EXIT
  curl -fsSL --proto '=https' --tlsv1.2 \
    https://raw.githubusercontent.com/nachat-ayoub/42-desk/main/desk -o "$tmp/desk" || return 1
  bash -n "$tmp/desk" || return 1
  latest=$(python3 - "$tmp/desk" <<'PY'
import re, sys
from pathlib import Path
match = re.search(r'^VERSION="([0-9]+\.[0-9]+\.[0-9]+)"$', Path(sys.argv[1]).read_text(), re.M)
if not match:
    sys.exit('Downloaded desk has no valid version')
print(match[1])
PY
  ) || return 1
  if ! version_is_newer "$latest" "$VERSION"; then
    ok "42-desk $VERSION is up to date"
    return 0
  fi
  mkdir -p "$BIN_DIR" || return 1
  # Stage on the destination filesystem so replacement is atomic.
  local staged
  staged=$(mktemp "$BIN_DIR/.desk-update.XXXXXX") || return 1
  if install -m 755 "$tmp/desk" "$staged" && mv -f -- "$staged" "$BIN_DIR/desk"; then
    ok "Updated 42-desk $VERSION → $latest ($BIN_DIR/desk)"
  else
    rm -f -- "$staged"
    return 1
  fi
)


install_ytdlp_unlocked() (
  local target="$APPS/yt-dlp/yt-dlp" tmp
  [ -x "$target" ] && return 0
  tmp=$(mktemp -d "$GOINFRE/.desk-ytdlp.XXXXXX") || return 1
  trap 'rm -rf -- "$tmp"' EXIT
  # Resolve a single release first so the artifact and checksum cannot race
  # across two different "latest" releases. GitHub TLS remains verified.
  curl -fsSL --proto '=https' --tlsv1.2 https://github.com/yt-dlp/yt-dlp/releases/latest -o "$tmp/latest.html" || return 1
  local tag
  tag=$(python3 - "$tmp/latest.html" <<'PY'
import re, sys
from pathlib import Path
match = re.search(r'/releases/expanded_assets/([0-9.]+)[\"<>\s]', Path(sys.argv[1]).read_text())
if not match:
    sys.exit('Release page has no supported yt-dlp release')
tag = match[1]
if not re.fullmatch(r'[0-9]{4}\.[0-9]{2}\.[0-9]{2}(?:\.[0-9]+)?', tag):
    sys.exit('Unexpected yt-dlp release tag')
print(tag)
PY
  ) || return 1
  local base="https://github.com/yt-dlp/yt-dlp/releases/download/$tag"
  curl -fsSL --proto '=https' --tlsv1.2 "$base/yt-dlp" -o "$tmp/yt-dlp" || return 1
  curl -fsSL --proto '=https' --tlsv1.2 "$base/SHA2-256SUMS" -o "$tmp/SHA2-256SUMS" || return 1
  python3 - "$tmp" <<'PY'
import hashlib, re, sys
from pathlib import Path
root = Path(sys.argv[1])
checksums = dict((name.lstrip('*'), digest) for digest, name in
                 (line.split(maxsplit=1) for line in (root / 'SHA2-256SUMS').read_text().splitlines() if line.strip()))
expected = checksums.get('yt-dlp', '')
if not re.fullmatch('[0-9a-fA-F]{64}', expected) or hashlib.sha256((root / 'yt-dlp').read_bytes()).hexdigest() != expected.lower():
    sys.exit('yt-dlp checksum verification failed')
PY
  [ "$?" = 0 ] || return 1
  python3 "$tmp/yt-dlp" --version >/dev/null || return 1
  mkdir -p "${target%/*}" || return 1
  install -m 755 "$tmp/yt-dlp" "$target"
)


