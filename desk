# CLI installation
# -------------------------------------------------------------------

install_self() {
  local target="$BIN_DIR/desk"

  mkdir -p "$BIN_DIR"

  if [ "$SELF" != "$(readlink -f "$target" 2>/dev/null || true)" ]; then

    if ! cmp \
      -s \
      "$SELF" \
      "$target" \
      2>/dev/null
    then

      install \
        -m 755 \
        "$SELF" \
        "$target"

      ok \
        "Installed $(pretty "$target")"
    fi

    SELF=$target
  fi
}


write_wrapper() {
  local f="$BIN_DIR/$1"
  local app=$2

  if [ -e "$f" ] &&
     ! grep \
       -Eqs '(desk|session-setup)' \
       "$f"
  then

    warn \
      "$(pretty "$f") exists and is not managed by desk; leaving it"

    return 0
  fi

  printf \
    '#!/bin/sh\nexec "%s" %s "$@"\n' \
    "$BIN_DIR/desk" \
    "$app" \
    > "$f"

  chmod +x "$f"
}


remove_block() {
  local file=$1
  local start=$2
  local end=$3

  local tmp

  [ -f "$file" ] ||
    return 0

  tmp=$(mktemp)

  awk \
    -v s="$start" \
    -v e="$end" \
    '
      $0 == s {
        skip=1
        next
      }

      $0 == e {
        skip=0
        next
      }

      !skip {
        print
      }
    ' \
    "$file" \
    > "$tmp"

  mv \
    "$tmp" \
    "$file"
}


write_shell_hook() {
  local rc
  local shell_name

  shell_name=$(basename "${SHELL:-zsh}")

  case "$shell_name" in
    zsh)
      rc="$HOME/.zshrc"
      ;;

    bash)
      rc="$HOME/.bashrc"
      ;;

    *)
      return 0
      ;;
  esac

  touch "$rc"

  remove_block \
    "$rc" \
    '# >>> desk >>>' \
    '# <<< desk <<<'

  sed \
    -i \
    '/^# Added by session-setup: personal commands (code, brave, session-setup)$/,+1d' \
    "$rc" \
    2>/dev/null ||
    true

  local program
  {
    printf '\n# >>> desk >>>\n'
    printf 'export PATH="$HOME/.local/bin:$PATH"\n\n'
    for program in "${PROGRAMS[@]}"; do
      printf 'unalias %s 2>/dev/null || true\n' "$program"
      if [ "$shell_name" = zsh ]; then
        printf 'unfunction %s 2>/dev/null || true\n' "$program"
      else
        printf 'unset -f %s 2>/dev/null || true\n' "$program"
      fi
    done
    printf '\ncommand desk _shell\n# <<< desk <<<\n'
  } >> "$rc"

}


write_launchers() {
  local icon_vscode
  local icon_brave

  local exec_path="$BIN_DIR/desk"

  # The bootstrap installer calls fix before the first choice. Install just
  # the shell hook then, so a Codex-only choice never gets desktop launchers.
  if [ ! -f "$PROGRAMS_FILE" ] && [ ! -f "$INITIALIZED" ]; then
    local -a PROGRAMS=()
    write_shell_hook
    return $?
  fi

  if selected code; then write_wrapper code code || return 1; fi
  if selected brave; then write_wrapper brave brave || return 1; fi
  if selected codex; then write_wrapper codex codex || return 1; fi
  if selected claude; then write_wrapper claude claude || return 1; fi
  if selected android; then write_wrapper android android || return 1; fi

  icon_vscode=$(app_root "$OLD_VSCODE")
  icon_brave=$(app_root "$OLD_BRAVE")

  if [[ $icon_vscode == "$HOME/.var/app/"* ]]; then
    icon_vscode=$(basename "$icon_vscode")
  else
    icon_vscode="$APPS/vscode/resources/app/resources/linux/code.png"
  fi

  if [[ $icon_brave == "$HOME/.var/app/"* ]]; then
    icon_brave=$(basename "$icon_brave")
  else
    icon_brave="$APPS/brave/product_logo_256.png"
  fi

  mkdir -p "$DATA_DIR/applications"

  if selected code; then
    cat > "$DATA_DIR/applications/code-native.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=VS Code
Comment=VS Code managed by 42-desk
Exec=$exec_path code %F
Icon=$icon_vscode
Categories=Development;IDE;
StartupWMClass=code
EOF
  fi

  if selected brave; then
    cat > "$DATA_DIR/applications/brave-native.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Brave (native)
Comment=Brave managed by 42-desk
Exec=$exec_path brave %U
Icon=$icon_brave
Categories=Network;WebBrowser;
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
StartupWMClass=$BRAVE_WM_CLASS
EOF
  fi

  if selected android; then
    cat > "$DATA_DIR/applications/android-desk.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Android 11 Google Play
Comment=Android 11 with Google Play and Pixel 9 display, managed by 42-desk
Exec="$exec_path" android
Icon=phone
Categories=Development;Emulator;
Terminal=false
EOF
  fi

  write_shell_hook
}


claim_default_browser() {
  local old_id
  local current

  old_id=$(app_root "$OLD_BRAVE")

  [[ $old_id == "$HOME/.var/app/"* ]] ||
    return 0

  old_id="$(basename "$old_id").desktop"

  current=$(
    xdg-settings \
      get default-web-browser \
      2>/dev/null ||
      true
  )

  [ "$current" = "$old_id" ] ||
    return 0

  xdg-settings \
    set \
    default-web-browser \
    brave-native.desktop \
    2>/dev/null &&

  info \
    "Brave (native) is now default" ||

  true
}


# -------------------------------------------------------------------
# Locks
# -------------------------------------------------------------------
#
# Do not use flock here. 42/1337 home directories can live on filesystems
# where flock behaviour is surprising across shells. Atomic mkdir locks work
# reliably for our use case and also let us detect/recover a dead owner.

lock_dir() {
  printf '%s/%s.lock' "$LOCK_DIR" "$1"
}


lock_try_acquire() {
  local name=$1
  local dir
  local owner=""

  dir=$(lock_dir "$name")

  if mkdir "$dir" 2>/dev/null; then
    printf '%s\n' "$$" > "$dir/pid"
    return 0
  fi

  # Recover a stale lock left behind by a killed/crashed desk process.
  if [ -r "$dir/pid" ]; then
    read -r owner < "$dir/pid" || owner=""

    if [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; then
      rm -rf "$dir"

      if mkdir "$dir" 2>/dev/null; then
        printf '%s\n' "$$" > "$dir/pid"
        return 0
      fi
    fi
  fi

  return 2
}


lock_release() {
  local name=$1
  local dir
  local owner=""

  dir=$(lock_dir "$name")

  [ -r "$dir/pid" ] || return 0
  read -r owner < "$dir/pid" || owner=""

  if [ "$owner" = "$$" ]; then
    rm -rf "$dir"
  fi
}


lock_wait_acquire() {
  local name=$1
  local deadline
  local now

  deadline=$(( $(date +%s) + LOCK_WAIT_SECONDS ))

  while true; do
    if lock_try_acquire "$name"; then
      return 0
    fi

    now=$(date +%s)

    if [ "$now" -ge "$deadline" ]; then
      fail "desk is busy ($name)"
      return 1
    fi

    sleep 0.1
  done
}


with_lock_wait() {
  local lock=$1
  shift

  local rc

  lock_wait_acquire "$lock" || return 1

  if "$@"; then
    rc=0
  else
    rc=$?
  fi

  lock_release "$lock"
  return "$rc"
}


with_lock_try() {
  local lock=$1
  shift

  local rc

  lock_try_acquire "$lock" || return 2

  if "$@"; then
    rc=0
  else
    rc=$?
  fi

  lock_release "$lock"
  return "$rc"
}


