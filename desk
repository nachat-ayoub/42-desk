# CLI installation
# -------------------------------------------------------------------

install_self() {
  local target="$BIN_DIR/desk"

  mkdir -p "$BIN_DIR"

  if [ "$SELF" != "$(readlink -f "$target" 2>/dev/null || true)" ]; then

    if ! cmp \
      -s \
      "$SELF" \
      "$target" \
      2>/dev/null
    then

      install \
        -m 755 \
        "$SELF" \
        "$target"

      ok \
        "Installed $(pretty "$target")"
    fi

    SELF=$target
  fi
}


write_wrapper() {
  local f="$BIN_DIR/$1"
  local app=$2

  if [ -e "$f" ] &&
     ! grep \
       -Eqs '(desk|session-setup)' \
       "$f"
  then

    warn \
      "$(pretty "$f") exists and is not managed by desk; leaving it"

    return 0
  fi

  printf \
    '#!/bin/sh\nexec "%s" %s "$@"\n' \
    "$BIN_DIR/desk" \
    "$app" \
    > "$f"

  chmod +x "$f"
}


remove_block() {
  local file=$1
  local start=$2
  local end=$3

  local tmp

  [ -f "$file" ] ||
    return 0

  tmp=$(mktemp)

  awk \
    -v s="$start" \
    -v e="$end" \
    '
      $0 == s {
        skip=1
        next
      }

      $0 == e {
        skip=0
        next
      }

      !skip {
        print
      }
    ' \
    "$file" \
    > "$tmp"

  mv \
    "$tmp" \
    "$file"
}


write_shell_hook() {
  local rc
  local shell_name

  shell_name=$(basename "${SHELL:-zsh}")

  case "$shell_name" in
    zsh)
      rc="$HOME/.zshrc"
      ;;

    bash)
      rc="$HOME/.bashrc"
      ;;

    *)
      return 0
      ;;
  esac

  touch "$rc"

  remove_block \
    "$rc" \
    '# >>> desk >>>' \
    '# <<< desk <<<'

  sed \
    -i \
    '/^# Added by session-setup: personal commands (code, brave, session-setup)$/,+1d' \
    "$rc" \
    2>/dev/null ||
    true

  local program
  {
    printf '\n# >>> desk >>>\n'
    printf 'export PATH="$HOME/.local/bin:$PATH"\n\n'
    if selected flutter; then
      printf 'export FLUTTER_ROOT=%q\n' "$APPS/flutter/sdk"
      if [ -x "$APPS/flutter/tools/jdk/bin/java" ]; then
        printf 'if [ -z "${JAVA_HOME:-}" ]; then export JAVA_HOME=%q; fi\n' "$APPS/flutter/tools/jdk"
      fi
      if [ -x "$APPS/android/sdk/platform-tools/adb" ] || [ -x "$APPS/android/sdk/cmdline-tools/latest/bin/sdkmanager" ]; then
        printf 'if [ -z "${ANDROID_HOME:-${ANDROID_SDK_ROOT:-}}" ]; then\n'
        printf '  export ANDROID_HOME=%q ANDROID_SDK_ROOT=%q\n' "$APPS/android/sdk" "$APPS/android/sdk"
        printf 'fi\n'
      fi
      printf 'if [ -z "${ANDROID_HOME:-}" ] && [ -n "${ANDROID_SDK_ROOT:-}" ]; then export ANDROID_HOME="$ANDROID_SDK_ROOT"; fi\n'
      printf 'if [ -z "${ANDROID_SDK_ROOT:-}" ] && [ -n "${ANDROID_HOME:-}" ]; then export ANDROID_SDK_ROOT="$ANDROID_HOME"; fi\n'
      if [ -x "$APPS/android/sdk/platform-tools/adb" ] || [ -x "$APPS/android/sdk/cmdline-tools/latest/bin/sdkmanager" ]; then
        printf 'if [ "${ANDROID_HOME:-}" = %q ]; then\n' "$APPS/android/sdk"
        printf '  export ANDROID_USER_HOME=%q ANDROID_AVD_HOME=%q\n' "$APPS/android/state/.android" "$APPS/android/avd"
        printf '  export ANDROID_ADB_SERVER_PORT="${ANDROID_ADB_SERVER_PORT:-5038}" ADB_SERVER_PORT="${ADB_SERVER_PORT:-5038}"\n'
        printf '  export ADB_SERVER_SOCKET="${ADB_SERVER_SOCKET:-tcp:localhost:5038}"\n'
        printf 'fi\n'
      fi
      if [ -x "$APPS/brave/brave" ]; then
        printf 'if [ -z "${CHROME_EXECUTABLE:-}" ] && ! command -v google-chrome >/dev/null 2>&1; then export CHROME_EXECUTABLE=%q; fi\n' "$APPS/brave/brave"
      fi
      if [ -x "$APPS/flutter/tools/ninja/bin/ninja" ]; then
        printf 'export PATH=%q:"$PATH"\n' "$APPS/flutter/tools/ninja/bin"
      fi
      printf 'if [ -z "${PUB_CACHE:-}" ]; then export PUB_CACHE=%q; fi\n' "$APPS/flutter/cache/pub"
      printf 'if [ -z "${GRADLE_USER_HOME:-}" ]; then export GRADLE_USER_HOME=%q; fi\n' "$APPS/flutter/cache/gradle"
      printf 'unalias dart 2>/dev/null || true\n'
      if [ "$shell_name" = zsh ]; then
        printf 'unfunction dart 2>/dev/null || true\n'
      else
        printf 'unset -f dart 2>/dev/null || true\n'
      fi
    fi
    for program in "${PROGRAMS[@]}"; do
      printf 'unalias %s 2>/dev/null || true\n' "$program"
      if [ "$shell_name" = zsh ]; then
        printf 'unfunction %s 2>/dev/null || true\n' "$program"
      else
        printf 'unset -f %s 2>/dev/null || true\n' "$program"
      fi
    done
    printf '\ncommand desk _shell\n# <<< desk <<<\n'
  } >> "$rc"

}


write_launchers() {
  local icon_vscode
  local icon_brave

  local exec_path="$BIN_DIR/desk"

  # The bootstrap installer calls fix before the first choice. Install just
  # the shell hook then, so a Codex-only choice never gets desktop launchers.
  if [ ! -f "$PROGRAMS_FILE" ] && [ ! -f "$INITIALIZED" ]; then
    local -a PROGRAMS=()
    write_shell_hook
    return $?
  fi

  if selected code; then write_wrapper code code || return 1; fi
  if selected brave; then write_wrapper brave brave || return 1; fi
  if selected codex; then write_wrapper codex codex || return 1; fi
  if selected claude; then write_wrapper claude claude || return 1; fi
  if selected hermes; then write_wrapper hermes hermes || return 1; fi
  if selected hermes-desktop; then write_hermes_desktop_launcher || return 1; fi
  local desktop_app
  for desktop_app in codex-desktop claude-desktop openmausbot; do
    if selected "$desktop_app"; then write_ai_desktop_launcher "$desktop_app" || return 1; fi
  done
  if selected android; then write_wrapper android android || return 1; fi
  if selected flutter; then
    write_wrapper flutter flutter || return 1
    write_wrapper dart dart || return 1
  fi

