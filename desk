#!/usr/bin/env bash
set -euo pipefail

VERSION="2.0.0"
NAME="desk"
SELF=$(readlink -f "${BASH_SOURCE[0]}")

if [ -f /.flatpak-info ] && [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  if command -v host-spawn >/dev/null 2>&1; then
    exec host-spawn "$SELF" --from-flatpak "${FLATPAK_ID:-}" "$@"
  fi
  exec flatpak-spawn --host "$SELF" --from-flatpak "${FLATPAK_ID:-}" "$@"
fi

USER=${USER:-$(id -un)}

CONF_DIR=${XDG_CONFIG_HOME:-$HOME/.config}
DATA_DIR=${XDG_DATA_HOME:-$HOME/.local/share}

BIN_DIR="$HOME/.local/bin"
STATE_DIR="$CONF_DIR/desk"

STAMP="$STATE_DIR/auto-check"
LOG_FILE="$STATE_DIR/last-run.log"

AUTO_CHECK_SECONDS=$((12 * 60 * 60))

VSCODE_API="https://update.code.visualstudio.com/api/update/linux-x64/stable/latest"
BRAVE_VERSION_URL="https://versions.brave.com/latest/release-linux-x64.version"

BRAVE_CACHE_BYTES=524288000
BRAVE_WM_CLASS="brave-native"

NEW_VSCODE="$CONF_DIR/Code"
NEW_BRAVE="$CONF_DIR/BraveSoftware/Brave-Browser"

MARKER=".desk-import"
OLD_MARKER=".session-setup-import"

CACHE_EXCLUDES=(
  --exclude='Singleton*'
  --exclude='*.lock'
  --exclude='*.sock'
  --exclude='.org.chromium.*'

  --exclude='Cache'
  --exclude='CachedData'
  --exclude='CachedProfilesData'
  --exclude='CachedExtensionVSIXs'

  --exclude='Code Cache'
  --exclude='GPUCache'
  --exclude='GPUPersistentCache'
  --exclude='GrShaderCache'
  --exclude='GraphiteDawnCache'
  --exclude='ShaderCache'
  --exclude='DawnGraphiteCache'
  --exclude='DawnWebGPUCache'

  --exclude='CacheStorage'
  --exclude='sdk-cache'

  --exclude='Crash Reports'
  --exclude='Crashpad'
  --exclude='logs'

  --exclude='component_crx_cache'
  --exclude='extensions_crx_cache'

  --exclude="$MARKER"
  --exclude="$OLD_MARKER"
)

QUIET=0
FROM_FLATPAK=""
REIMPORT=""
CLOSE_OLD=0
FAILED=0


# --------------------------------------------------------------------
# UI
# --------------------------------------------------------------------

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  C_RESET='\033[0m'
  C_BOLD='\033[1m'
  C_DIM='\033[2m'

  C_CYAN='\033[1;36m'
  C_GREEN='\033[1;32m'
  C_YELLOW='\033[1;33m'
  C_RED='\033[1;31m'
else
  C_RESET=''
  C_BOLD=''
  C_DIM=''

  C_CYAN=''
  C_GREEN=''
  C_YELLOW=''
  C_RED=''
fi


info() {
  [ "$QUIET" = 1 ] ||
    printf '%b›%b %s\n' "$C_CYAN" "$C_RESET" "$*"
}


ok() {
  [ "$QUIET" = 1 ] ||
    printf '%b✓%b %s\n' "$C_GREEN" "$C_RESET" "$*"
}


warn() {
  printf '%b!%b %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2
}


fail() {
  printf '%b✗%b %s\n' "$C_RED" "$C_RESET" "$*" >&2
}


notify() {
  command -v notify-send >/dev/null 2>&1 &&
    notify-send "desk" "$*" 2>/dev/null ||
    true
}


pretty() {
  printf '%s' "${1/#$HOME/\~}"
}


json_get() {
  python3 -c '
import json, sys
print(json.load(sys.stdin)[sys.argv[1]])
' "$1"
}


label() {
  case "$1" in
    vscode) echo "VS Code" ;;
    brave)  echo "Brave" ;;
    *)      echo "$1" ;;
  esac
}


quit_hint() {
  case "$1" in
    vscode) echo "File > Exit" ;;
    brave)  echo "Ctrl+Shift+Q" ;;
  esac
}


usage() {
  printf '%bdesk%b %b%s%b\n' \
    "$C_BOLD" "$C_RESET" \
    "$C_DIM" "$VERSION" "$C_RESET"

  printf 'Fast 42/1337 workstation setup. No sudo.\n\n'

  printf '%bUsage%b\n' "$C_BOLD" "$C_RESET"

  printf '  desk                 ready workstation + open apps\n'
  printf '  desk c [ARGS]        open VS Code\n'
  printf '  desk b [ARGS]        open Brave\n'
  printf '  desk p               prepare/update only\n'
  printf '  desk s [c|b]         re-import profile data\n'
  printf '  desk x               close old apps\n'
  printf '  desk st              status\n'
  printf '  desk fix             repair CLI + shell hook\n\n'

  printf '%bDirect commands%b\n' "$C_BOLD" "$C_RESET"

  printf '  code .               VS Code anywhere\n'
  printf '  brave [URL]          Brave anywhere\n\n'

  printf '%bAliases%b  c=code  b=brave  p=prep  s=sync  x=close  st=status\n'
}


# --------------------------------------------------------------------
# Discovery
# --------------------------------------------------------------------

find_goinfre() {
  if [ -n "${GOINFRE:-}" ]; then
    echo "$GOINFRE"

  elif [ -d /goinfre ]; then
    echo "/goinfre/$USER"

  elif [ -d "$HOME/goinfre" ]; then
    readlink -f "$HOME/goinfre"

  else
    echo "$HOME/.local/opt"
  fi
}


newest() {
  find "$@" \
    -maxdepth 0 \
    -printf '%T@ %p\n' \
    2>/dev/null |
    sort -rn |
    head -n1 |
    cut -d' ' -f2- ||
    true
}


latest_bin() {
  [ -d "${1:-}" ] || return 0

  printf '%s\n' "$@" |
    sort -V |
    tail -n1
}


app_root() {
  local rest

  case "${1:-}" in

    "$HOME"/.var/app/*)
      rest=${1#"$HOME"/.var/app/}
      echo "$HOME/.var/app/${rest%%/*}"
      ;;

    "$HOME"/snap/*)
      rest=${1#"$HOME"/snap/}
      echo "$HOME/snap/${rest%%/*}/current"
      ;;

  esac
}


find_vscode_extensions() {
  local root

  root=$(app_root "${OLD_VSCODE:-}")

  if [ -n "$root" ] &&
     [ -d "$root/data/vscode/extensions" ]; then

    echo "$root/data/vscode/extensions"

  else
    echo "$HOME/.vscode/extensions"
  fi
}


find_node_bin() {
  local d
  local def
  local bin

  for d in \
    "${NVM_DIR:-}" \
    "$HOME/.nvm" \
    "$HOME"/.var/app/*/config/nvm
  do

    [ -n "$d" ] &&
    [ -d "$d/versions/node" ] ||
      continue

    def=$(cat "$d/alias/default" 2>/dev/null || true)

    bin=$(
      latest_bin \
        "$d/versions/node/v${def#v}"*/bin \
        || true
    )

    [ -n "$bin" ] ||
      bin=$(
        latest_bin \
          "$d"/versions/node/*/bin \
          || true
      )

    if [ -n "$bin" ]; then
      echo "$bin"
      return 0
    fi

  done
}


setup_runtime() {
  GOINFRE=$(find_goinfre)

  APPS="$GOINFRE/apps"

  OLD_VSCODE=$(
    newest \
      "$HOME"/.var/app/*/config/Code \
      "$HOME"/snap/code/current/.config/Code
  )

  OLD_BRAVE=$(
    newest \
      "$HOME"/.var/app/*/config/BraveSoftware/Brave-Browser \
      "$HOME"/snap/brave/current/.config/BraveSoftware/Brave-Browser
  )

  VSCODE_EXTENSIONS=$(find_vscode_extensions)

  mkdir -p "$STATE_DIR"

  if ! mkdir -p "$APPS" 2>/dev/null; then

    fail "Can't write to $GOINFRE"

    printf \
      'Set GOINFRE to a directory you own. Example:\n  GOINFRE=/goinfre/%s desk p\n' \
      "$USER" >&2

    exit 1
  fi

  chmod 700 "$GOINFRE" 2>/dev/null || true
}


# --------------------------------------------------------------------
# Old Flatpak / Snap processes
# --------------------------------------------------------------------

old_app_pids() {
  local root
  local roots

  root=$(app_root "$1")

  case "$root" in

    "$HOME"/.var/app/*)

      command -v flatpak >/dev/null 2>&1 ||
        return 0

      roots=$(
        flatpak ps \
          --columns=child-pid,application \
          2>/dev/null |
        awk \
          -v id="$(basename "$root")" \
          '$2 == id {printf "%s ", $1}'
      )

      [ -n "$roots" ] ||
        return 0

      ps -eo pid=,ppid=,args= |
      awk -v roots="$roots" '
        BEGIN {
          n = split(roots, r, " ")

          for (i = 1; i <= n; i++)
            root[r[i]] = 1
        }

        root[$2] &&
        $3 !~ /(^|\/)(bwrap|cat|gsettings)$/ &&
        $3 !~ /crashpad_handler/ &&
        $0 !~ /--type=/ {
          print $1
        }
      '
      ;;


    "$HOME"/snap/*)

      pgrep \
        -f "/snap/$(basename "$(dirname "$root")")/" \
        || true
      ;;

  esac
}


old_app_running() {
  [ -n "$(old_app_pids "$1")" ]
}


close_old_app() {
  local name=$1
  local old=$2

  local root
  local id=""
  local snap=""
  local p

  old_app_running "$old" ||
    return 0

  root=$(app_root "$old")

  case "$root" in

    "$HOME"/.var/app/*)
      id=$(basename "$root")
      ;;

    "$HOME"/snap/*)
      snap=$(basename "$(dirname "$root")")
      ;;

  esac

  if [ -n "$id" ] &&
     [ "$id" = "$FROM_FLATPAK" ]; then

    warn \
      "Run desk from a regular terminal; this Flatpak terminal would close itself."

    return 1
  fi

  info "Closing old $(label "$name")"

  for p in $(old_app_pids "$old"); do
    kill -TERM "$p" 2>/dev/null || true
  done

  for _ in $(seq 1 15); do

    old_app_running "$old" ||
      break

    sleep 1

  done

  if [ -n "$id" ]; then

    flatpak kill "$id" \
      2>/dev/null ||
      true

  elif old_app_running "$old"; then

    pkill \
      -KILL \
      -f "/snap/$snap/" \
      2>/dev/null ||
      true

  fi

  sleep 1

  if old_app_running "$old"; then
    warn "Couldn't close old $(label "$name")"
    return 1
  fi
}


offer_close_old() {
  local name=$1
  local old=$2
  local answer

  if [ "$CLOSE_OLD" != 1 ]; then

    if [ "$QUIET" = 1 ] ||
       [ ! -t 0 ]; then
      return 1
    fi

    read \
      -r \
      -p "Old $(label "$name") is still running. Close it? [Y/n] " \
      answer ||
      return 1

    case "$answer" in
      ""|[Yy]*) ;;
      *) return 1 ;;
    esac

  fi

  close_old_app "$name" "$old"
}


# --------------------------------------------------------------------
# Application installation
# --------------------------------------------------------------------

ensure_app() {
  local name=$1
  local latest=$2
  local url=$3
  local sha=$4
  local subdir=$5

  local dest="$APPS/$1"

  local have
  local tmp

  have=$(
    cat "$dest/.installed-version" \
      2>/dev/null ||
      true
  )

  if [ -z "$latest" ]; then

    if [ -n "$have" ]; then
      warn \
        "$(label "$name"): update server unavailable; keeping $have"

      return 0
    fi

    warn \
      "$(label "$name"): download server unavailable"

    return 1
  fi


  if [ "$have" = "$latest" ]; then
    ok "$(label "$name") $have"
    return 0
  fi


  if [ -n "$have" ] &&
     pgrep -f "$dest/" >/dev/null 2>&1; then

    warn \
      "$(label "$name") $latest available; close it and run 'desk p'"

    return 0
  fi


  info \
    "Installing $(label "$name") $latest"


  tmp=$(
    mktemp \
      -d "$GOINFRE/.desk-download.XXXXXX"
  )


  if ! {

    curl \
      -fL \
      --progress-bar \
      -o "$tmp/archive" \
      "$url" &&

    echo "$sha  $tmp/archive" |
      sha256sum \
        -c \
        --quiet \
        - &&

    mkdir "$tmp/x" &&

    case "$url" in

      *.zip)
        unzip \
          -q \
          "$tmp/archive" \
          -d "$tmp/x"
        ;;

      *)
        tar \
          -xzf "$tmp/archive" \
          -C "$tmp/x"
        ;;

    esac

  }; then

    rm -rf "$tmp"

    warn \
      "$(label "$name"): download/checksum failed"

    return 1
  fi


  if [ ! -d "$tmp/x/$subdir" ]; then

    rm -rf "$tmp"

    warn \
      "$(label "$name"): archive layout changed"

    return 1
  fi


  echo "$latest" \
    > "$tmp/x/$subdir/.installed-version"


  rm -rf "$dest"

  mv \
    "$tmp/x/$subdir" \
    "$dest"

  rm -rf "$tmp"

  ok "$(label "$name") installed"
}


install_vscode() {
  local meta
  local latest=""
  local url=""
  local sha=""

  if meta=$(
    curl \
      -fsSL \
      --max-time 15 \
      "$VSCODE_API"
  ); then

    latest=$(
      json_get productVersion <<<"$meta"
    )

    url=$(
      json_get url <<<"$meta"
    )

    sha=$(
      json_get sha256hash <<<"$meta"
    )

  fi

  ensure_app \
    vscode \
    "$latest" \
    "$url" \
    "$sha" \
    VSCode-linux-x64
}


install_brave() {
  local latest=""
  local url=""
  local sha=""

  if latest=$(
    curl \
      -fsSL \
      --max-time 15 \
      "$BRAVE_VERSION_URL"
  ) &&
     [[ $latest =~ ^[0-9.]+$ ]]; then

    url="https://github.com/brave/brave-browser/releases/download/v$latest/brave-browser-$latest-linux-amd64.zip"

    sha=$(
      curl \
        -fsSL \
        --max-time 15 \
        "$url.sha256" |
      cut \
        -d' ' \
        -f1
    ) ||
      latest=""

  else

    latest=""

  fi


  ensure_app \
    brave \
    "$latest" \
    "$url" \
    "$sha" \
    ""
}


# --------------------------------------------------------------------
# Profile migration
# --------------------------------------------------------------------

has_real_data() {
  [ -e "$1/Default/Preferences" ] ||
  [ -e "$1/User/globalStorage/state.vscdb" ]
}


mark_old_import_as_current() {
  local dir=$1

  [ -f "$dir/$MARKER" ] ||
  [ ! -f "$dir/$OLD_MARKER" ] ||
  cp \
    "$dir/$OLD_MARKER" \
    "$dir/$MARKER" \
    2>/dev/null ||
  true
}


import_data() {
  local name=$1
  local old=$2
  local new=$3

  local bak
  local root

  [ -n "$old" ] ||
    return 0


  mark_old_import_as_current "$new"


  if [[ " $REIMPORT " != *" $name "* ]]; then

    [ -f "$new/$MARKER" ] &&
      return 0


    if has_real_data "$new"; then

      mkdir -p "$new"

      printf \
        'kept=existing\ndate=%s\n' \
        "$(date -Is)" \
        > "$new/$MARKER"

      info \
        "Keeping existing $(label "$name") profile"

      return 0
    fi

  fi


  if old_app_running "$old" &&
     ! offer_close_old "$name" "$old"; then

    warn \
      "$(label "$name") profile not imported; old app is running ($(quit_hint "$name"))."

    return 1
  fi


  if pgrep \
    -f "$APPS/$name/" \
    >/dev/null 2>&1
  then

    warn \
      "Close native $(label "$name") before re-importing"

    return 1
  fi


  if [ -e "$new" ]; then

    bak="$GOINFRE/backups/$(basename "$new")-$(date +%Y%m%d-%H%M%S)"

    mkdir -p "$GOINFRE/backups"

    mv \
      "$new" \
      "$bak"

    info \
      "Backed up $(label "$name") profile"

  fi


  info \
    "Importing $(label "$name") profile"


  mkdir -p "$(dirname "$new")"


  if ! {

    rsync \
      -a \
      "${CACHE_EXCLUDES[@]}" \
      "$old/" \
      "$new.partial/" &&

    printf \
      'from=%s\ndate=%s\n' \
      "$old" \
      "$(date -Is)" \
      > "$new.partial/$MARKER" &&

    mv \
      "$new.partial" \
      "$new"

  }; then

    rm -rf "$new.partial"

    warn \
      "$(label "$name") profile import failed"

    return 1

  fi


  root=$(app_root "$old")

  [ -z "$root" ] ||
    carry_tool_configs "$root"


  ok \
    "$(label "$name") profile ready"
}


carry_tool_configs() {
  local root=$1

  local kind
  local dest
  local item
  local name


  for kind in config data; do

    if [ "$kind" = config ]; then
      dest=$CONF_DIR
    else
      dest=$DATA_DIR
    fi


    for item in "$root/$kind"/*; do

      [ -e "$item" ] ||
        continue


      name=$(basename "$item")


      case "$name" in

        BraveSoftware|Code|vscode|nvm|dconf|glib-2.0|gtk-*|ibus|pulse|fontconfig|user-dirs.*|recently-used.xbel|flatpak*|mimeapps.list|QtProject.conf|kdeglobals)
          continue
          ;;

      esac


      [ -e "$dest/$name" ] &&
        continue


      mkdir -p "$dest"


      cp \
        -a \
        "$item" \
        "$dest/"


      info \
        "Copied $kind/$name from old sandbox"

    done

  done
}


vscode_ready() {
  mark_old_import_as_current "$NEW_VSCODE"

  [ -x "$APPS/vscode/bin/code" ] &&
  {
    [ -z "$OLD_VSCODE" ] ||
    [ -f "$NEW_VSCODE/$MARKER" ]
  }
}


brave_ready() {
  mark_old_import_as_current "$NEW_BRAVE"

  [ -x "$APPS/brave/brave" ] &&
  {
    [ -z "$OLD_BRAVE" ] ||
    [ -f "$NEW_BRAVE/$MARKER" ]
  }
}


link_vsix_cache() {
  mkdir -p \
    "$GOINFRE/cache/vscode-vsix" \
    "$NEW_VSCODE"


  [ -L "$NEW_VSCODE/CachedExtensionVSIXs" ] ||
    rm -rf "$NEW_VSCODE/CachedExtensionVSIXs"


  ln \
    -sfn \
    "$GOINFRE/cache/vscode-vsix" \
    "$NEW_VSCODE/CachedExtensionVSIXs"
}


# --------------------------------------------------------------------
# CLI installation / wrappers / shell
# --------------------------------------------------------------------

install_self() {
  local target="$BIN_DIR/desk"

  mkdir -p "$BIN_DIR"


  if [ "$SELF" != "$(readlink -f "$target" 2>/dev/null || true)" ]; then

    if ! cmp \
      -s \
      "$SELF" \
      "$target" \
      2>/dev/null
    then

      install \
        -m 755 \
        "$SELF" \
        "$target"

      ok \
        "Installed $(pretty "$target")"

    fi

    SELF=$target

  fi


  if [ -f "$BIN_DIR/session-setup" ] &&
     grep \
       -qs 'session-setup' \
       "$BIN_DIR/session-setup"
  then

    rm -f "$BIN_DIR/session-setup"

  fi
}


write_wrapper() {
  local f="$BIN_DIR/$1"
  local app=$2


  if [ -e "$f" ] &&
     ! grep \
       -Eqs '(desk|session-setup)' \
       "$f"
  then

    warn \
      "$(pretty "$f") exists and is not managed by desk; leaving it"

    return 0
  fi


  printf \
    '#!/bin/sh\nexec "%s" %s "$@"\n' \
    "$BIN_DIR/desk" \
    "$app" \
    > "$f"


  chmod +x "$f"
}


remove_block() {
  local file=$1
  local start=$2
  local end=$3

  local tmp


  [ -f "$file" ] ||
    return 0


  tmp=$(mktemp)


  awk \
    -v s="$start" \
    -v e="$end" \
    '
      $0 == s {
        skip=1
        next
      }

      $0 == e {
        skip=0
        next
      }

      !skip {
        print
      }
    ' \
    "$file" \
    > "$tmp"


  mv \
    "$tmp" \
    "$file"
}


write_shell_hook() {
  local rc
  local shell_name


  shell_name=$(basename "${SHELL:-zsh}")


  case "$shell_name" in

    zsh)
      rc="$HOME/.zshrc"
      ;;

    bash)
      rc="$HOME/.bashrc"
      ;;

    *)
      return 0
      ;;

  esac


  touch "$rc"


  remove_block \
    "$rc" \
    '# >>> desk >>>' \
    '# <<< desk <<<'


  sed \
    -i \
    '/^# Added by session-setup: personal commands (code, brave, session-setup)$/,+1d' \
    "$rc" \
    2>/dev/null ||
    true


  if [ "$shell_name" = zsh ]; then

    cat >> "$rc" <<'ZSHHOOK'

# >>> desk >>>
export PATH="$HOME/.local/bin:$PATH"

unalias code brave 2>/dev/null || true
unfunction code brave 2>/dev/null || true

{ command desk _shell >/dev/null 2>&1 &! } 2>/dev/null
# <<< desk <<<
ZSHHOOK

  else

    cat >> "$rc" <<'BASHHOOK'

# >>> desk >>>
export PATH="$HOME/.local/bin:$PATH"

unalias code brave 2>/dev/null || true
unset -f code brave 2>/dev/null || true

nohup desk _shell >/dev/null 2>&1 &
# <<< desk <<<
BASHHOOK

  fi
}


write_launchers() {
  local icon_vscode
  local icon_brave

  local exec_path="$BIN_DIR/desk"


  write_wrapper \
    code \
    code


  write_wrapper \
    brave \
    brave


  icon_vscode=$(app_root "$OLD_VSCODE")

  icon_brave=$(app_root "$OLD_BRAVE")


  if [[ $icon_vscode == "$HOME/.var/app/"* ]]; then

    icon_vscode=$(basename "$icon_vscode")

  else

    icon_vscode="$APPS/vscode/resources/app/resources/linux/code.png"

  fi


  if [[ $icon_brave == "$HOME/.var/app/"* ]]; then

    icon_brave=$(basename "$icon_brave")

  else

    icon_brave="$APPS/brave/product_logo_256.png"

  fi


  mkdir -p "$DATA_DIR/applications"


  cat > "$DATA_DIR/applications/code-native.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=VS Code (native)
Comment=VS Code from goinfre
Exec=$exec_path code %F
Icon=$icon_vscode
Categories=Development;IDE;
StartupWMClass=code
EOF


  cat > "$DATA_DIR/applications/brave-native.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Brave (native)
Comment=Brave from goinfre
Exec=$exec_path brave %U
Icon=$icon_brave
Categories=Network;WebBrowser;
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
StartupWMClass=$BRAVE_WM_CLASS
EOF


  write_shell_hook
}


claim_default_browser() {
  local old_id
  local current


  old_id=$(app_root "$OLD_BRAVE")


  [[ $old_id == "$HOME/.var/app/"* ]] ||
    return 0


  old_id="$(basename "$old_id").desktop"


  current=$(
    xdg-settings \
      get default-web-browser \
      2>/dev/null ||
      true
  )


  [ "$current" = "$old_id" ] ||
    return 0


  xdg-settings \
    set \
    default-web-browser \
    brave-native.desktop \
    2>/dev/null &&

  info \
    "Brave (native) is now default" ||

  true
}


repair_cli() {
  install_self
  write_launchers

  ok "CLI and shell hook ready"
}


# --------------------------------------------------------------------
# Main workstation actions
# --------------------------------------------------------------------

prepare() {
  local failed=0


  [ "$GOINFRE" != "$HOME/.local/opt" ] ||
    warn \
      "No goinfre found; using $(pretty "$GOINFRE")"


  install_self


  install_vscode ||
    failed=1


  install_brave ||
    failed=1


  import_data \
    vscode \
    "$OLD_VSCODE" \
    "$NEW_VSCODE" ||
    failed=1


  import_data \
    brave \
    "$OLD_BRAVE" \
    "$NEW_BRAVE" ||
    failed=1


  vscode_ready &&
    link_vsix_cache


  write_launchers


  brave_ready &&
    claim_default_browser


  return "$failed"
}


free_ram() {
  pkill \
    -f 'gnome-software --gapplication-service' \
    2>/dev/null &&

  info \
    "Stopped GNOME Software background service" ||

  true
}


launch_apps() {
  local old


  if vscode_ready &&
     ! pgrep \
       -f "$APPS/vscode/" \
       >/dev/null 2>&1
  then

    info "Opening VS Code"

    setsid \
      -f \
      "$BIN_DIR/desk" \
      code \
      >/dev/null 2>&1

  fi


  if brave_ready &&
     ! pgrep \
       -f "$APPS/brave/" \
       >/dev/null 2>&1
  then

    info "Opening Brave"

    setsid \
      -f \
      "$BIN_DIR/desk" \
      brave \
      >/dev/null 2>&1

  fi


  for old in \
    "$OLD_VSCODE" \
    "$OLD_BRAVE"
  do

    [ -z "$old" ] ||
    ! old_app_running "$old" ||
    warn \
      "Old $(basename "$(app_root "$old")") is still running. Use 'desk x'."

  done
}


open_app() {
  local name=$1

  shift


  if ! "${name}_ready"; then

    notify \
      "Preparing $(label "$name")..."


    exec 9>"$STATE_DIR/lock"


    flock \
      -w 600 \
      9 ||
    {
      fail "desk is busy"
      exit 1
    }


    if ! "${name}_ready"; then

      QUIET=1

      prepare \
        >"$LOG_FILE" \
        2>&1 ||
        true

      QUIET=0

    fi


    "${name}_ready" ||
    {
      fail \
        "$(label "$name") is not ready. Run 'desk p'."

      exit 1
    }


    exec 9>&-

  fi


  case "$name" in

    vscode)

      local node_bin

      node_bin=$(find_node_bin)


      export PATH="$BIN_DIR${node_bin:+:$node_bin}:$PATH"


      exec \
        "$APPS/vscode/bin/code" \
        --extensions-dir "$VSCODE_EXTENSIONS" \
        "$@"
      ;;


    brave)

      exec \
        "$APPS/brave/brave" \
        --class="$BRAVE_WM_CLASS" \
        --disk-cache-size="$BRAVE_CACHE_BYTES" \
        "$@"
      ;;

  esac
}


stamp_fresh() {
  [ -f "$STAMP" ] ||
    return 1


  local now
  local then


  now=$(date +%s)

  then=$(
    stat \
      -c %Y \
      "$STAMP" \
      2>/dev/null ||
      echo 0
  )


  [ $((now - then)) -lt "$AUTO_CHECK_SECONDS" ]
}


shell_boot() {
  QUIET=1


  exec 9>"$STATE_DIR/lock"


  flock \
    -n \
    9 ||
    exit 0


  if vscode_ready &&
     brave_ready &&
     [ -x "$BIN_DIR/code" ] &&
     [ -x "$BIN_DIR/brave" ] &&
     stamp_fresh
  then

    exit 0
  fi


  touch "$STAMP"


  if ! prepare \
    >"$LOG_FILE" \
    2>&1
  then

    notify \
      "desk needs attention — run: desk p"

    exit 0
  fi


  notify \
    "desk is ready"
}


show_status() {
  local code_cmd
  local brave_cmd


  code_cmd=$(
    command -v code \
      2>/dev/null ||
      true
  )


  brave_cmd=$(
    command -v brave \
      2>/dev/null ||
      true
  )


  printf \
    '%bdesk%b %s\n\n' \
    "$C_BOLD" \
    "$C_RESET" \
    "$VERSION"


  printf \
    '  goinfre  %s\n' \
    "$(pretty "$GOINFRE")"


  if vscode_ready; then

    printf \
      '  %b✓%b code   ready\n' \
      "$C_GREEN" \
      "$C_RESET"

  else

    printf \
      '  %b✗%b code   not ready\n' \
      "$C_RED" \
      "$C_RESET"

  fi


  if brave_ready; then

    printf \
      '  %b✓%b brave  ready\n' \
      "$C_GREEN" \
      "$C_RESET"

  else

    printf \
      '  %b✗%b brave  not ready\n' \
      "$C_RED" \
      "$C_RESET"

  fi


  printf \
    '\n  code   %s\n  brave  %s\n  log    %s\n' \
    "${code_cmd:-not in PATH}" \
    "${brave_cmd:-not in PATH}" \
    "$(pretty "$LOG_FILE")"
}


close_old_apps() {
  [ -z "$OLD_VSCODE" ] ||
  close_old_app \
    vscode \
    "$OLD_VSCODE" ||
  FAILED=1


  [ -z "$OLD_BRAVE" ] ||
  close_old_app \
    brave \
    "$OLD_BRAVE" ||
  FAILED=1


  [ "$FAILED" = 0 ] &&
    ok "Old apps closed"


  return "$FAILED"
}


run_locked() {
  exec 9>"$STATE_DIR/lock"


  flock \
    -w 600 \
    9 ||
  {
    fail "desk is busy"
    exit 1
  }


  "$@"
}


# --------------------------------------------------------------------
# Main
# --------------------------------------------------------------------

main() {
  local cmd=${1:-run}


  [ $# -gt 0 ] &&
    shift ||
    true


  if [ "$cmd" = "--from-flatpak" ]; then

    FROM_FLATPAK=${1:-}

    shift ||
      true


    cmd=${1:-run}


    [ $# -gt 0 ] &&
      shift ||
      true

  fi


  case "$cmd" in

    -h|--help|help|h)

      usage
      exit 0
      ;;


    -v|--version|version|v)

      echo "desk $VERSION"
      exit 0
      ;;

  esac


  setup_runtime


  case "$cmd" in

    run)

      if run_locked prepare; then

        free_ram
        launch_apps

        ok "Ready"

      else

        warn \
          "Finished with warnings"

        exit 1

      fi
      ;;


    c|code|vscode)

      open_app \
        vscode \
        "$@"
      ;;


    b|brave)

      open_app \
        brave \
        "$@"
      ;;


    p|prep|prepare|update|up)

      if run_locked prepare; then

        ok "Ready"

      else

        warn \
          "Finished with warnings"

        exit 1

      fi
      ;;


    s|sync|reimport)

      case "${1:-all}" in

        c|code|vscode)
          REIMPORT="vscode"
          ;;

        b|brave)
          REIMPORT="brave"
          ;;

        all|"")
          REIMPORT="vscode brave"
          ;;

        *)
          fail "Use: desk s [c|b]"
          exit 2
          ;;

      esac


      CLOSE_OLD=1


      if run_locked prepare; then

        ok \
          "Profile synced"

      else

        warn \
          "Sync finished with warnings"

        exit 1

      fi
      ;;


    x|close)

      CLOSE_OLD=1

      run_locked \
        close_old_apps
      ;;


    st|status)

      show_status
      ;;


    fix)

      run_locked \
        repair_cli
      ;;


    _shell)

      shell_boot
      ;;


    *)

      fail \
        "Unknown command: $cmd"

      printf \
        "Run 'desk help'.\n" \
        >&2

      exit 2
      ;;

  esac
}


if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi