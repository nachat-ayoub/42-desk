import glob
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
from urllib.parse import urljoin, urlparse

base, arch, update = Path(sys.argv[1]).resolve(), sys.argv[2], sys.argv[3] == '1'
sdk = base / 'sdk'
# Match Flutter's SDK archive page (flutter_release_model.dart in flutter/website).
repo = 'https://storage.googleapis.com/flutter_infra_release/releases/'
manifest_url = repo + 'releases_linux.json'
marker = base / '.desk-release.json'


def ready(root):
    return (root / '.git').is_dir() and all(os.access(root / file, os.X_OK) for file in (
        'bin/flutter', 'bin/dart', 'bin/cache/dart-sdk/bin/dart'))


class DownloadError(RuntimeError):
    pass


def fetch(url, destination):
    part = destination.with_name(destination.name + '.part')
    try:
        result = subprocess.run(['curl', '-fL', '--retry', '2', '--connect-timeout', '15',
                                 '--speed-limit', '1024', '--speed-time', '60',
                                 '--write-out', '%{http_code}', url, '-o', str(part)],
                                stdout=subprocess.PIPE, text=True)
        if result.returncode:
            status = result.stdout.strip()
            detail = 'curl exit ' + str(result.returncode)
            if re.fullmatch(r'[1-5][0-9]{2}', status):
                detail += '; HTTP ' + status
            raise DownloadError('download failed (' + detail + '): ' + url)
        part.replace(destination)
    finally:
        part.unlink(missing_ok=True)


def git(root, *args):
    return subprocess.check_output(['git', '-C', str(root), *args], text=True, stderr=subprocess.PIPE).strip()


def busy():
    prefix = os.fsencode(str(sdk) + '/bin/')
    for entry in glob.iglob('/proc/[0-9]*'):
        try:
            if os.readlink(entry + '/exe').startswith(str(sdk) + '/'):
                return True
            with open(entry + '/cmdline', 'rb') as stream:
                if any(arg.startswith(prefix) for arg in stream.read().split(b'\0')):
                    return True
        except OSError:
            pass
    return False


def main():
    head = None
    manifest = base / 'downloads/releases_linux.json'
    try:
        fetch(manifest_url, manifest)
    except DownloadError as error:
        if ready(sdk):
            print('Flutter release server unavailable; keeping the installed SDK. ' + str(error), file=sys.stderr)
            return
        raise RuntimeError('release manifest ' + str(error)) from error
    data = json.loads(manifest.read_text())
    if data.get('base_url', '').rstrip('/') != repo.rstrip('/'):
        raise RuntimeError('unexpected Flutter archive base URL')
    releases = [r for r in data['releases'] if r.get('channel') == 'stable'
                and r.get('hash') == data['current_release']['stable']
                and r.get('dart_sdk_arch', 'x64') == arch]
    if not releases:
        raise RuntimeError('the current stable Flutter release has no Linux ' + arch + ' archive')
    release = releases[0]
    version, revision, archive_name, checksum = (release[k] for k in ('version', 'hash', 'archive', 'sha256'))
    if not re.fullmatch(r'[0-9]+\.[0-9]+\.[0-9]+', version) or not re.fullmatch(r'[a-fA-F0-9]{40}', revision):
        raise RuntimeError('invalid stable release metadata')
    if not re.fullmatch(r'[a-fA-F0-9]{64}', checksum):
        raise RuntimeError('missing Flutter SHA-256 checksum')
    url = urljoin(repo, archive_name)
    if not url.startswith(repo) or urlparse(url).scheme != 'https' or not url.endswith('.tar.xz'):
        raise RuntimeError('unexpected Flutter archive URL')
    if sdk.exists():
        if not ready(sdk):
            raise RuntimeError('unrecognized or incomplete SDK at ' + str(sdk) + '; inspect it before retrying')
        head = git(sdk, 'rev-parse', 'HEAD')
        if head == revision:
            (base / '.installed-version').write_text(version + '\n')
            marker.write_text(json.dumps({'version': version, 'hash': revision}))
            print('Flutter ' + version + ' is already current.', flush=True)
            return
        previous = json.loads(marker.read_text()) if marker.exists() else {}
        if update and re.fullmatch(r'[0-9]+\.[0-9]+\.[0-9]+', previous.get('version', '')):
            parts = lambda v: tuple(map(int, v.split('.')))
            if parts(previous['version']) > parts(version):
                print('Keeping newer installed Flutter ' + previous['version'], flush=True)
                return
        if git(sdk, 'status', '--porcelain') or head != previous.get('hash'):
            raise RuntimeError('Flutter SDK has local changes or an unrecognized revision; preserve them before updating')
    if not hasattr(tarfile, 'data_filter'):
        raise RuntimeError('safe SDK extraction requires Python with tarfile.data_filter (Python 3.12 or a security-updated older release)')
    if shutil.disk_usage(base).free < 8 * 1024**3:
        raise RuntimeError('keep at least 8 GB free in goinfre for Flutter download and extraction')
    archive = base / 'downloads' / Path(archive_name).name

    def verified():
        if not archive.is_file():
            return False
        digest = hashlib.sha256()
        with archive.open('rb') as stream:
            for chunk in iter(lambda: stream.read(1024 * 1024), b''):
                digest.update(chunk)
        return digest.hexdigest().lower() == checksum.lower()

    if not verified():
        print('Downloading Flutter ' + version, flush=True)
        fetch(url, archive)
    if not verified():
        archive.unlink(missing_ok=True)
        raise RuntimeError('Flutter archive checksum mismatch; existing SDK kept')
    with tempfile.TemporaryDirectory(prefix='install-', dir=base / 'tmp') as temporary:
        stage = Path(temporary)
        print('Extracting Flutter ' + version, flush=True)
        with tarfile.open(archive, 'r:xz') as source:
            source.extractall(stage, filter='data')
        content = stage / 'flutter'
        if not ready(content) or git(content, 'rev-parse', 'HEAD') != revision:
            raise RuntimeError('unexpected Flutter SDK archive layout or revision')
        environment = dict(os.environ, FLUTTER_ROOT=str(content))
        print('Validating Flutter SDK (first startup may fetch tool dependencies)', flush=True)
        check = subprocess.run([str(content / 'bin/flutter'), '--version', '--machine'],
                               env=environment, text=True, capture_output=True, timeout=180)
        if check.returncode or json.loads(check.stdout).get('frameworkVersion') != version:
            raise RuntimeError('Flutter SDK validation failed: ' + check.stderr[-2000:])
        if busy():
            print('Flutter started during download; update postponed. Retry desk update flutter.', file=sys.stderr)
            return
        # Recheck local work immediately before replacing an existing SDK.
        if sdk.exists() and (git(sdk, 'status', '--porcelain') or git(sdk, 'rev-parse', 'HEAD') != head):
            raise RuntimeError('Flutter SDK changed during download; existing SDK kept')
        backup_root = Path(tempfile.mkdtemp(prefix='previous-', dir=base / 'tmp'))
        backup = backup_root / 'sdk'
        if sdk.exists():
            sdk.rename(backup)
        try:
            content.rename(sdk)
        except OSError:
            if backup.exists():
                try:
                    backup.rename(sdk)
                except OSError as error:
                    raise RuntimeError('SDK replacement failed; previous SDK preserved at ' + str(backup)) from error
            backup_root.rmdir()
            raise
        marker.write_text(json.dumps({'version': version, 'hash': revision}))
        (base / '.installed-version').write_text(version + '\n')
        shutil.rmtree(backup_root)
    archive.unlink(missing_ok=True)
    print('Flutter ' + version + ' installed. Run flutter doctor for platform prerequisites.', flush=True)


try:
    main()
except (OSError, ValueError, KeyError, RuntimeError, tarfile.TarError, subprocess.SubprocessError) as error:
    sys.exit('Flutter setup failed: ' + str(error))
FLUTTER_INSTALLER
)


