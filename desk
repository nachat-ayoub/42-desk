# -------------------------------------------------------------------
# Program selection (plain data, never sourced as shell code)
# -------------------------------------------------------------------

selected() {
  local program
  for program in "${PROGRAMS[@]}"; do
    [ "$program" != "$1" ] || return 0
  done
  return 1
}


normalize_programs() {
  local token word program choice found none=0
  local -a words=() requested=()
  for token in "$@"; do
    read -r -a words <<< "${token//,/ }"
    for word in "${words[@]}"; do
      case "$word" in
        c|vscode) word=code ;;
        b) word=brave ;;
        ai) word=codex ;;
        cc|claude-code) word=claude ;;
        emulator) word=android ;;
        hermes-agent) word=hermes ;;
        all) requested+=("${ALL_PROGRAMS[@]}"); continue ;;
        none) none=1 ;;
      esac
      [ "$word" != none ] || continue
      found=0
      for program in "${ALL_PROGRAMS[@]}"; do [ "$word" != "$program" ] || found=1; done
      if [ "$found" = 0 ]; then fail "Unknown program: $word. Choose ${ALL_PROGRAMS[*]}, all, or none."; return 2; fi
      requested+=("$word")
    done
  done
  if [ "$none" = 1 ] && [ "${#requested[@]}" != 0 ]; then
    fail "Use 'none' on its own."
    return 2
  fi
  if [ "$none" = 0 ] && [ "${#requested[@]}" = 0 ]; then
    fail "Choose at least one program, or 'none'."
    return 2
  fi
  PROGRAMS=()
  for program in "${ALL_PROGRAMS[@]}"; do
    for choice in "${requested[@]}"; do
      if [ "$choice" = "$program" ]; then PROGRAMS+=("$program"); break; fi
    done
  done
  return 0
}


load_programs() {
  load_programs_from "$PROGRAMS_FILE"
}


load_programs_from() {
  local file=$1
  local -a saved=()
  [ -f "$file" ] || return 0
  mapfile -t saved < "$file"
  normalize_programs "${saved[@]}"
}


save_programs_to() {
  local file=$1
  local tmp
  tmp=$(mktemp "$file.XXXXXX") || return 1
  if ! {
    if [ "${#PROGRAMS[@]}" = 0 ]; then
      printf 'none\n'
    else
      printf '%s\n' "${PROGRAMS[@]}"
    fi > "$tmp" && mv "$tmp" "$file"
  }; then
    rm -f "$tmp"
    return 1
  fi
  return 0
}


save_programs() {
  save_programs_to "$PROGRAMS_FILE" || return 1
  rm -f "$STAMP"
}


selection_summary() {
  local program
  if [ "${#PROGRAMS[@]}" = 0 ]; then
    printf 'none'
    return
  fi
  local separator=""
  for program in "${PROGRAMS[@]}"; do
    printf '%s%s' "$separator" "$(label "$program")"
    separator=', '
  done
}


# The picker owns /dev/tty, leaving stdout for the confirmed selection.
# Python restores terminal attributes and cursor visibility on every exit.
checkbox_programs() {
  python3 - "${PICKER_TITLE:-Choose your programs}" "${PICKER_ACTION:-install}" \
    "${PICKER_PROGRAMS[@]}" -- "${PROGRAMS[@]}" <<'PICKER'
import os
import select
import signal
import sys
import termios
import tty

title, action = sys.argv[1:3]
separator = sys.argv.index("--", 3)
labels = {"code": "VS Code", "brave": "Brave", "codex": "Codex CLI", "claude": "Claude Code", "android": "Android 11 Google Play", "flutter": "Flutter SDK", "hermes": "Hermes Agent (CLI)", "hermes-desktop": "Hermes Desktop (official)",
          "codex-desktop": "Codex Desktop (community Linux port)", "claude-desktop": "Claude Desktop (community Linux port)", "openmausbot": "OpenMausBot",
          "android-toolchain": "Android app builds", "web-toolchain": "Web (Brave / Chrome)", "linux-toolchain": "Linux desktop"}
programs = [(name, labels[name]) for name in sys.argv[3:separator]]
chosen = set(sys.argv[separator + 1:]).intersection(name for name, _ in programs)
current = 0
fd = None
previous = None
result = 130


def write(text):
    os.write(fd, text.encode())


def interrupt(signum, frame):
    raise KeyboardInterrupt


def render():
    try:
        size = os.get_terminal_size(fd)
        width, height = max(size.columns or 80, 20), size.lines or 24
    except OSError:
        width, height = 80, 24
    lines = [title, ""]
    visible = list(enumerate(programs))
    if 0 < height < 10:
        visible = [(current, programs[current])]
    for index, (name, program_title) in visible:
        pointer = ">" if index == current else " "
        mark = "x" if name in chosen else " "
        lines.append(f" {pointer} [{mark}] {program_title}")
    lines += ["", "Up/Down or j/k: move   Space: toggle",
              f"Enter: {action}   a: all   n: none   Esc/q: cancel"]
    write("\x1b[H\x1b[2J" + "\r\n".join(line[:width - 1] for line in lines))


try:
    fd = os.open("/dev/tty", os.O_RDWR)
    previous = termios.tcgetattr(fd)
    signal.signal(signal.SIGTERM, interrupt)
    signal.signal(signal.SIGINT, interrupt)
    tty.setcbreak(fd)
    write("\x1b[?1049h\x1b[?25l")
    while True:
        render()
        key = os.read(fd, 1)
        if key == b"\x1b":
            sequence = b""
            while len(sequence) < 16 and select.select([fd], [], [], 0.15)[0]:
                sequence += os.read(fd, 1)
                if len(sequence) >= 2 and 64 <= sequence[-1] <= 126:
                    break
            if not sequence:
                break
            key = {b"[A": b"k", b"OA": b"k", b"[B": b"j", b"OB": b"j"}.get(sequence, b"?")
        if key in (b"q", b"Q", b"\x04", b""):
            break
        if key in (b"j", b"J"):
            current = (current + 1) % len(programs)
        elif key in (b"k", b"K"):
            current = (current - 1) % len(programs)
        elif key == b" ":
            name = programs[current][0]
            chosen.symmetric_difference_update({name})
        elif key in (b"a", b"A"):
            chosen = {name for name, _ in programs}
        elif key in (b"n", b"N"):
            chosen.clear()
        elif key in (b"\r", b"\n"):
            result = 0
            break
except KeyboardInterrupt:
    pass
except (OSError, termios.error) as error:
    print(f"Cannot open interactive checklist: {error}. Use desk {action} PROGRAMS.", file=sys.stderr)
    result = 2
finally:
    if previous is not None:
        try:
            termios.tcsetattr(fd, termios.TCSADRAIN, previous)
        finally:
            write("\x1b[?25h\x1b[?1049l")
    if fd is not None:
        os.close(fd)

if result == 0:
    print(" ".join(name for name, _ in programs if name in chosen) or "none")
sys.exit(result)
PICKER
}


choose_program_list() {
  local answer rc
  if [ "$#" = 0 ]; then
    if [ ! -t 0 ]; then
      fail "Specify programs, e.g. desk ${PICKER_COMMAND:-install} codex claude (or 'all' / 'none')."
      return 2
    fi
    if ! command -v python3 >/dev/null 2>&1; then
      fail "The checklist requires python3. Use desk ${PICKER_COMMAND:-install} PROGRAMS instead."
      return 2
    fi
    if answer=$(checkbox_programs); then
      normalize_programs "$answer" || return $?
    else
      rc=$?
      if [ "$rc" = 130 ]; then info 'Selection cancelled; nothing changed.'; fi
      return "$rc"
    fi
  else
    normalize_programs "$@" || return $?
  fi
}


choose_programs() {
  choose_program_list "$@" || return $?
  with_lock_wait core save_programs || return 1
  info "Selected: $(selection_summary)"
}


ensure_selection() {
  [ ! -f "$PROGRAMS_FILE" ] || return 0
  if [ ! -f "$INITIALIZED" ] && [ -t 0 ]; then
    choose_programs
  else
    # Noninteractive and upgraded installations preserve the old defaults.
    with_lock_wait core save_programs
  fi
}


