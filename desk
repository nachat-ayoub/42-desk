run_android() (
  android_ready || { fail "Run 'desk install android' first."; return 1; }
  android_environment || return 1
  local adb="$ANDROID_HOME/platform-tools/adb"
  (
    for ((attempt=0; attempt<120; attempt++)); do
      booted=$("$adb" -P 5038 -s emulator-5584 shell getprop sys.boot_completed 2>/dev/null | tr -d '\r') || true
      if [ "$booted" = 1 ]; then
        for setting in window_animation_scale transition_animation_scale animator_duration_scale; do
