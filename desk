# -------------------------------------------------------------------
# Main
# -------------------------------------------------------------------

main() {
  local cmd=${1:-run}

  [ $# -gt 0 ] &&
    shift ||
    true

  if [ "$cmd" = "--from-flatpak" ]; then

    FROM_FLATPAK=${1:-}

    shift ||
      true

    cmd=${1:-run}

    [ $# -gt 0 ] &&
      shift ||
      true
  fi

  case "$cmd" in
    -h|--help|help|h)
      usage
      exit 0
      ;;

    -v|--version|version|v)
      echo "desk $VERSION"
      exit 0
      ;;
  esac

  setup_runtime || return $?

  case "$cmd" in
    env)
      if [ "$#" != 1 ] || [ "$1" != flutter ]; then fail 'Use: desk env flutter'; return 2; fi
      print_flutter_environment
      ;;

    run|open)
      open_programs "$@"
      ;;

    self-update)
      with_lock_wait core update_desk_unlocked "$@"
      ;;

    yt|youtube)
      download_youtube "$@"
      ;;

    update|up)
      if [ "${1:-}" = self ]; then
        shift
        with_lock_wait core update_desk_unlocked "$@"
      else
        update_installed_programs "$@"
      fi
      ;;

    _open)
      local PREPARE_ON_LAUNCH=0
      [ "$#" -gt 0 ] || return 2
      if [ "$#" = 1 ] && [ "$1" = flutter ]; then open_app flutter doctor; else open_app "$@"; fi
      ;;


    install|choose)
      choose_programs "$@" || return $?
      if prepare_all; then
        touch "$INITIALIZED" "$STAMP"
        ok "Selected programs ready"
        show_next_steps
      else
        fail "Some programs need attention. Run 'desk p' to retry your selection."
        return 1
      fi
      ;;

    ai|codex)
      open_app codex "$@"
      ;;

    claude|cc|claude-code)
      open_app claude "$@"
      ;;

    hermes|hermes-agent)
      open_app hermes "$@"
      ;;

    hermes-desktop)
      open_app hermes-desktop "$@"
      ;;

    codex-desktop|claude-desktop|openmausbot)
      open_app "$cmd" "$@"
      ;;

    android|emulator)
      open_app android "$@"
      ;;

    flutter|dart)
      with_lock_wait core install_self || return 1
      open_app "$cmd" "$@"
      ;;

    flutter-setup)
      with_lock_wait core install_self || return 1
      with_lock_wait flutter flutter_setup "$@"
      ;;

    _android-run)
      run_android "$@"
      ;;

    c|code|vscode)

      open_app \
        code \
        "$@"
      ;;


    b|brave)

      open_app \
        brave \
        "$@"
      ;;


    p|prep|prepare)

      if prepare_all; then

        touch "$INITIALIZED"
        touch "$STAMP"

        ok "Ready"

      else

        warn "Finished with warnings"
        exit 1
      fi
      ;;


    s|sync|reimport)

      case "${1:-all}" in
        c|code|vscode)

          REIMPORT="vscode"
          CLOSE_OLD=1

          prepare_vscode
          ;;


        b|brave)

          REIMPORT="brave"
          CLOSE_OLD=1

          prepare_brave
          ;;


        all|"")

          REIMPORT="vscode brave"
          CLOSE_OLD=1

          prepare_vscode
          prepare_brave
          ;;


        *)

          fail "Use: desk s [c|b]"
          exit 2
          ;;
      esac

      ok "Profile synced"
      ;;


    x|close)

      CLOSE_OLD=1
      close_old_apps
      ;;


    st|status)

      show_status
      ;;


    clean|reset)

      clean_reset
      ;;


    fix)

      repair_cli
      ;;


    _shell)

      shell_boot
      ;;


    _auto)

      auto_check
      ;;


    *)

      fail "Unknown command: $cmd"

      printf \
        "Run 'desk help'.\n" \
        >&2

      exit 2
      ;;
  esac
}


if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
